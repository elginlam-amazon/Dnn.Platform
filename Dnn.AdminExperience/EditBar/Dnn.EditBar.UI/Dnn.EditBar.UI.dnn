<dotnetnuke type="Package" version="5.0">
    <packages>
        <package name="Dnn.EditBar.UI" type="Library" version="10.04.00">
            <friendlyName>Dnn.EditBar.UI</friendlyName>
            <description></description>
            <dependencies/>
            <owner>
                <name>.NET Foundation and Contributors</name>
                <organization>DNN Community</organization>
                <url>https://dnncommunity.org</url>
                <email>info@dnncommunity.org</email>
            </owner>
            <license src="license.txt" />
            <releaseNotes src="releaseNotes.txt" />
            <azureCompatible>true</azureCompatible>
            <components>
                <component type="Assembly">
                    <assemblies>
                        <assembly>
                            <path>bin</path>
                            <name>Dnn.EditBar.UI.dll</name>
                        </assembly>
                        <assembly>
                            <path>bin</path>
                            <name>Dnn.EditBar.Library.dll</name>
                        </assembly>
                    </assemblies>
                </component>
                <component type="Config">
                    <config>
                        <configFile>web.config</configFile>
                        <install>
                            <configuration>
                                <nodes>
                                    <!-- EditBarModule is no longer an IHttpModule: on ASP.NET Core it is an
                                         IHostedService registered from this package's own Startup.cs
                                         (IDnnStartup), so there is no system.webServer/modules 'add' node any
                                         more. The 'remove' node is deliberately KEPT here (and in uninstall
                                         below) so that upgrading a site installed on .NET Framework 4.8 cleans
                                         the stale modules entry, which would otherwise fail to load. -->
                                    <node path="/configuration/system.webServer/modules/add[@name='EditBarModule']" action="remove" />
                                </nodes>
                            </configuration>
                        </install>
                        <uninstall>
                            <configuration>
                                <nodes>
                                    <node path="/configuration/system.webServer/modules/add[@name='EditBarModule']" action="remove" />
                                </nodes>
                            </configuration>
                        </uninstall>
                    </config>
                </component>
                <component type="ResourceFile">
                    <resourceFiles>
                        <basePath>DesktopModules\admin\Dnn.EditBar</basePath>
                        <resourceFile>
                            <name>Resources.zip</name>
                        </resourceFile>
                    </resourceFiles>
                </component>
                <component type="Cleanup" version="01.05.00" fileName="01.05.00.txt" />
                <component type="File">
                    <files>
                        <basePath>DesktopModules\admin\Dnn.EditBar</basePath>
                        <file>
                            <name>01.05.00.txt</name>
                            <sourceFileName>01.05.00.txt</sourceFileName>
                        </file>
                    </files>
                </component>
            </components>
            <eventMessage>
                <processorType>DotNetNuke.Entities.Modules.EventMessageProcessor, DotNetNuke</processorType>
                <processorCommand>UpgradeModule</processorCommand>
                <attributes>
                    <businessControllerClass>Dnn.EditBar.UI.Components.BusinessController, Dnn.EditBar.UI</businessControllerClass>
                    <desktopModuleID>[DESKTOPMODULEID]</desktopModuleID>
                    <upgradeVersionsList>01.00.00</upgradeVersionsList>
                </attributes>
            </eventMessage>
        </package>
    </packages>
</dotnetnuke>
