<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputPath>bin</OutputPath>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    <TargetFramework>net10.0</TargetFramework>
    <Deterministic>true</Deterministic>
    <LangVersion>latest</LangVersion>
    <EnableNETAnalyzers>true</EnableNETAnalyzers>
    <AnalysisLevel>latest</AnalysisLevel>
    <AnalysisMode>Recommended</AnalysisMode>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <!--
      Retargeting net48 -> net10.0 raised the effective analyzer surface (AnalysisLevel=latest is
      repo-wide and pre-existing), activating code-quality/style rules that simply did not apply to
      the net48 target. These remain visible warnings; they are demoted from errors so the newly
      activated suggestions do not break the build, matching the convention already used by the
      migrated projects in this solution. Only non-behavioural quality/style rules are listed -
      no CS*, SYSLIB* or CA1416 (platform compatibility) diagnostic is demoted here.
    -->
    <WarningsNotAsErrors>CS0618,SA1600,CA1510,CA1845,CA1846,CA1847,CA1859,CA1862,CA1863,CA1865,CA1872,CA2249,CA2263,CA1822,SA1116,SA1505,SA1515</WarningsNotAsErrors>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <GenerateAssemblyInfo>false</GenerateAssemblyInfo>
  </PropertyGroup>


  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>

  <ItemGroup>
    <!--
      Cross-platform imaging. Replaces the System.Drawing / System.Drawing.Common surface
      used by Components/Themes/ThemesController.CreateThumbnail, matching the precedent set by
      DotNetNuke.Library, DotNetNuke.Web and Dnn.Modules.ResourceManager. Version comes from the
      central Directory.Packages.props.
    -->
    <PackageReference Include="SixLabors.ImageSharp" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\DNN Platform\DotNetNuke.ContentSecurityPolicy\DotNetNuke.ContentSecurityPolicy.csproj" />
    <ProjectReference Include="..\..\DotNetNuke.BulkInstall\DotNetNuke.BulkInstall.Encryption\DotNetNuke.BulkInstall.Encryption.csproj" />
    <ProjectReference Include="..\..\DotNetNuke.Internal.SourceGenerators\DotNetNuke.Internal.SourceGenerators.csproj" ReferenceOutputAssembly="false" OutputItemType="Analyzer" />
    <ProjectReference Include="..\..\DNN Platform\DotNetNuke.Abstractions\DotNetNuke.Abstractions.csproj" />
    <ProjectReference Include="..\..\DNN Platform\DotNetNuke.DependencyInjection\DotNetNuke.DependencyInjection.csproj" />
    <ProjectReference Include="..\..\DNN Platform\DotNetNuke.Instrumentation\DotNetNuke.Instrumentation.csproj" />
    <ProjectReference Include="..\..\DNN Platform\DotNetNuke.Maintenance\DotNetNuke.Maintenance.csproj" />
    <ProjectReference Include="..\..\DNN Platform\DotNetNuke.Web.Client\DotNetNuke.Web.Client.csproj" />
    <ProjectReference Include="..\..\DNN Platform\DotNetNuke.Web\DotNetNuke.Web.csproj" />
    <ProjectReference Include="..\..\DNN Platform\HttpModules\DotNetNuke.HttpModules.csproj" />
    <ProjectReference Include="..\..\DNN Platform\Library\DotNetNuke.Library.csproj" />
    <ProjectReference Include="..\Library\Dnn.PersonaBar.Library\Dnn.PersonaBar.Library.csproj" />
  </ItemGroup>

  <ItemGroup>
    <AdditionalFiles Include="..\..\stylecop.json" Link="stylecop.json" />
    <Compile Include="..\..\SolutionInfo.cs" Link="SolutionInfo.cs" />
  </ItemGroup>

  <ItemGroup>
    <None Remove="admin\personaBar\Dnn.Extensions\data\ModuleControlTemplate.resources" />
    <None Remove="Components\ConfigConsole\Schemas\DotNetConfig.xsd" />
    <None Remove="Components\Security\Resources\*.resources" />
    <EmbeddedResource Include="admin\personaBar\Dnn.Extensions\data\ModuleControlTemplate.resources" />
    <EmbeddedResource Include="Components\ConfigConsole\Schemas\DotNetConfig.xsd" />
    <EmbeddedResource Include="Components\Security\Resources\*.resources" />
  </ItemGroup>

  <Import Project="Module.build" />
</Project>