<Project Sdk="Microsoft.NET.Sdk.Razor">

	<PropertyGroup>
		<RootNamespace></RootNamespace>
		<RootDirectory>$(MSBuildProjectDirectory)\..\..\..</RootDirectory>
		<OutputPath>bin</OutputPath>
		<AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
		<TargetFramework>net10.0</TargetFramework>
		<Deterministic>true</Deterministic>
		<LangVersion>latest</LangVersion>
		<Nullable>disable</Nullable>
		<ImplicitUsings>disable</ImplicitUsings>
		<EnableNETAnalyzers>true</EnableNETAnalyzers>
		<AnalysisLevel>latest</AnalysisLevel>
		<AnalysisMode>Recommended</AnalysisMode>
		<TreatWarningsAsErrors>true</TreatWarningsAsErrors>
		<!-- SA1300/SA1602/SA1601: the legacy public surface (eClickAction, eCheckBoxMode,
		     DNNTabStrip.eTabRenderMode, DNNTab.eTabCallbackPostMode, DNNTextSuggest.eIDTokenChar)
		     must keep its original lower-case "e" prefixed names, which StyleCop flags. -->
		<WarningsNotAsErrors>CA1010,CA1708,CA1710,CA1711,CA1725,CA1822,SA1300</WarningsNotAsErrors>
		<GenerateDocumentationFile>true</GenerateDocumentationFile>
		<GenerateAssemblyInfo>false</GenerateAssemblyInfo>
	</PropertyGroup>

	<ItemGroup>
		<ProjectReference Include="..\..\..\DotNetNuke.Internal.SourceGenerators\DotNetNuke.Internal.SourceGenerators.csproj" ReferenceOutputAssembly="false" OutputItemType="Analyzer" />
		<!-- WebControls.cs uses DotNetNuke.Abstractions.ClientResources types (IClientResourceController,
		     IScriptResource) directly, so the reference is declared here rather than relied on transitively. -->
		<ProjectReference Include="..\..\DotNetNuke.Abstractions\DotNetNuke.Abstractions.csproj" />
		<ProjectReference Include="..\..\DotNetNuke.Web.Client\DotNetNuke.Web.Client.csproj" />
		<ProjectReference Include="..\..\DotNetNuke.WebUtility\DotNetNuke.WebUtility.csproj" />
	</ItemGroup>

	<ItemGroup>
		<!-- The Blazor components of this Razor Class Library (Components\*.razor) take their
		     Microsoft.AspNetCore.Components types from the shared framework. -->
		<FrameworkReference Include="Microsoft.AspNetCore.App" />
	</ItemGroup>

	<ItemGroup>
		<AdditionalFiles Include="..\..\..\stylecop.json" Link="stylecop.json" />
	</ItemGroup>

	<!-- The eleven client scripts and the state sprite used to be <EmbeddedResource> items served
	     by the WebForms WebResource.axd handler. The <Assembly: WebResource(...)> attributes that
	     exposed them are gone with System.Web.UI, and no consumer in the solution loads them by
	     manifest resource name, so they are now Razor Class Library static web assets under
	     wwwroot/ and are served from _content/DotNetNuke.WebControls/js/... and
	     _content/DotNetNuke.WebControls/images/dnntree.bmp. Microsoft.NET.Sdk.Razor picks the
	     wwwroot/ content up automatically, so no item group is needed for them. -->

</Project>
