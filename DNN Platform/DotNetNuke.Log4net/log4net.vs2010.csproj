<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <AssemblyName>log4net</AssemblyName>
    <RootNamespace>log4net</RootNamespace>
    <OutputType>Library</OutputType>
    <ImplicitUsings>disable</ImplicitUsings>
    <Nullable>disable</Nullable>
    <EnableDefaultItems>true</EnableDefaultItems>
    <DefaultItemExcludes>$(DefaultItemExcludes);bin/**;obj/**</DefaultItemExcludes>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <DebugType>portable</DebugType>
    <SignAssembly>false</SignAssembly>
    <DelaySign>false</DelaySign>
    <AllowUnsafeBlocks>false</AllowUnsafeBlocks>
    <CheckForOverflowUnderflow>false</CheckForOverflowUnderflow>
    <TreatWarningsAsErrors>false</TreatWarningsAsErrors>
    <WarningLevel>4</WarningLevel>
    <ErrorReport>prompt</ErrorReport>
    <!-- Pre-existing XML documentation and obsolescence warnings in the vendored log4net
         sources are suppressed rather than editing 225 upstream files. -->
    <NoWarn>$(NoWarn);CS1591;CS1573;CS1572;CS1574;CS1570;CS1587;SYSLIB0003;SYSLIB0051;NU1510</NoWarn>
  </PropertyGroup>

  <!-- Assembly metadata.
       OWNERSHIP: the shared log4net/ source tree owns the assembly-level attributes in
       log4net/AssemblyInfo.cs and log4net/AssemblyVersionInfo.cs (ported in place: the CAS
       attributes `AllowPartiallyTrustedCallers` / `SecurityRules` and the dead
       `#if STRONG && (CLI_1_0 || NET_1_0 || ...)` key-file branch are gone, everything else is
       preserved). Because the sibling DotNetNuke.Log4Net.csproj — the project
       DNN_Platform.sln references — compiles the very same files, this project must agree with
       it and keep `GenerateAssemblyInfo=false`; generating the attributes here as well produces
       CS0579 duplicate-attribute errors. The values below are kept only as a record of the
       metadata (and for `dotnet pack`); they are NOT emitted as attributes. -->
  <PropertyGroup>
    <GenerateAssemblyInfo>false</GenerateAssemblyInfo>
    <AssemblyTitle>DotNetNuke.Log4Net</AssemblyTitle>
    <Product>log4net</Product>
    <Description>DotNetNuke branded version of log4net</Description>
    <Company>The Apache Software Foundation</Company>
    <Copyright>Copyright 2004-2018 The Apache Software Foundation.</Copyright>
    <Version>3.0.2.0</Version>
    <AssemblyVersion>3.0.2.0</AssemblyVersion>
    <FileVersion>3.0.2.0</FileVersion>
    <InformationalVersion>2.0.14.0-.NET</InformationalVersion>
    <NeutralLanguage></NeutralLanguage>
    <ComVisible>false</ComVisible>
  </PropertyGroup>

  <PropertyGroup Condition=" '$(Configuration)' == 'Debug' ">
    <DefineConstants>TRACE;DEBUG;NET;NET_2_0;NET_4_0;NET_4_5</DefineConstants>
    <DebugSymbols>true</DebugSymbols>
    <Optimize>false</Optimize>
    <AssemblyConfiguration>Debug</AssemblyConfiguration>
  </PropertyGroup>

  <PropertyGroup Condition=" '$(Configuration)' == 'Release' ">
    <DefineConstants>TRACE;STRONG;NET;NET_2_0;NET_4_0;NET_4_5</DefineConstants>
    <DebugSymbols>false</DebugSymbols>
    <Optimize>true</Optimize>
    <AssemblyConfiguration>Retail</AssemblyConfiguration>
  </PropertyGroup>

  <!-- `CLSCompliant(true)`, `AssemblyDefaultAlias("log4net")`, `AssemblyTrademark(...)` and
       `InternalsVisibleTo("log4net.Tests")` are declared by log4net/AssemblyInfo.cs and
       log4net/AssemblyVersionInfo.cs in the shared source tree (see the OWNERSHIP note above),
       so no <AssemblyAttribute> items are declared here. Signing stays off: no .snk exists in
       the repository, hence the InternalsVisibleTo entry in source carries no usable PublicKey
       and <SignAssembly>false</SignAssembly> is set above. -->

  <ItemGroup>
    <!-- The shared log4net/ source tree (compiled by this project AND by the sibling
         DotNetNuke.Log4Net.csproj that DNN_Platform.sln references) uses the ASP.NET Core
         abstractions (HttpContext, ISession, IHttpContextAccessor, IMemoryCache,
         Microsoft.Extensions.Logging/Configuration/DependencyInjection/Primitives) for the
         ported AspNet* appender and pattern converters. All of those assemblies, together with
         System.Diagnostics.EventLog and System.Security.Principal.Windows, ship in the
         Microsoft.AspNetCore.App / Microsoft.NETCore.App shared frameworks on net10.0, so they
         must be consumed through a FrameworkReference rather than as PackageReference items
         (NuGet rejects the packages with NU1510). This mirrors the sibling project exactly so a
         single source tree builds from both. -->
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>

</Project>
