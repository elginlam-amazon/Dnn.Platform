<!-- Upstream (stand-alone) log4net project file. It shares its sources with DotNetNuke.Log4Net.csproj
     in the same folder, so it uses its own intermediate/output folders and explicit compile items. -->
<Project>
  <PropertyGroup>
    <BaseIntermediateOutputPath>obj\vs2010\</BaseIntermediateOutputPath>
  </PropertyGroup>
  <Import Project="Sdk.props" Sdk="Microsoft.NET.Sdk" />

  <PropertyGroup>
    <TargetFrameworks>net10.0;netstandard2.0</TargetFrameworks>
    <AssemblyName>log4net</AssemblyName>
    <RootNamespace>log4net</RootNamespace>
    <LangVersion>latest</LangVersion>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <GenerateAssemblyInfo>false</GenerateAssemblyInfo>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <EnableDefaultItems>false</EnableDefaultItems>
    <BaseOutputPath>..\build\bin\vs2010\</BaseOutputPath>
    <NoWarn>$(NoWarn);CS1591;CS1574;CS0419;CS0618;SYSLIB0003;SYSLIB0005;SYSLIB0011;SYSLIB0014;SYSLIB0050;SYSLIB0051;CA1416</NoWarn>
  </PropertyGroup>
  <PropertyGroup Condition="'$(TargetFramework)' == 'net10.0'">
    <DefineConstants>$(DefineConstants);NETSTANDARD;NETSTANDARD2_0</DefineConstants>
  </PropertyGroup>
  <PropertyGroup Condition="'$(Configuration)' == 'Release'">
    <DefineConstants>$(DefineConstants);STRONG</DefineConstants>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="log4net\**\*.cs" Exclude="log4net\Log4netAssemblyInfo.cs" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="System.Configuration.ConfigurationManager" Version="10.0.12" />
  </ItemGroup>
  <ItemGroup Condition="'$(TargetFramework)' == 'netstandard2.0'">
    <PackageReference Include="System.Security.Principal.Windows" Version="5.0.0" />
  </ItemGroup>

  <Import Project="Sdk.targets" Sdk="Microsoft.NET.Sdk" />
</Project>
