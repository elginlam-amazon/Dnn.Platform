<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <!-- net48 was dropped: the only .NET Framework consumer (the Website) now consumes the
         netstandard2.0 build, so the ASP.NET specific appenders/pattern converters are no longer needed. -->
    <TargetFrameworks>net10.0;netstandard2.0</TargetFrameworks>
    <AssemblyName>DotNetNuke.Log4Net</AssemblyName>
    <RootNamespace>log4net</RootNamespace>
    <Deterministic>true</Deterministic>
    <LangVersion>latest</LangVersion>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <GenerateAssemblyInfo>false</GenerateAssemblyInfo>
    <OutputPath>bin\</OutputPath>
    <RootDirectory>$(MSBuildProjectDirectory)\..\..</RootDirectory>
    <!-- Legacy log4net code base: keep the warning profile of the original project. -->
    <NoWarn>$(NoWarn);CS1591;CS1574;CS0419;CS0618;SYSLIB0003;SYSLIB0005;SYSLIB0011;SYSLIB0014;SYSLIB0050;SYSLIB0051;CA1416</NoWarn>
  </PropertyGroup>

  <!-- log4net selects platform specific code through its own conditional compilation symbols. -->
  <PropertyGroup Condition="'$(TargetFramework)' == 'net10.0'">
    <!-- The modern runtime uses the same (System.Web free) code paths as the .NET Standard 2.0 build. -->
    <DefineConstants>$(DefineConstants);NETSTANDARD;NETSTANDARD2_0</DefineConstants>
  </PropertyGroup>
  <PropertyGroup Condition="'$(Configuration)' == 'Release'">
    <DefineConstants>$(DefineConstants);STRONG</DefineConstants>
  </PropertyGroup>

  <ItemGroup>
    <!-- Central package management is disabled for this folder (see Directory.Packages.props), so the version is set here. -->
    <PackageReference Include="System.Configuration.ConfigurationManager" Version="10.0.12" />
  </ItemGroup>
  <ItemGroup Condition="'$(TargetFramework)' == 'netstandard2.0'">
    <PackageReference Include="System.Security.Principal.Windows" Version="5.0.0" />
  </ItemGroup>

  <ItemGroup>
    <!-- Not part of the original project (duplicate assembly level constants). -->
    <Compile Remove="log4net\Log4netAssemblyInfo.cs" />
  </ItemGroup>

  <Import Project="..\..\DNN_Platform.build" />
  <Target Name="CopyBin" AfterTargets="Build" Condition="'$(TargetFramework)' == 'net10.0'">
    <Copy SourceFiles="$(TargetDir)$(AssemblyName).dll" DestinationFolder="$(WebsitePath)/bin" />
    <Copy SourceFiles="$(TargetDir)$(AssemblyName).pdb" DestinationFolder="$(WebsitePath)/bin" Condition="Exists('$(TargetDir)$(AssemblyName).pdb')" />
    <Copy SourceFiles="$(TargetDir)$(AssemblyName).xml" DestinationFolder="$(WebsitePath)/bin" Condition="Exists('$(TargetDir)$(AssemblyName).xml')" />
  </Target>
</Project>
