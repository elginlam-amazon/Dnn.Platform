<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <AssemblyName>DotNetNuke.Log4Net</AssemblyName>
    <RootNamespace>log4net</RootNamespace>
    <ProjectGuid>{04F77171-0634-46E0-A95E-D7477C88712E}</ProjectGuid>
    <LangVersion>latest</LangVersion>
    <Deterministic>true</Deterministic>
    <PlatformTarget>AnyCPU</PlatformTarget>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <WarningLevel>4</WarningLevel>
    <ErrorReport>prompt</ErrorReport>
    <!-- The vendored log4net source owns its assembly-level attributes (log4net/AssemblyInfo.cs,
         log4net/AssemblyVersionInfo.cs), so the SDK must not generate its own. -->
    <GenerateAssemblyInfo>false</GenerateAssemblyInfo>
    <!-- SYSLIB0014 only: System.Net.Mail.SmtpClient is obsoleted but is still the supported
         transport for SmtpAppender; every other warning stays an error via TreatWarningsAsErrors. -->
    <NoWarn>SYSLIB0014</NoWarn>
    <!-- Keep the flat bin/ layout the DNN CopyBin target and the website bin/ expect. -->
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    <!-- This project shares its directory (and therefore obj/) with log4net.vs2010.csproj.
         With a reference assembly in play, one project's IncrementalClean intermittently
         deletes obj/Debug/ref/DotNetNuke.Log4Net.dll while a consumer (DotNetNuke.Instrumentation)
         is compiling against it, producing a flaky CS0006 "Metadata file could not be found".
         Disabling the reference assembly removes the contested artifact; consumers bind to
         bin/DotNetNuke.Log4Net.dll instead. Costs only an incremental-build optimisation. -->
    <ProduceReferenceAssembly>false</ProduceReferenceAssembly>
  </PropertyGroup>

  <PropertyGroup Condition=" '$(Configuration)' == 'Debug' ">
    <OutputPath>bin/</OutputPath>
    <DebugSymbols>true</DebugSymbols>
    <DebugType>full</DebugType>
    <Optimize>false</Optimize>
    <DefineConstants>TRACE;DEBUG;NET;NET_2_0;NET_4_0;NET_4_5</DefineConstants>
    <DocumentationFile>bin/DotNetNuke.Log4Net.xml</DocumentationFile>
  </PropertyGroup>

  <PropertyGroup Condition=" '$(Configuration)' == 'Release' ">
    <OutputPath>bin/</OutputPath>
    <DebugSymbols>false</DebugSymbols>
    <DebugType>pdbonly</DebugType>
    <Optimize>true</Optimize>
    <DefineConstants>TRACE;STRONG;NET;NET_2_0;NET_4_0;NET_4_5</DefineConstants>
    <DocumentationFile>bin/DotNetNuke.Log4Net.xml</DocumentationFile>
  </PropertyGroup>

  <ItemGroup>
    <None Include="Directory.Packages.props" />
  </ItemGroup>

  <ItemGroup>
    <!-- ASP.NET Core abstractions (HttpContext, ISession, IHttpContextAccessor) ship in the
         Microsoft.AspNetCore.App shared framework on net10.0; the legacy
         Microsoft.AspNetCore.Http.Abstractions package is .NET Framework/2.x-era only. -->
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>

  <ItemGroup>
    <!-- Only genuinely external dependencies are referenced. On net10.0 the
         Microsoft.Extensions.Configuration(.Abstractions), Microsoft.Extensions.Caching.Memory,
         Microsoft.Extensions.Logging.Abstractions, System.Text.Json, System.Diagnostics.EventLog
         and System.Security.Principal.Windows assemblies are provided by the
         Microsoft.NETCore.App / Microsoft.AspNetCore.App shared frameworks referenced above;
         referencing them as packages is rejected by NuGet (NU1510). -->
    <PackageReference Include="Microsoft.Data.SqlClient" Version="7.1.1" />
    <!-- Pin the transitive Pkcs dependency of Microsoft.Data.SqlClient to a non-vulnerable patch
         (NU1902/NU1903 are errors here because of TreatWarningsAsErrors). -->
    <PackageReference Include="System.Security.Cryptography.Pkcs" Version="10.0.14" />
  </ItemGroup>

  <PropertyGroup>
    <RootDirectory>$(MSBuildProjectDirectory)/../..</RootDirectory>
  </PropertyGroup>
  <Import Project="../../DNN_Platform.build" />
  <Target Name="AfterBuild" DependsOnTargets="CopyBin" />
  <Target Name="CopyBin">
    <Copy SourceFiles="$(MSBuildProjectDirectory)/bin/$(AssemblyName).dll" DestinationFolder="$(WebsitePath)/bin" />
    <Copy SourceFiles="$(MSBuildProjectDirectory)/bin/$(AssemblyName).pdb" DestinationFolder="$(WebsitePath)/bin" />
    <Copy SourceFiles="$(MSBuildProjectDirectory)/bin/$(AssemblyName).xml" DestinationFolder="$(WebsitePath)/bin" />
  </Target>

</Project>
