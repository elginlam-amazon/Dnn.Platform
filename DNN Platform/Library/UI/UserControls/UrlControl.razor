        set => this.localResourceFile = value;
    }

    /// <summary>Gets or sets the id of the module the url belongs to.</summary>
    [Parameter]
    public int ModuleID
    {
        get
        {
            var myMid = -2;
            if (this.moduleIdSet)
            {
                myMid = this.moduleId;
            }
            else
            {
                var queryValue = this.Request?.Query["mid"].ToString();
                if (!string.IsNullOrEmpty(queryValue))
                {
                    if (!int.TryParse(queryValue, out myMid))
                    {
                        myMid = -2;
                    }
                }
            }

            return myMid;
        }

        set
        {
            this.moduleId = value;
            this.moduleIdSet = true;
        }
    }

