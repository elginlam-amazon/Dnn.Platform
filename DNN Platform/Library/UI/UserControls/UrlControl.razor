    /// <summary>Gets the files of the selected folder.</summary>
    /// <param name="noneSpecified">Whether to include a "none specified" entry.</param>
    /// <returns>The file list.</returns>
    private ArrayList GetFileList(bool noneSpecified)
    {
        var portalId = Null.NullInteger;

        if ((!this.IsHostMenu) || !string.IsNullOrEmpty(this.Request?.Query["pid"].ToString()))
        {
            portalId = this.objPortal.PortalID;
        }

        return Globals.GetFileList(portalId, this.FileFilter, noneSpecified, this.SelectedFolderValue, false);
    }

    /// <summary>Reloads the file list of the selected folder.</summary>
    /// <param name="noneSpecified">Whether to include a "none specified" entry.</param>
    private void LoadFiles(bool noneSpecified)
    {
        var previous = this.SelectedFileValue;
        this.fileItems.Clear();
        foreach (FileItem file in this.GetFileList(noneSpecified))
        {
            this.fileItems.Add(new ListItem(file.Text, file.Value));
        }

        var restored = this.fileItems.FindByValue(previous);
        if (restored != null)
        {
            restored.Selected = true;
        }
    }

    /// <summary>Loads the folders the current user has the given permissions on.</summary>
    /// <param name="permissions">The comma separated list of required permissions.</param>
    private void LoadFolders(string permissions)
    {
        this.folderItems.Clear();

        var folders = FolderManager.Instance.GetFolders(UserController.Instance.GetCurrentUserInfo(), permissions);
        foreach (FolderInfo folder in folders)
        {
            var folderItem = new ListItem();
            if (folder.FolderPath == Null.NullString)
            {
                folderItem.Text = Localization.GetString("Root", this.LocalResourceFile);
            }
            else
            {
                folderItem.Text = folder.DisplayPath;
            }

            folderItem.Value = folder.FolderPath;
            this.folderItems.Add(folderItem);
        }
    }

    /// <summary>Loads the urls that were stored for the portal.</summary>
    private void LoadUrls()
    {
        var objUrls = new UrlController();
        this.urlItems.Clear();
        foreach (UrlInfo url in objUrls.GetUrls(this.objPortal.PortalID))
        {
            this.urlItems.Add(new ListItem(url.Url, url.Url));
        }
    }

    /// <summary>Shows the storage provider icon of the selected folder.</summary>
    private void SetStorageLocationType()
    {
        var folderName = this.SelectedFolderValue;

        // Check to see if this is the 'Root' folder, if so we cannot rely on its text value because it is something and not an empty string that we need to lookup the 'root' folder
        if (this.SelectedFolderValue == string.Empty)
        {
            folderName = string.Empty;
        }

        var objFolderInfo = FolderManager.Instance.GetFolder(this.PortalSettings.PortalId, folderName);
        if (objFolderInfo != null)
        {
            var folderMapping = FolderMappingController.Instance.GetFolderMapping(objFolderInfo.PortalID, objFolderInfo.FolderMappingID);
            if (folderMapping.MappingName == "Standard")
            {
                this.StorageLocationTypeVisible = false;
            }
            else
            {
                this.StorageLocationTypeVisible = true;
                this.StorageLocationTypeImageUrl = FolderProvider.Instance(folderMapping.FolderProviderType).GetFolderProviderIconPath();
            }
        }
    }

    /// <summary>Resolves the url that was assigned and selects the matching link type.</summary>
    private void DoChangeURL()
    {
        var url = this.urlState ?? string.Empty;
        var urltype = this.urlType ?? string.Empty;
        if (!string.IsNullOrEmpty(url))
        {
            var objUrls = new UrlController();
            var trackingUrl = url;

            urltype = Globals.GetURLType(url).ToString("g").Substring(0, 1);
            if (urltype == "U" && url.StartsWith("~/" + this.PortalSettings.DefaultIconLocation, StringComparison.InvariantCultureIgnoreCase))
            {
                urltype = "I";
            }

            this.urlType = urltype;
            if (urltype == "F")
            {
                if (url.StartsWith("fileid=", StringComparison.InvariantCultureIgnoreCase))
                {
                    trackingUrl = url;
                    var objFile = FileManager.Instance.GetFile(int.Parse(url.Substring(7), CultureInfo.InvariantCulture));
                    if (objFile != null)
                    {
                        url = objFile.Folder + objFile.FileName;
                    }
                }
                else
                {
                    // to handle legacy scenarios before the introduction of the FileServerHandler
                    var fileName = Path.GetFileName(url);
                    var folderPath = url.Substring(0, url.LastIndexOf(fileName, StringComparison.OrdinalIgnoreCase));
                    var folder = FolderManager.Instance.GetFolder(this.objPortal.PortalID, folderPath);
                    var fileId = -1;
                    if (folder != null)
                    {
                        var file = FileManager.Instance.GetFile(folder, fileName);
                        if (file != null)
                        {
                            fileId = file.FileId;
                        }
                    }

                    trackingUrl = "FileID=" + fileId.ToString(CultureInfo.InvariantCulture);
                }
            }

            if (urltype == "M")
            {
                if (url.StartsWith("userid=", StringComparison.InvariantCultureIgnoreCase))
                {
                    var objUser = UserController.GetUserById(this.objPortal.PortalID, int.Parse(url.Substring(7), CultureInfo.InvariantCulture));
                    if (objUser != null)
                    {
                        url = objUser.Username;
                    }
                }
            }

            var objUrlTracking = objUrls.GetUrlTracking(this.objPortal.PortalID, trackingUrl, this.ModuleID);
            if (objUrlTracking != null)
            {
                this.newWindowChecked = objUrlTracking.NewWindow;
                this.trackChecked = objUrlTracking.TrackClicks;
                this.logChecked = objUrlTracking.LogActivity;
            }
            else
            {
                // the url does not exist in the tracking table
                this.trackChecked = false;
                this.logChecked = false;
            }

            this.urlState = url;
        }
        else
        {
            if (!string.IsNullOrEmpty(urltype))
            {
                this.typeItems.ClearSelection();
                var item = this.typeItems.FindByValue(urltype);
                if (item != null)
                {
                    item.Selected = true;
                }
                else if (this.typeItems.Count > 0)
                {
                    this.typeItems[0].Selected = true;
                }
            }
            else
            {
                if (this.typeItems.Count > 0)
                {
                    this.typeItems.ClearSelection();
                    this.typeItems[0].Selected = true;
                }
            }

            this.newWindowChecked = false; // Need check
            this.trackChecked = false; // Need check
            this.logChecked = false; // Need check
        }

        // Url type changed, then we must draw the controls for that type
        this.doRenderTypeControls = true;
    }

    /// <summary>Builds the list of offered link types.</summary>
    private void DoRenderTypes()
    {
        // We must clear the list to keep the same item order
        var strCurrent = this.SelectedTypeValue; // Save current selected value

        this.typeItems.Clear();
        if (this.ShowNone)
        {
            this.typeItems.Add(new ListItem(Localization.GetString("NoneType", this.LocalResourceFile), "N"));
        }

        if (this.ShowUrls)
        {
            this.typeItems.Add(new ListItem(Localization.GetString("URLType", this.LocalResourceFile), "U"));
        }

        if (this.ShowTabs)
        {
            this.typeItems.Add(new ListItem(Localization.GetString("TabType", this.LocalResourceFile), "T"));
        }

        if (this.ShowFiles)
        {
            this.typeItems.Add(new ListItem(Localization.GetString("FileType", this.LocalResourceFile), "F"));
        }

        if (this.ShowImages)
        {
            this.typeItems.Add(new ListItem(Localization.GetString("ImageType", this.LocalResourceFile), "I"));
        }

        if (this.ShowUsers)
        {
            this.typeItems.Add(new ListItem(Localization.GetString("UserType", this.LocalResourceFile), "M"));
        }

        if (this.typeItems.Count > 0)
        {
            if (!string.IsNullOrEmpty(strCurrent))
            {
                var item = this.typeItems.FindByValue(strCurrent);
                if (item != null)
                {
                    item.Selected = true;
                }
                else
                {
                    this.typeItems[0].Selected = true;
                    this.doRenderTypeControls = true; // Type changed, re-draw
                }
            }
            else
            {
                this.typeItems[0].Selected = true;
                this.doRenderTypeControls = true; // Type changed, re-draw
            }

            this.TypeRowVisible = this.typeItems.Count > 1;
        }
        else
        {
            this.TypeRowVisible = false;
        }
    }

    /// <summary>Makes sure the selected link type matches the recorded url type.</summary>
    private void DoCorrectRadioButtonList()
    {
        var urltype = this.urlType ?? string.Empty;

        if (this.typeItems.Count > 0)
        {
            this.typeItems.ClearSelection();
            if (!string.IsNullOrEmpty(urltype))
            {
                var item = this.typeItems.FindByValue(urltype);
                if (item != null)
                {
                    item.Selected = true;
                }
                else
                {
                    this.typeItems[0].Selected = true;
                    urltype = this.typeItems[0].Value;
                    this.urlType = urltype;
                }
            }
            else
            {
                this.typeItems[0].Selected = true;
                urltype = this.typeItems[0].Value;
                this.urlType = urltype;
            }
        }
    }

    /// <summary>Renders the editors of the selected link type.</summary>
    private void DoRenderTypeControls()
    {
        var url = this.urlState ?? string.Empty;
        var urltype = this.urlType ?? string.Empty;
        if (!string.IsNullOrEmpty(urltype))
        {
            // load listitems
            switch (this.SelectedTypeValue)
            {
                case "N": // None
                    this.UrlRowVisible = false;
                    this.TabRowVisible = false;
                    this.FileRowVisible = false;
                    this.UserRowVisible = false;
                    this.ImagesRowVisible = false;
                    break;
                case "I": // System Image
                    this.UrlRowVisible = false;
                    this.TabRowVisible = false;
                    this.FileRowVisible = false;
                    this.UserRowVisible = false;
                    this.ImagesRowVisible = true;

                    this.imageItems.Clear();

                    var strImagesFolder = Path.Combine(Globals.ApplicationMapPath, this.PortalSettings.DefaultIconLocation.Replace('/', '\\'));
                    foreach (var strImage in Directory.GetFiles(strImagesFolder))
                    {
                        var img = strImage.Replace(strImagesFolder, string.Empty).Trim('/').Trim('\\');
                        this.imageItems.Add(new ListItem(img, $"~/{this.PortalSettings.DefaultIconLocation}/{img}".ToLowerInvariant()));
                    }

                    var selectedItem = this.imageItems.FindByValue(url.ToLowerInvariant());
                    if (selectedItem != null)
                    {
                        selectedItem.Selected = true;
                    }

                    break;

                case "U": // Url
                    this.UrlRowVisible = true;
                    this.TabRowVisible = false;
                    this.FileRowVisible = false;
                    this.UserRowVisible = false;
                    this.ImagesRowVisible = false;
                    if (string.IsNullOrEmpty(this.urlText))
                    {
                        this.urlText = url;
                    }

                    if (string.IsNullOrEmpty(this.urlText))
                    {
                        this.urlText = "http://";
                    }

                    this.UrlTextVisible = true;

                    this.SelectButtonVisible = true;

                    this.UrlListVisible = false;
                    this.AddButtonVisible = false;
                    this.DeleteButtonVisible = false;
                    break;
                case "T": // tab
                    this.UrlRowVisible = false;
                    this.TabRowVisible = true;
                    this.FileRowVisible = false;
                    this.UserRowVisible = false;
                    this.ImagesRowVisible = false;

                    this.tabItems.Clear();

                    var currentPage = TabController.CurrentPage;
                    var settings = PortalController.Instance.GetCurrentSettings();
                    foreach (TabInfo tab in TabController.GetPortalTabs(settings.PortalId, Null.NullInteger, !this.Required, "none available", true, false, false, true, false))
                    {
                        this.tabItems.Add(new ListItem(tab.IndentedTabName, tab.TabID.ToString(CultureInfo.InvariantCulture)));
                    }

                    var selectedTab = this.tabItems.FindByValue(url);
                    if (selectedTab != null)
                    {
                        selectedTab.Selected = true;
                    }

                    if (!this.IncludeActiveTab)
                    {
                        var activeTab = this.tabItems.FindByValue(currentPage.TabID.ToString(CultureInfo.InvariantCulture));
                        if (activeTab != null)
                        {
                            // Was Attributes.Add("disabled", "disabled") on the list item.
                            activeTab.Enabled = false;
                        }
                    }

                    break;
                case "F": // file
                    this.UrlRowVisible = false;
                    this.TabRowVisible = false;
                    this.FileRowVisible = true;
                    this.UserRowVisible = false;
                    this.ImagesRowVisible = false;

                    if (!this.foldersLoaded || this.doReloadFolders)
                    {
                        this.LoadFolders("BROWSE,WRITE");
                        this.foldersLoaded = true;
                    }

                    if (this.folderItems.Count == 0)
                    {
                        this.Message = Localization.GetString("NoPermission", this.LocalResourceFile);
                        this.ErrorRowVisible = true;
                        this.FileRowVisible = false;
                        return;
                    }

                    // select folder
                    // We Must check if selected folder has changed because of a property change (Secure, Database)
                    var fileName = string.Empty;
                    var folderPath = string.Empty;
                    var lastFile = this.lastFileName ?? string.Empty;
                    var lastFolder = this.lastFolderPath ?? string.Empty;
                    var mustRedrawFiles = false;

                    if (url != string.Empty)
                    {
                        // Let's use the new URL
                        fileName = url.Substring(url.LastIndexOf("/", StringComparison.Ordinal) + 1);
                        folderPath = url.Replace(fileName, string.Empty);
                    }
                    else
                    {
                        // Use last settings
                        fileName = lastFile;
                        folderPath = lastFolder;
                    }

                    var folderItem = this.folderItems.FindByValue(folderPath);
                    if (folderItem != null)
                    {
                        this.folderItems.ClearSelection();
                        folderItem.Selected = true;
                    }
                    else if (this.folderItems.Count > 0)
                    {
                        this.folderItems.ClearSelection();
                        this.folderItems[0].Selected = true;
                        folderPath = this.folderItems[0].Value;
                    }

                    if (!this.filesLoaded || folderPath != lastFolder || this.doReloadFiles)
                    {
                        // Reload files only if property change or not same folder
                        mustRedrawFiles = true;
                        this.filesLoaded = true;
                    }
                    else
                    {
                        if (this.fileItems.Count > 0)
                        {
                            if ((this.Required && string.IsNullOrEmpty(this.fileItems[0].Value)) || (!this.Required && !string.IsNullOrEmpty(this.fileItems[0].Value)))
                            {
                                // Required state has changed, so we need to reload files
                                mustRedrawFiles = true;
                            }
                        }
                        else if (!this.Required)
                        {
                            // Required state has changed, so we need to reload files
                            mustRedrawFiles = true;
                        }
                    }

                    if (mustRedrawFiles)
                    {
                        this.fileItems.Clear();
                        foreach (FileItem file in this.GetFileList(!this.Required))
                        {
                            this.fileItems.Add(new ListItem(file.Text, file.Value));
                        }

                        var selectedFile = this.fileItems.FindByText(fileName);
                        if (selectedFile != null)
                        {
                            this.fileItems.ClearSelection();
                            selectedFile.Selected = true;
                        }
                    }

                    this.FileListVisible = true;
                    this.FileUploadVisible = false;

                    var objFolder = (FolderInfo)FolderManager.Instance.GetFolder(this.objPortal.PortalID, folderPath);
                    this.UploadButtonVisible = this.ShowUpLoad && objFolder != null && FolderPermissionController.CanAddFolder(objFolder);

                    this.SetStorageLocationType();
                    this.UrlTextVisible = false;
                    this.SaveButtonVisible = false;
                    this.CancelButtonVisible = false;

                    this.lastFolderPath = this.SelectedFolderValue;
                    this.lastFileName = this.SelectedFileValue;

                    break;
                case "M": // membership users
                    this.UrlRowVisible = false;
                    this.TabRowVisible = false;
                    this.FileRowVisible = false;
                    this.UserRowVisible = true;
                    this.ImagesRowVisible = false;
                    if (string.IsNullOrEmpty(this.userText))
                    {
                        this.userText = url;
                    }

                    break;
            }
        }
        else
        {
            this.UrlRowVisible = false;
            this.ImagesRowVisible = false;
            this.TabRowVisible = false;
            this.FileRowVisible = false;
            this.UserRowVisible = false;
        }
    }
}
