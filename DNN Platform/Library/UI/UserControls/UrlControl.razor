    /// <summary>Switches the file row into upload mode.</summary>
    /// <returns>A task representing the operation.</returns>
    /// <remarks>This is the port of <c>cmdUpload_Click</c>.</remarks>
    private Task UploadAsync()
    {
        var strSaveFolder = this.SelectedFolderValue;
        this.LoadFolders("WRITE");
        var saveFolder = this.folderItems.FindByValue(strSaveFolder);
        if (saveFolder != null)
        {
            saveFolder.Selected = true;
            this.FileListVisible = false;
            this.UploadButtonVisible = false;
            this.FileUploadVisible = true;
            this.SaveButtonVisible = true;
            this.CancelButtonVisible = true;
        }
        else
        {
            if (this.folderItems.Count > 0)
            {
                this.folderItems[0].Selected = true;
                this.FileListVisible = false;
                this.UploadButtonVisible = false;
                this.FileUploadVisible = true;
                this.SaveButtonVisible = true;
                this.CancelButtonVisible = true;
            }
            else
            {
                // reset controls
                this.LoadFolders("BROWSE,WRITE");
                var restored = this.folderItems.FindByValue(strSaveFolder);
                if (restored != null)
                {
                    restored.Selected = true;
                }

                this.FileListVisible = true;
                this.UploadButtonVisible = false;
                this.FileUploadVisible = false;
                this.SaveButtonVisible = false;
                this.CancelButtonVisible = false;
                this.Message = Localization.GetString("NoWritePermission", this.LocalResourceFile);
                this.ErrorRowVisible = true;
            }
        }

        this.ResetRenderFlags();
        return Task.CompletedTask;
    }

