    /// <summary>Gets or sets the selected url.</summary>
    [Parameter]
    public string Url
    {
        get
        {
            var r = string.Empty;
            var strCurrentType = this.SelectedTypeValue;

            switch (strCurrentType)
            {
                case "I":
                    var selectedImage = this.imageItems.Find(item => item.Selected);
                    if (selectedImage != null)
                    {
                        r = selectedImage.Value;
                    }

                    break;
                case "U":
                    if (this.UrlListVisible)
                    {
                        var selectedUrl = this.urlItems.Find(item => item.Selected);
                        if (selectedUrl != null)
                        {
                            r = selectedUrl.Value;
                            this.urlText = r;
                        }
                    }
                    else
                    {
                        var mCustomUrl = this.urlText;
                        if (mCustomUrl.Equals("http://", StringComparison.OrdinalIgnoreCase))
                        {
                            r = string.Empty;
                        }
                        else
                        {
                            r = Globals.AddHTTP(mCustomUrl);
                        }
                    }

                    break;
                case "T":
                    var selectedTab = this.tabItems.Find(item => item.Selected);
                    if (selectedTab != null)
                    {
                        var strTab = selectedTab.Value;
                        if (Globals.NumberMatchRegex.IsMatch(strTab) && (Convert.ToInt32(strTab, CultureInfo.InvariantCulture) >= 0))
                        {
                            r = strTab;
                        }
                    }

                    break;
                case "F":
                    var selectedFile = this.fileItems.Find(item => item.Selected);
                    if (selectedFile != null)
                    {
                        if (!string.IsNullOrEmpty(selectedFile.Value))
                        {
                            r = "FileID=" + selectedFile.Value;
                        }
                        else
                        {
                            r = string.Empty;
                        }
                    }

                    break;
                case "M":
                    if (!string.IsNullOrEmpty(this.userText))
                    {
                        var objUser = UserController.GetCachedUser(this.objPortal.PortalID, this.userText);
                        if (objUser != null)
                        {
                            r = "UserID=" + objUser.UserID;
                        }
                        else
                        {
                            this.Message = Localization.GetString("NoUser", this.LocalResourceFile);
                            this.ErrorRowVisible = true;
                            this.userText = string.Empty;
                        }
                    }

                    break;
            }

            return r;
        }

        set
        {
            this.urlState = value;
            this.urlText = string.Empty;

            if (this.initialized)
            {
                this.doChangeURL = true;
                this.doReloadFiles = true;
            }
        }
    }

