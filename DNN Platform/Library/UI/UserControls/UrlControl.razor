    /// <inheritdoc />
    protected override void OnInit(EventArgs e)
    {
        base.OnInit(e);

        var context = DotNetNuke.Common.HttpContextSource.Current;
        if (context is null)
        {
            Logger.Debug("UrlControl: no HTTP request in flight, the save button cannot be excluded from partial postbacks.");
        }
        else
        {
            AJAX.RegisterPostBackControl(this);
        }

        // prevent unauthorized access
        if (this.Request is null || !this.Request.IsAuthenticated())
        {
            this.IsVisible = false;
        }
    }

    /// <inheritdoc />
    protected override void OnLoad(EventArgs e)
    {
        base.OnLoad(e);

        if (this.initialized)
        {
            return;
        }

        this.ErrorRowVisible = false;

        try
        {
            var portalIdValue = this.Request?.Query["pid"].ToString();
            if (!string.IsNullOrEmpty(portalIdValue) && (Globals.IsHostTab(this.PortalSettings.ActiveTab.TabID) || UserController.Instance.GetCurrentUserInfo().IsSuperUser))
            {
                this.objPortal = PortalController.Instance.GetPortal(int.Parse(portalIdValue, CultureInfo.InvariantCulture));
            }
            else
            {
                this.objPortal = PortalController.Instance.GetPortal(this.PortalSettings.PortalId);
            }

            if (!this.isUrlControlLoaded)
            {
                // let's make at least an initialization
                // The type radio button must be initialized
                // The url must be initialized no matter its value
                this.doRenderTypes = true;
                this.doChangeURL = true;
            }
        }
        catch (Exception exc)
        {
            this.Message = UserControlExceptionHandler.Process(exc);
            this.ErrorRowVisible = true;
        }

        this.initialized = true;

        // The Web Forms control did this work in PreRender; a component must have its markup state
        // ready before it renders, so the same pipeline runs at the end of the load phase.
        this.RenderPipeline();
    }

    /// <summary>Runs the deferred rendering steps, which was the body of the Web Forms <c>OnPreRender</c>.</summary>
    private void RenderPipeline()
    {
        try
        {
            if (this.doRenderTypes)
            {
                this.DoRenderTypes();
            }

            if (this.doChangeURL)
            {
                this.DoChangeURL();
            }

            if (this.doReloadFolders || this.doReloadFiles)
            {
                this.DoCorrectRadioButtonList();
                this.doRenderTypeControls = true;
            }

            if (this.doRenderTypeControls)
            {
                if (!(this.doReloadFolders || this.doReloadFiles))
                {
                    this.DoCorrectRadioButtonList();
                }

                this.DoRenderTypeControls();
            }

            this.urlState = null;
            this.isUrlControlLoaded = true;
        }
        catch (Exception exc)
        {
            // Let's detect possible problems
            Exceptions.LogException(new RenderException("Error rendering URLControl subcontrols.", exc));
        }
    }

    /// <summary>Resets the deferred rendering flags, which the Web Forms handlers did on every postback.</summary>
    private void ResetRenderFlags()
    {
        this.doRenderTypeControls = false; // Must not render on this postback
        this.doRenderTypes = false;
        this.doChangeURL = false;
        this.doReloadFolders = false;
        this.doReloadFiles = false;
    }

