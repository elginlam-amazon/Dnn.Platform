    /// <summary>Uploads the picked file into the selected folder.</summary>
    /// <returns>A task representing the operation.</returns>
    /// <remarks>This is the port of <c>cmdSave_Click</c>.</remarks>
    private async Task SaveAsync()
    {
        this.UploadButtonVisible = false;

        // if no file is selected exit
        if (this.pendingUpload is null || string.IsNullOrEmpty(this.pendingUpload.Name))
        {
            return;
        }

        string parentFolderName;
        if (Globals.IsHostTab(this.PortalSettings.ActiveTab.TabID))
        {
            parentFolderName = Globals.HostMapPath;
        }
        else
        {
            parentFolderName = this.PortalSettings.HomeDirectoryMapPath;
        }

        parentFolderName += this.SelectedFolderValue;

        var strExtension = Path.GetExtension(this.pendingUpload.Name).Replace(".", string.Empty);
        if (!string.IsNullOrEmpty(this.FileFilter) && !("," + this.FileFilter).Contains("," + strExtension, StringComparison.OrdinalIgnoreCase))
        {
            // trying to upload a file not allowed for current filter
            this.Message = string.Format(CultureInfo.CurrentCulture, Localization.GetString("UploadError", this.LocalResourceFile), this.FileFilter, strExtension);
            this.ErrorRowVisible = true;
        }
        else
        {
            var fileManager = FileManager.Instance;
            var folderManager = FolderManager.Instance;

            var settings = PortalController.Instance.GetCurrentSettings();
            var currentPage = TabController.CurrentPage;
            var portalId = (currentPage.ParentId == settings.SuperTabId) ? Null.NullInteger : settings.PortalId;

            var fileName = Path.GetFileName(this.pendingUpload.Name);
            var folderPath = Globals.GetSubFolderPath(parentFolderName.Replace("/", @"\") + fileName, portalId);

            var folder = folderManager.GetFolder(portalId, folderPath);
            this.ErrorRowVisible = false;

            try
            {
                // Was txtFile.PostedFile.InputStream; a browser file is streamed instead.
                await using var uploadStream = this.pendingUpload.OpenReadStream(MaxUploadSize);
                fileManager.AddFile(folder, fileName, uploadStream, true, true, ((FileManager)fileManager).GetContentType(Path.GetExtension(fileName)));
            }
            catch (Services.FileSystem.PermissionsNotMetException)
            {
                this.Message += "<br />" + string.Format(CultureInfo.CurrentCulture, Localization.GetString("InsufficientFolderPermission"), folder.FolderPath);
                this.ErrorRowVisible = true;
            }
            catch (NoSpaceAvailableException)
            {
                this.Message += "<br />" + string.Format(CultureInfo.CurrentCulture, Localization.GetString("DiskSpaceExceeded"), fileName);
                this.ErrorRowVisible = true;
            }
            catch (InvalidFileExtensionException)
            {
                this.Message += "<br />" + string.Format(CultureInfo.CurrentCulture, Localization.GetString("RestrictedFileType"), fileName, Host.AllowedExtensionWhitelist.ToDisplayString());
                this.ErrorRowVisible = true;
            }
            catch (Exception)
            {
                this.Message += "<br />" + string.Format(CultureInfo.CurrentCulture, Localization.GetString("SaveFileError"), fileName);
                this.ErrorRowVisible = true;
            }
        }

        if (string.IsNullOrEmpty(this.Message))
        {
            this.FileListVisible = true;
            this.UploadButtonVisible = this.ShowUpLoad;
            this.FileUploadVisible = false;
            this.SaveButtonVisible = false;
            this.CancelButtonVisible = false;
            this.ErrorRowVisible = false;

            this.LoadFiles(false);

            var fileName1 = this.pendingUpload.Name.Substring(this.pendingUpload.Name.LastIndexOf(@"\", StringComparison.Ordinal) + 1);
            var uploaded = this.fileItems.FindByText(fileName1);
            if (uploaded != null)
            {
                this.fileItems.ClearSelection();
                uploaded.Selected = true;
            }

            this.lastFileName = this.SelectedFileValue;
        }

        this.pendingUpload = null;
        this.ResetRenderFlags();
    }

