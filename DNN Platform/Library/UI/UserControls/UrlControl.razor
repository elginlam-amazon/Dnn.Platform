@if (this.IsVisible)
{
    <div class="urlControl">
        @if (this.TypeRowVisible)
        {
            <div class="urlControlLinkType dnnClear">
                <span class="dnnFormLabel">@this.TypeCaption</span>
                <div class="ucLinkTypeRadioButtons">
                    @foreach (var item in this.typeItems)
                    {
                        <div>
                            <label>
                                <input type="radio"
                                       name="@this.TypeGroupName"
                                       value="@item.Value"
                                       checked="@item.Selected"
                                       @onchange="@(() => this.OnTypeChangedAsync(item.Value))" />
                                @item.Text
                            </label>
                        </div>
                    }
                </div>
            </div>
        }
        @if (this.UrlRowVisible)
        {
            <div class="urlControlFile dnnClear">
                <span>@this.UrlCaption</span>
                <div>
                    @if (this.UrlListVisible)
                    {
                        <select id="cboUrls" style="@this.ControlWidthStyle" @onchange="this.OnUrlSelectedAsync">
                            @foreach (var item in this.urlItems)
                            {
                                <option value="@item.Value" selected="@item.Selected">@item.Text</option>
                            }
                        </select>
                    }
                    @if (this.UrlTextVisible)
                    {
                        <input id="txtUrl" type="text" style="@this.ControlWidthStyle" value="@this.urlText" @onchange="this.OnUrlTextChangedAsync" />
                    }
                    @if (this.SelectButtonVisible)
                    {
                        <a id="cmdSelect" class="dnnSecondaryAction" href="javascript:void(0);" @onclick="this.SelectAsync" @onclick:preventDefault="true">@this.SelectCaption</a>
                    }
                    @if (this.DeleteButtonVisible)
                    {
                        <a id="cmdDelete" class="dnnSecondaryAction" href="javascript:void(0);" @onclick="this.DeleteAsync" @onclick:preventDefault="true">@this.DeleteCaption</a>
                    }
                    @if (this.AddButtonVisible)
                    {
                        <a id="cmdAdd" class="dnnSecondaryAction" href="javascript:void(0);" @onclick="this.AddAsync" @onclick:preventDefault="true">@this.AddCaption</a>
                    }
                </div>
            </div>
        }
        @if (this.TabRowVisible)
        {
            <div class="urlControlTab dnnClear">
                <span>@this.TabCaption</span>
                <select id="cboTabs" style="@this.ControlWidthStyle" @onchange="this.OnTabSelectedAsync">
                    @foreach (var item in this.tabItems)
                    {
                        <option value="@item.Value" selected="@item.Selected" disabled="@(!item.Enabled)">@item.Text</option>
                    }
                </select>
            </div>
        }
        @if (this.FileRowVisible)
        {
            <div class="urlControlFileRow dnnClear">
                <div class="dnnFormItem">
                    <span class="dnnFormLabel">@this.FolderCaption</span>
                    <div>
                        <select id="cboFolders" style="@this.ControlWidthStyle" @onchange="this.OnFolderChangedAsync">
                            @foreach (var item in this.folderItems)
                            {
                                <option value="@item.Value" selected="@item.Selected">@item.Text</option>
                            }
                        </select>
                        @if (this.StorageLocationTypeVisible)
                        {
                            <img id="imgStorageLocationType" src="@this.StorageLocationTypeImageUrl" alt="" />
                        }
                    </div>
                </div>
                <div class="dnnFormItem">
                    <span class="dnnFormLabel">@this.FileCaption</span>
                    <div>
                        @if (this.FileListVisible)
                        {
                            <select id="cboFiles" style="@this.ControlWidthStyle" @onchange="this.OnFileSelectedAsync">
                                @foreach (var item in this.fileItems)
                                {
                                    <option value="@item.Value" selected="@item.Selected">@item.Text</option>
                                }
                            </select>
                        }
                        @if (this.FileUploadVisible)
                        {
                            <InputFile id="txtFile" OnChange="@this.OnFileSelectedForUpload" />
                        }
                    </div>
                </div>
                <div class="dnnFormItem">
                    @if (this.UploadButtonVisible)
                    {
                        <a id="cmdUpload" class="dnnSecondaryAction" href="javascript:void(0);" @onclick="this.UploadAsync" @onclick:preventDefault="true">@this.UploadCaption</a>
                    }
                    @if (this.SaveButtonVisible)
                    {
                        <a id="cmdSave" class="dnnSecondaryAction" href="javascript:void(0);" @onclick="this.SaveAsync" @onclick:preventDefault="true">@this.SaveCaption</a>
                    }
                    @if (this.CancelButtonVisible)
                    {
                        <a id="cmdCancel" class="dnnSecondaryAction" href="javascript:void(0);" @onclick="this.CancelAsync" @onclick:preventDefault="true">@this.CancelCaption</a>
                    }
                </div>
            </div>
        }
        @if (this.ImagesRowVisible)
        {
            <div class="dnnFormItem urlControlImagesRow dnnClear">
                <span class="dnnFormLabel">@this.ImageCaption</span>
                <select id="cboImages" style="@this.ControlWidthStyle" @onchange="this.OnImageSelectedAsync">
                    @foreach (var item in this.imageItems)
                    {
                        <option value="@item.Value" selected="@item.Selected">@item.Text</option>
                    }
                </select>
            </div>
        }
        @if (this.UserRowVisible)
        {
            <div class="urlControlUseRow dnnClear">
                <span>@this.UserCaption</span>
                <input id="txtUser" type="text" style="@this.ControlWidthStyle" value="@this.userText" @onchange="this.OnUserTextChangedAsync" />
            </div>
        }
        @if (this.ErrorRowVisible)
        {
            <div class="dnnFormMessage">
                <span id="lblMessage" class="dnnFormError">@((MarkupString)(this.Message ?? string.Empty))</span>
            </div>
        }
        <div class="dnnClear">
            @if (this.ShowTrack)
            {
                <label>
                    <input type="checkbox" id="chkTrack" checked="@this.trackChecked" @onchange="this.OnTrackChanged" />
                    @this.TrackCaption
                </label>
                <br />
            }
            @if (this.ShowLog)
            {
                <label>
                    <input type="checkbox" id="chkLog" checked="@this.logChecked" @onchange="this.OnLogChanged" />
                    @this.LogCaption
                </label>
                <br />
            }
            @if (this.ShowNewWindow)
            {
                <label>
                    <input type="checkbox" id="chkNewWindow" checked="@this.newWindowChecked" @onchange="this.OnNewWindowChanged" />
                    @this.NewWindowCaption
                </label>
                <br />
            }
        </div>
    </div>
}

