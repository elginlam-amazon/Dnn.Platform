    /// <summary>Localize correctly sets up the control for US/Canada/Other Countries.</summary>
    private void Localize()
    {
        var countryCode = this.SelectedCountryItem?.Value ?? string.Empty;

        // listKey in format "Country.US:Region"
        var listKey = $"Country.{countryCode}";
        var entryCollection = this.ListController.GetListEntryInfoItems("Region", listKey);

        if (entryCollection.Any())
        {
            this.RegionListVisible = true;

            this.regionItems.Clear();
            this.regionItems.Add(new ListItem($"<{Localization.GetString("Not_Specified", Localization.SharedResourceFile)}>", string.Empty));
            foreach (var entry in entryCollection)
            {
                this.regionItems.Add(new ListItem(entry.Text, entry.Value));
            }

            this.ApplyRegionSelection();

            if (countryCode.Equals("us", StringComparison.OrdinalIgnoreCase))
            {
                this.regionListRequired = true;
                this.regionTextRequired = false;
                this.regionRequiredMessage = Localization.GetString("StateRequired", this.ResourceFile);
                this.regionLabelText = Localization.GetString("plState", this.ResourceFile);
                this.regionLabelHelpText = Localization.GetString("plState.Help", this.ResourceFile);
                this.postalLabelText = Localization.GetString("plZip", this.ResourceFile);
                this.postalLabelHelpText = Localization.GetString("plZip.Help", this.ResourceFile);
            }
            else
            {
                this.regionRequiredMessage = Localization.GetString("ProvinceRequired", this.ResourceFile);
                this.regionLabelText = Localization.GetString("plProvince", this.ResourceFile);
                this.regionLabelHelpText = Localization.GetString("plProvince.Help", this.ResourceFile);
                this.postalLabelText = Localization.GetString("plPostal", this.ResourceFile);
                this.postalLabelHelpText = Localization.GetString("plPostal.Help", this.ResourceFile);
            }

            this.regionListRequired = true;
            this.regionTextRequired = false;
        }
        else
        {
            this.selectedRegionValue = null;
            this.regionItems.ClearSelection();
            this.RegionListVisible = false;
            this.regionListRequired = false;
            this.regionTextRequired = true;
            this.regionRequiredMessage = Localization.GetString("RegionRequired", this.ResourceFile);
            this.regionLabelText = Localization.GetString("plRegion", this.ResourceFile);
            this.regionLabelHelpText = Localization.GetString("plRegion.Help", this.ResourceFile);
            this.postalLabelText = Localization.GetString("plPostal", this.ResourceFile);
            this.postalLabelHelpText = Localization.GetString("plPostal.Help", this.ResourceFile);
        }

        var reqRegion = DotNetNuke.Entities.Portals.PortalController.GetPortalSettingAsBoolean(this.PortalController, "addressregion", this.PortalSettings.PortalId, true);
        if (reqRegion)
        {
            this.regionListRequired = false;
            this.regionTextRequired = false;
        }
    }

    /// <summary>ShowRequiredFields sets up displaying which fields are required.</summary>
    private void ShowRequiredFields()
    {
        var reqStreet = DotNetNuke.Entities.Portals.PortalController.GetPortalSettingAsBoolean(this.PortalController, "addressstreet", this.PortalSettings.PortalId, true);
        var reqCity = DotNetNuke.Entities.Portals.PortalController.GetPortalSettingAsBoolean(this.PortalController, "addresscity", this.PortalSettings.PortalId, true);
        var reqCountry = DotNetNuke.Entities.Portals.PortalController.GetPortalSettingAsBoolean(this.PortalController, "addresscountry", this.PortalSettings.PortalId, true);
        var reqRegion = DotNetNuke.Entities.Portals.PortalController.GetPortalSettingAsBoolean(this.PortalController, "addressregion", this.PortalSettings.PortalId, true);
        var reqPostal = DotNetNuke.Entities.Portals.PortalController.GetPortalSettingAsBoolean(this.PortalController, "addresspostal", this.PortalSettings.PortalId, true);
        var reqTelephone = DotNetNuke.Entities.Portals.PortalController.GetPortalSettingAsBoolean(this.PortalController, "addresstelephone", this.PortalSettings.PortalId, true);
        var reqCell = DotNetNuke.Entities.Portals.PortalController.GetPortalSettingAsBoolean(this.PortalController, "addresscell", this.PortalSettings.PortalId, true);
        var reqFax = DotNetNuke.Entities.Portals.PortalController.GetPortalSettingAsBoolean(this.PortalController, "addressfax", this.PortalSettings.PortalId, true);

        if (!this.ShowRequiredCheckBoxes)
        {
            return;
        }

        if (reqCountry)
        {
            this.chkCountryChecked = true;
            this.countryRequired = true;
            this.countryCssClass = "dnnFormRequired";
        }
        else
        {
            this.countryRequired = false;
            this.countryCssClass = string.Empty;
        }

        if (reqRegion)
        {
            this.chkRegionChecked = true;
            this.regionTextCssClass = "dnnFormRequired";
            this.regionListCssClass = "dnnFormRequired";

            if (this.RegionListVisible)
            {
                this.regionListRequired = true;
                this.regionTextRequired = false;
            }
            else
            {
                this.regionListRequired = false;
                this.regionTextRequired = true;
            }
        }
        else
        {
            this.regionListRequired = false;
            this.regionTextRequired = false;
            this.regionTextCssClass = string.Empty;
            this.regionListCssClass = string.Empty;
        }

        if (reqCity)
        {
            this.chkCityChecked = true;
            this.cityRequired = true;
            this.cityCssClass = "dnnFormRequired";
        }
        else
        {
            this.cityRequired = false;
            this.cityCssClass = string.Empty;
        }

        if (reqStreet)
        {
            this.chkStreetChecked = true;
            this.streetRequired = true;
            this.streetCssClass = "dnnFormRequired";
        }
        else
        {
            this.streetRequired = false;
            this.streetCssClass = string.Empty;
        }

        if (reqPostal)
        {
            this.chkPostalChecked = true;
            this.postalRequired = true;
            this.postalCssClass = "dnnFormRequired";
        }
        else
        {
            this.postalRequired = false;
            this.postalCssClass = string.Empty;
        }

        if (reqTelephone)
        {
            this.chkTelephoneChecked = true;
            this.telephoneRequired = true;
            this.telephoneCssClass = "dnnFormRequired";
        }
        else
        {
            this.telephoneRequired = false;
            this.telephoneCssClass = string.Empty;
        }

        if (reqCell)
        {
            this.chkCellChecked = true;
            this.cellRequired = true;
            this.cellCssClass = "dnnFormRequired";
        }
        else
        {
            this.cellRequired = false;
            this.cellCssClass = string.Empty;
        }

        if (reqFax)
        {
            this.chkFaxChecked = true;
            this.faxRequired = true;
            this.faxCssClass = "dnnFormRequired";
        }
        else
        {
            this.faxRequired = false;
            this.faxCssClass = string.Empty;
        }
    }

    /// <summary>UpdateRequiredFields updates which fields are required.</summary>
    /// <returns>A task representing the operation.</returns>
    private Task UpdateRequiredFieldsAsync()
    {
        try
        {
            if (!this.chkCountryChecked)
            {
                this.chkRegionChecked = false;
            }

            DotNetNuke.Entities.Portals.PortalController.UpdatePortalSetting(this.PortalController, this.PortalSettings.PortalId, "addressstreet", this.chkStreetChecked ? string.Empty : "N");
            DotNetNuke.Entities.Portals.PortalController.UpdatePortalSetting(this.PortalController, this.PortalSettings.PortalId, "addresscity", this.chkCityChecked ? string.Empty : "N");
            DotNetNuke.Entities.Portals.PortalController.UpdatePortalSetting(this.PortalController, this.PortalSettings.PortalId, "addresscountry", this.chkCountryChecked ? string.Empty : "N");
            DotNetNuke.Entities.Portals.PortalController.UpdatePortalSetting(this.PortalController, this.PortalSettings.PortalId, "addressregion", this.chkRegionChecked ? string.Empty : "N");
            DotNetNuke.Entities.Portals.PortalController.UpdatePortalSetting(this.PortalController, this.PortalSettings.PortalId, "addresspostal", this.chkPostalChecked ? string.Empty : "N");
            DotNetNuke.Entities.Portals.PortalController.UpdatePortalSetting(this.PortalController, this.PortalSettings.PortalId, "addresstelephone", this.chkTelephoneChecked ? string.Empty : "N");
            DotNetNuke.Entities.Portals.PortalController.UpdatePortalSetting(this.PortalController, this.PortalSettings.PortalId, "addresscell", this.chkCellChecked ? string.Empty : "N");
            DotNetNuke.Entities.Portals.PortalController.UpdatePortalSetting(this.PortalController, this.PortalSettings.PortalId, "addressfax", this.chkFaxChecked ? string.Empty : "N");

            this.ShowRequiredFields();
        }
        catch (Exception exc)
        {
            this.errorMessage = UserControlExceptionHandler.Process(exc);
        }

        return Task.CompletedTask;
    }
