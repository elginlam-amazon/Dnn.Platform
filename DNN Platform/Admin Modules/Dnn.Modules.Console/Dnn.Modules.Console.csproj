<Project Sdk="Microsoft.NET.Sdk.Razor">

  <PropertyGroup>
    <!-- Module.build's CopyBin copies from bin\ directly, so no TFM subfolder. -->
    <OutputPath>bin</OutputPath>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    <TargetFramework>net10.0</TargetFramework>
    <OutputType>Library</OutputType>
    <RootNamespace>Dnn.Modules.Console</RootNamespace>
    <AssemblyName>Dnn.Modules.Console</AssemblyName>
    <Deterministic>true</Deterministic>
    <LangVersion>latest</LangVersion>
    <Nullable>disable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <EnableNETAnalyzers>true</EnableNETAnalyzers>
    <AnalysisLevel>latest</AnalysisLevel>
    <AnalysisMode>Recommended</AnalysisMode>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <!-- Retargeting net48 -> net10.0 newly enables net10-era analyzer diagnostics that the net48
         build never saw. Each id below is one this project's build actually reports, in logic this
         migration carried over verbatim rather than authored, and keeping it an error would mean
         rewriting that logic - which is exactly what must not change. This follows the convention
         set by the already migrated DotNetNuke.Modules.Journal, .Groups, .HTML and .CoreMessaging.
         Compiler diagnostics (CS*) deliberately remain errors.
           CA1305 - the ported GetHtml / settings logic formats and converts without an explicit
                    IFormatProvider (string.Format, Convert.To*), as the WebForms code did;
                    changing the provider would change the rendered and stored values.
           CA1859 - the tab walks keep the original IList<TabInfo> / IList<string> locals and
                    fields rather than concrete types.
           CA1307 - tab.TabPath.Replace("//", "-") and the icon path Replace, carried over as-is;
                    the TabVisibility setting keys must stay byte-identical to the stored ones.
           CA1847 - iconURL.Contains("~", StringComparison.Ordinal), carried over as-is.
           CA2201 - UpdateSettings throws the base Exception with the original
                    "ConsoleWidth value is invalid" message, which the settings host surfaces.
           SA1201 - the member order of the two ported controls is kept as the code behind had it.
    -->
    <WarningsNotAsErrors>CA1305,CA1307,CA1847,CA1859,CA2201,SA1201</WarningsNotAsErrors>
    <!-- Replaces the two per-configuration <DocumentationFile>bin\Dnn.Modules.Console.XML</DocumentationFile>
         entries; emits bin/Dnn.Modules.Console.xml, which Module.build's CopyBin copies. -->
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <!-- SolutionInfo.cs (linked below) carries the assembly attributes, as it did on net48
         (Properties/AssemblyInfo.cs is deleted). -->
    <GenerateAssemblyInfo>false</GenerateAssemblyInfo>
    <!-- This is a Blazor component library, not an MVC view assembly. -->
    <AddRazorSupportForMvc>false</AddRazorSupportForMvc>
  </PropertyGroup>

  <!-- The two original configurations are preserved. -->
  <PropertyGroup Condition=" '$(Configuration)' == 'Debug' ">
    <DebugSymbols>true</DebugSymbols>
    <DebugType>full</DebugType>
    <Optimize>false</Optimize>
    <DefineConstants>DEBUG;TRACE</DefineConstants>
  </PropertyGroup>
  <PropertyGroup Condition=" '$(Configuration)' == 'Release' ">
    <DebugType>pdbonly</DebugType>
    <Optimize>true</Optimize>
    <DefineConstants>TRACE</DefineConstants>
  </PropertyGroup>

  <!-- DNN packaging properties consumed by Module.build / Package.targets. -->
  <PropertyGroup>
    <Extension>zip</Extension>
    <DNNFileName>dnn_Console</DNNFileName>
    <PackageName>DNNCE_Console</PackageName>
    <BuildScriptsPath>$(MSBuildProjectDirectory)\..\..\..\Build\BuildScripts</BuildScriptsPath>
  </PropertyGroup>

  <ItemGroup>
    <!-- The converted Blazor components need Microsoft.AspNetCore.Components and
         Microsoft.AspNetCore.Http types; this replaces the 16 GAC System.* references
         (System.Web, System.Web.Services, System.Web.Extensions, System.Drawing,
         System.Configuration, System.EnterpriseServices, ...). -->
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\..\DotNetNuke.Internal.SourceGenerators\DotNetNuke.Internal.SourceGenerators.csproj" ReferenceOutputAssembly="false" OutputItemType="Analyzer" />
    <ProjectReference Include="..\..\DotNetNuke.Abstractions\DotNetNuke.Abstractions.csproj" />
    <ProjectReference Include="..\..\DotNetNuke.Instrumentation\DotNetNuke.Instrumentation.csproj" />
    <ProjectReference Include="..\..\DotNetNuke.Web.Client\DotNetNuke.Web.Client.csproj" />
    <ProjectReference Include="..\..\DotNetNuke.Web\DotNetNuke.Web.csproj" />
    <ProjectReference Include="..\..\Library\DotNetNuke.Library.csproj" />
  </ItemGroup>

  <ItemGroup>
    <AdditionalFiles Include="..\..\..\stylecop.json" Link="stylecop.json" />
    <Compile Include="..\..\..\SolutionInfo.cs" Link="SolutionInfo.cs" />
  </ItemGroup>

  <!-- Resources/ViewConsole.resx and Resources/Settings.resx are the migrated
       App_LocalResources files (moved with `git mv`, bytes unchanged). Module.build still
       packages them into the extension's App_LocalResources folder as ViewConsole.resx /
       Settings.resx, which is the name PortalModuleBase.LocalResourceFile now derives from the
       component type name at the runtime path
       ~/DesktopModules/Admin/Console/App_LocalResources/<name>.resx - so the components'
       LocalizeText / Localization.GetString calls resolve the same keys the WebForms controls
       did, including portal-level and language-pack overrides, which only the deployed files
       provide. The SDK's default EmbeddedResource glob also compiles them into the assembly,
       which makes the shipped English text self-contained. -->

  <ItemGroup>
    <!-- App_LocalResources\ is a build-time staging folder generated by Module.build's
         UpdateFiles target from Resources\*.resx (see the comment above); the real,
         source-controlled files live in Resources\ and are embedded from there. -->
    <EmbeddedResource Remove="App_LocalResources\**" />
    <None Remove="App_LocalResources\**" />
    <Content Remove="App_LocalResources\**" />
  </ItemGroup>

  <ItemGroup>
    <!-- DNN extension package content (see BuildScripts\Module.build's GetFiles). -->
    <None Include="dnn_Console.dnn" />
    <None Include="license.txt" />
    <None Include="releaseNotes.txt" />
    <None Include="module.css" />
    <Content Include="Module.build" />
    <Content Include="08.00.00.txt" />
    <Content Include="console.png" />
    <Content Include="Scripts\jquery.console.js" />
    <!-- The JS interop module that replaces ViewConsole.ascx's inline <script> block; it must
         ship next to jquery.console.js so the component's module import URL resolves in the
         installed module folder. -->
    <Content Include="Scripts\consoleInterop.js" />
  </ItemGroup>

  <Import Project="Module.build" />
</Project>
