<Project Sdk="Microsoft.NET.Sdk.Razor">

  <PropertyGroup>
    <!-- The net48 project wrote straight to bin\ and Provider.build copies the assembly from
         there, so the framework sub-folder is suppressed to keep that layout. -->
    <OutputPath>bin</OutputPath>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>DotNetNuke.Authentication.LiveConnect</RootNamespace>
    <AssemblyName>DotNetNuke.Authentication.LiveConnect</AssemblyName>
    <Deterministic>true</Deterministic>
    <LangVersion>latest</LangVersion>
    <Nullable>disable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <EnableNETAnalyzers>true</EnableNETAnalyzers>
    <AnalysisLevel>latest</AnalysisLevel>
    <AnalysisMode>Recommended</AnalysisMode>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <WarningsNotAsErrors>SA1600,CA1305</WarningsNotAsErrors>
    <!-- CA1305 is reported only in PRE-EXISTING code this migration did not change: the
         untouched Convert.ToInt32(tokenDictionary["expires_in"]) /
         Convert.ToString(tokenDictionary["access_token"]) calls in
         Components/LiveClient.cs GetExpiry/GetToken. Retargeting net48 -> net10.0 newly
         enables this analyzer wave; adding a format provider there would be a behavioral edit
         to the OAuth token parsing path, which this migration must preserve byte-for-byte, so
         it is recorded as follow-up code-quality debt instead. This matches the convention
         already set by the migrated DotNetNuke.Library and the sibling Facebook, Google and
         Twitter authentication providers. Compiler diagnostics (CS*) deliberately remain
         errors. -->
    <!-- Replaces the per-configuration <DocumentationFile>bin\...XML</DocumentationFile>; the
         generated file is bin/DotNetNuke.Authentication.LiveConnect.xml, which is what
         Provider.build copies to the website. -->
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <!-- SolutionInfo.cs (linked below) carries the company/product/copyright/trademark/version
         attributes, as it did on net48. The remaining four attributes the moved
         Properties/AssemblyInfo.cs declared (title, description, ComVisible and the original
         typelib Guid) are preserved in AssemblyInfo.cs in this folder. -->
    <GenerateAssemblyInfo>false</GenerateAssemblyInfo>
    <!-- This is a Razor Class Library of Blazor components, not an MVC view assembly. -->
    <AddRazorSupportForMvc>false</AddRazorSupportForMvc>
  </PropertyGroup>

  <PropertyGroup Condition=" '$(Configuration)' == 'Debug' ">
    <DebugSymbols>true</DebugSymbols>
    <DebugType>full</DebugType>
    <Optimize>false</Optimize>
    <DefineConstants>DEBUG;TRACE</DefineConstants>
  </PropertyGroup>
  <PropertyGroup Condition=" '$(Configuration)' == 'Release' ">
    <DebugType>pdbonly</DebugType>
    <Optimize>true</Optimize>
    <DefineConstants>TRACE</DefineConstants>
  </PropertyGroup>

  <ItemGroup>
    <!-- Login.razor and Settings.razor take their Microsoft.AspNetCore.Components types from
         the shared framework. -->
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\..\Library\DotNetNuke.Library.csproj" Private="false" />
  </ItemGroup>

  <ItemGroup>
    <AdditionalFiles Include="..\..\..\..\stylecop.json" Link="stylecop.json" />
    <Compile Include="..\..\..\..\SolutionInfo.cs" Link="SolutionInfo.cs" />
  </ItemGroup>

  <!-- Resources/Login.resx and Resources/Settings.resx are the migrated App_LocalResources
       files. Provider.build packages them into the extension's App_LocalResources folder as
       Login.resx / Settings.resx, which is the name PortalModuleBase.LocalResourceFile now
       derives from the component type name, so the components' LocalizeText calls resolve the
       same keys as the WebForms LocalizeString calls did - including portal-level and
       language-pack overrides, which only the deployed files provide. The SDK's default
       EmbeddedResource glob also compiles them into the assembly, which makes the shipped
       English text self-contained. -->

  <ItemGroup>
    <!-- DNN extension package content (see Provider.build). -->
    <Content Include="Images\live_16X16.jpg" />
    <Content Include="Images\live_32X32.jpg" />
    <Content Include="license.txt" />
    <Content Include="releasenotes.txt" />
    <Content Include="Provider.build" />
    <None Include="Live_Auth.dnn" />
  </ItemGroup>

  <Import Project="Provider.build" />
</Project>
