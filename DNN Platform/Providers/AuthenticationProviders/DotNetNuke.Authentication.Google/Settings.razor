@namespace DotNetNuke.Authentication.Google
@inherits DotNetNuke.Services.Authentication.OAuth.OAuthSettingsBase
@using System
@using DotNetNuke.Services.Authentication.OAuth
@using DotNetNuke.UI.WebControls

@* Replaces <dnn:propertyeditorcontrol id="SettingsEditor" runat="Server" ... />. The editor
   instance is the one held by OAuthSettingsBase, so the base class keeps driving it: it sets
   DataSource/DataBind during OnLoad and reads IsValid/IsDirty from it in UpdateSettings, which
   is what persists the Google API key and secret. *@
@this.SettingsEditor.Render()

@code {
    /// <inheritdoc />
    protected override string AuthSystemApplicationName
    {
        get { return "Google"; }
    }

    /// <inheritdoc />
    /// <remarks>
    /// Creates the property editor that the <c>.ascx</c> markup used to declare, with the same
    /// settings, before <see cref="OAuthSettingsBase"/>'s <c>OnLoad</c> binds it to the
    /// provider's configuration.
    /// </remarks>
    protected override void OnInit(EventArgs e)
    {
        base.OnInit(e);

        // BL0005 warns that parameters set from outside a component are overwritten on the next
        // parameter set. That cannot happen here: this editor is created in code and rendered
        // through its own Render() fragment below, never as a child component whose parent
        // supplies parameters — which is exactly how OAuthSettingsBase has always owned it.
#pragma warning disable BL0005
        this.SettingsEditor = new PropertyEditorControl(this.ServiceProvider)
        {
            ID = "SettingsEditor",
            EditMode = PropertyEditorMode.Edit,
            SortMode = PropertySortType.SortOrderAttribute,
        };
#pragma warning restore BL0005
        this.SettingsEditor.HelpStyle.CssClass = "dnnFormHelpContent dnnClear";
        this.SettingsEditor.LabelStyle.CssClass = "SubHead";
    }

    [Microsoft.AspNetCore.Components.Inject]
    private IServiceProvider ServiceProvider { get; set; }
}
