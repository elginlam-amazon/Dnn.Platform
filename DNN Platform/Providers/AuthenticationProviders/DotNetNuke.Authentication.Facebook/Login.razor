@namespace DotNetNuke.Authentication.Facebook
@inherits DotNetNuke.Services.Authentication.OAuth.OAuthLoginBase
@using System
@using System.Collections.Specialized
@using System.Threading.Tasks
@using DotNetNuke.Authentication.Facebook.Components
@using DotNetNuke.Services.Authentication
@using DotNetNuke.Services.Authentication.OAuth
@using DotNetNuke.Services.Localization
@using DotNetNuke.UI.Skins.Controls

@* The two <li> items replace the runat="server" HtmlGenericControls; their Visible flags are
   now conditional rendering.

   The LinkButtons became ordinary links to Facebook's authorization endpoint. On WebForms the
   click was a postback whose handler called OAuthClient.Authorize(), and that answered with an
   HTTP redirect to exactly this URL; a Blazor event handler cannot redirect, because there is no
   HTTP response left to redirect once the circuit is interactive. Letting the browser navigate
   there directly produces the same user-visible result. The original LinkButtons had
   CausesValidation="False", and these links likewise take part in no form or validation. *@
@if (this.Mode == AuthMode.Login)
{
    <li id="loginItem" class="facebook">
        <a id="loginButton" href="@this.authorizeUrl">
            <span>@this.LocalizeText("LoginFacebook")</span>
        </a>
    </li>
}
@if (this.Mode == AuthMode.Register)
{
    <li id="registerItem" class="facebook">
        <a id="registerButton" href="@this.authorizeUrl">
            <span>@this.LocalizeText("RegisterFacebook")</span>
        </a>
    </li>
}

@code {
    /// <summary>
    /// The user data fetched by <see cref="GetCurrentUserAsync"/>, kept so that
    /// <see cref="AddCustomProperties"/> — which the base class invokes synchronously, right
    /// after it awaited <see cref="GetCurrentUserAsync"/> — can read the Facebook specific
    /// members without blocking on an asynchronous call.
    /// </summary>
    private FacebookUserData facebookUserData;

    /// <summary>Facebook's authorization URL, resolved while the HTTP request is still in flight.</summary>
    private string authorizeUrl;

    /// <inheritdoc />
    public override bool SupportsRegistration
    {
        get { return true; }
    }

    /// <inheritdoc />
    protected override string AuthSystemApplicationName
    {
        get { return "Facebook"; }
    }

    /// <inheritdoc />
    protected override async Task<UserData> GetCurrentUserAsync()
    {
        this.facebookUserData = await this.OAuthClient.GetCurrentUserAsync<FacebookUserData>();
        return this.facebookUserData;
    }

    /// <inheritdoc />
    /// <remarks>
    /// Replaces <c>OnInit</c>. The client must exist before the base class runs, because the base
    /// uses it to decide whether this request is the OAuth callback and, if so, performs the
    /// authorization round-trip.
    /// </remarks>
    protected override async Task OnInitializedAsync()
    {
        this.OAuthClient = new FacebookClient(this.PortalId, this.Mode);

        await base.OnInitializedAsync();

        // Everything below needs the HTTP request, which only exists during this initial
        // (static) render — never in an event handler.
        this.authorizeUrl = this.OAuthClient.GetAuthorizationUrl();
        this.ReportAuthorizationDenied();
    }

    /// <inheritdoc />
    protected override void AddCustomProperties(NameValueCollection properties)
    {
        base.AddCustomProperties(properties);

        var userData = this.facebookUserData;
        if (userData?.Link != null)
        {
            properties.Add("Facebook", userData.Link.ToString());
        }
    }

    /// <summary>
    /// Shows the warning that the WebForms <c>LoginButton_Click</c> handler showed when
    /// <c>OAuthClient.Authorize()</c> returned <see cref="AuthorisationResult.Denied"/>.
    /// </summary>
    /// <remarks>
    /// Facebook reports a declined permission dialog by sending the user back to the callback
    /// URL with an <c>error_reason</c>, which is the request value <c>Authorize()</c> inspected
    /// to produce <see cref="AuthorisationResult.Denied"/>. That request is this render, so the
    /// check belongs here: the query string is not readable from an interactive event handler,
    /// and the user must not be authenticated — note that no authentication is performed on this
    /// path, the base class only authenticates when authorization actually succeeded.
    /// </remarks>
    private void ReportAuthorizationDenied()
    {
        var errorReason = this.Request?.Query["error_reason"].ToString();
        if (string.IsNullOrEmpty(errorReason) || !this.OAuthClient.IsCurrentService())
        {
            return;
        }

        UI.Skins.Skin.AddModuleMessage(
            this,
            Localization.GetString("PrivateConfirmationMessage", Localization.SharedResourceFile),
            ModuleMessage.ModuleMessageType.YellowWarning);
    }
}
