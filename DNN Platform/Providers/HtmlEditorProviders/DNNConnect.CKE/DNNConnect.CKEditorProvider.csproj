<Project Sdk="Microsoft.NET.Sdk.Razor">

  <PropertyGroup>
    <!-- The net48 project wrote straight to bin\ and Provider.build copies the assembly from
         there, so the framework sub-folder is suppressed to keep that layout. -->
    <OutputPath>bin</OutputPath>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    <TargetFramework>net10.0</TargetFramework>
    <OutputType>Library</OutputType>
    <RootNamespace>DNNConnect.CKEditorProvider</RootNamespace>
    <AssemblyName>DNNConnect.CKEditorProvider</AssemblyName>
    <Deterministic>true</Deterministic>
    <LangVersion>latest</LangVersion>
    <Nullable>disable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <EnableNETAnalyzers>true</EnableNETAnalyzers>
    <AnalysisLevel>latest</AnalysisLevel>
    <AnalysisMode>Recommended</AnalysisMode>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <!-- SA1600 was already excluded on net48 (undocumented members in pre-existing code, e.g.
         Objects\EditorConfig.cs).

         CULTURE / COMPARISON FAMILY — CA1304, CA1305, CA1307, CA1309, CA1310, CA1311, CA1862,
         CA1865, CA1866, CA1847. Reported only in code this migration ports verbatim: the
         culture-less string.Format / ToString / IndexOf / StartsWith / EndsWith / Contains /
         ToLower / Equals calls that run throughout Utilities\SettingsUtil.cs (e.g. 1586),
         Utilities\ToolbarUtil.cs (e.g. 64), Utilities\Utility.cs (84, 366),
         Objects\EditorConfig.cs, Web\EditorControl.razor.cs (e.g. 1539) and
         Browser\Browser.razor*.cs (e.g. 1098, 1207, 1248). Retargeting net48 -> net10.0 newly
         enables this analyzer wave; adding format providers or switching to ordinal / char
         overloads there would change the comparison semantics of the settings, toolbar and file
         name parsing this migration must preserve, so it is recorded as follow-up code-quality
         debt - the same convention as the already-migrated DotNetNuke.Authentication.Twitter and
         DotNetNuke.Library.

         CA1707 (identifiers contain underscores) — the ~85 reports are the CKEditor configuration
         properties of Objects\EditorConfig.cs (Magicline_Color, Menu_Groups, Resize_Enabled, ...)
         and the ported WebForms event handler names. Those property names ARE the serialized
         setting / CKEditor config keys that round-trip through host, portal, page and module
         settings and through Install\Dnn.CKEditorDefaultSettings.xml, so renaming them would
         silently drop every stored setting.

         CA1822 / CA1859 (member can be static / use a more derived type) — pure micro-optimization
         suggestions on members whose signatures deliberately mirror the originals, e.g.
         Browser\Browser.razor.cs 393 (ResXFile), 1747 (RenderFolder), 1782 (FindNodeByValue),
         Browser\Browser.razor.Editing.cs 243 (ResizeJpegImage), Utilities\ToolbarUtil.cs 33/965.
         Making them static would force every `this.`-qualified call site in the 3000-line page
         partials to change for no behavioural gain.

         SA1201 / SA1204 (member ordering) — Web\EditorControl.razor.cs 742/1015/1107/1450,
         CKEditorOptions.Bind.cs 245 and Browser\Browser.razor.Editing.cs 1552. These are the
         ported method bodies of the 1343-line control and the 3019-line page, kept in the order of
         the originals so the port stays reviewable against them; the same StyleCop family as the
         already-excluded SA1600.

         Compiler diagnostics (CS*) deliberately remain errors. -->
    <!-- BL0005: CKEditorOptions.razor.cs assigns PortalModuleBase.ModuleConfiguration on
         the control it loads. That property is now a Blazor parameter - which is what makes the
         configuration survive the renderer instantiating the control by its type - so assigning
         it from outside the component reports BL0005. The already migrated Groups, CoreMessaging
         and RazorHost modules list the id for the same reason. -->
    <WarningsNotAsErrors>BL0005,SA1600,SA1201,SA1204,CA1305,CA1304,CA1307,CA1309,CA1310,CA1311,CA1862,CA1865,CA1866,CA1847,CA1707,CA1822,CA1859</WarningsNotAsErrors>
    <!-- Replaces the per-configuration <DocumentationFile>bin\...xml</DocumentationFile>; the
         generated file is bin/DNNConnect.CKEditorProvider.xml, which is what Provider.build
         copies to the website. (The Release config used to emit the stale name
         bin\WatchersNET.CKEditor.xml, which Provider.build never copied.) -->
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <!-- SolutionInfo.cs (linked below) carries the shared assembly attributes, as it did on
         net48; AssemblyInfo.cs keeps this project's own title/description. -->
    <GenerateAssemblyInfo>false</GenerateAssemblyInfo>
    <!-- This is a Razor Class Library of Blazor components, not an MVC view assembly. -->
    <AddRazorSupportForMvc>false</AddRazorSupportForMvc>
  </PropertyGroup>

  <PropertyGroup Condition=" '$(Configuration)' == 'Debug' ">
    <DebugSymbols>true</DebugSymbols>
    <DebugType>full</DebugType>
    <Optimize>false</Optimize>
    <DefineConstants>DEBUG;TRACE</DefineConstants>
  </PropertyGroup>
  <PropertyGroup Condition=" '$(Configuration)' == 'Release' ">
    <DebugType>pdbonly</DebugType>
    <Optimize>true</Optimize>
    <DefineConstants>TRACE</DefineConstants>
  </PropertyGroup>

  <ItemGroup>
    <!-- The Blazor components and the minimal-API endpoints that replace the .aspx/.ascx/.ashx
         surface take their Microsoft.AspNetCore.* types from the shared framework. -->
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>

  <ItemGroup>
    <!-- Replaces System.Drawing (Windows-only on modern .NET) in the image resize/rotate/crop
         pipelines of the file browser: Browser\ProcessImageEndpoint.cs and
         Browser\FileUploaderEndpoint.cs. Same version as DotNetNuke.Library uses. -->
    <PackageReference Include="SixLabors.ImageSharp" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\..\..\DotNetNuke.Internal.SourceGenerators\DotNetNuke.Internal.SourceGenerators.csproj" ReferenceOutputAssembly="false" OutputItemType="Analyzer" />
    <ProjectReference Include="..\..\..\DotNetNuke.Abstractions\DotNetNuke.Abstractions.csproj" Private="false" />
    <ProjectReference Include="..\..\..\DotNetNuke.Web.Client\DotNetNuke.Web.Client.csproj" Private="false" />
    <ProjectReference Include="..\..\..\DotNetNuke.WebUtility\DotNetNuke.WebUtility.csproj" Private="false" />
    <ProjectReference Include="..\..\..\DotNetNuke.Web\DotNetNuke.Web.csproj" Private="false" />
    <ProjectReference Include="..\..\..\Library\DotNetNuke.Library.csproj" Private="false" />
  </ItemGroup>

  <ItemGroup>
    <AdditionalFiles Include="..\..\..\..\stylecop.json" Link="stylecop.json" />
    <Compile Include="..\..\..\..\SolutionInfo.cs" Link="SolutionInfo.cs" />
    <CodeAnalysisDictionary Include="CustomDictionary.xml" />
  </ItemGroup>

  <ItemGroup>
    <!-- The portal-overridable localization files, now named after the Blazor components that
         resolve them (Resources\Options.resx, Resources\Browser.resx,
         Resources\EditorConfigManager.resx) as DotNetNuke.Authentication.Twitter does.
         Provider.build packages all of them into the extension's App_LocalResources folder, which
         is where DNN's file-based Localization.GetString / LocalizeText looks and where portal
         overrides and language packs land, so portal-level overrides keep working.
         The neutral .resx files are embedded by the SDK's default glob (self-contained English);
         the culture-specific ones are NOT embedded, because MSBuild would turn them into
         satellite assemblies instead of the loose files DNN reads at runtime. -->
    <EmbeddedResource Remove="Resources\*.??-??.resx" />
    <Content Include="Resources\*.??-??.resx" />
  </ItemGroup>

  <ItemGroup>
    <!-- DNN extension package content (see Provider.build's GetFiles target). -->
    <Content Include="icons\**\*.*" />
    <Content Include="images\**\*.*" />
    <Content Include="css\**\*.css" />
    <Content Include="js\**\*.*" />
    <Content Include="Browser\*.css" />
    <Content Include="Browser\Browser.comb.css.bundle" />
    <Content Include="Browser\js\**\*.js" />
    <Content Include="Browser\images\**\*.*" />
    <Content Include="Install\**\*.*" />
    <Content Include="*.txt" />
    <Content Include="CKEditorConfig.png" />
    <Content Include="LogoCKEditor.png" />
    <Content Include="CustomDictionary.xml" />
    <Content Include="Provider.build" />
    <None Include="DNNConnect.CKEditorProvider.dnn" />
  </ItemGroup>

  <Import Project="Provider.build" />
</Project>
