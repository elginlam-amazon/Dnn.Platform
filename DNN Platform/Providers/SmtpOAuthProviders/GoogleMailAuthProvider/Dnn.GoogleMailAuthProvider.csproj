<Project Sdk="Microsoft.NET.Sdk.Razor">

  <PropertyGroup>
    <!-- The net48 project wrote straight to bin\ and Provider.build copies the assembly from
         there, so the framework sub-folder is suppressed to keep that layout. -->
    <OutputPath>bin</OutputPath>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>Dnn.GoogleMailAuthProvider</RootNamespace>
    <AssemblyName>Dnn.GoogleMailAuthProvider</AssemblyName>
    <Deterministic>true</Deterministic>
    <LangVersion>latest</LangVersion>
    <Nullable>disable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <EnableNETAnalyzers>true</EnableNETAnalyzers>
    <AnalysisLevel>latest</AnalysisLevel>
    <AnalysisMode>Recommended</AnalysisMode>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <!-- Retargeting net48 -> net10.0 newly enables these analyzer waves. Every one of them is
         reported ONLY in code this migration ports verbatim, and this provider handles OAuth
         client secrets and refresh tokens, so they are recorded as follow-up code-quality debt
         rather than "fixed" by editing the credential paths. Same convention as the already
         migrated DotNetNuke.Authentication.Google, DNNConnect.CKEditorProvider and
         DotNetNuke.Library. Compiler diagnostics (CS*) deliberately remain errors.

         CULTURE FAMILY — CA1305, CA1863. The culture-less string.Format calls that build the
         data store setting name (Components/GoogleCredentialDataStore.cs 58, 145, 177, from
         Constants.DataStoreSettingName "gmailauth_{0}_datastore") and the authorize URL
         (Components/GoogleMailOAuthProvider.cs 123, 149, from Constants.CallbackUrl). Those
         formatted strings are PERSISTED setting keys and the redirect_uri registered with
         Google; adding a format provider or a cached CompositeFormat there would change how the
         stored credentials are keyed and what URL is sent to Google.

         CA1725 (parameter name should match the base declaration) —
         Services/ServiceRouteMapper.cs 13: the IServiceRouteMapper.RegisterRoutes parameter is
         named routeManager. It is the original public signature.

         CA1852 (type can be sealed) — Components/Constants.cs 8. Constants is the extension's
         public-by-convention constant holder; sealing it is a binary-compatibility change for
         anything that derived from it.

         CA1853 / CA1854 / CA1861 / CA1859 (redundant Remove guard, prefer TryGetValue, prefer a
         static readonly array, use a more derived return type) — pure micro-optimization
         suggestions on the ported bodies of GoogleCredentialDataStore.DeleteAsync (81),
         GoogleMailOAuthProvider.UpdateHostSettings / UpdatePortalSettings (374, 380, 414, 420),
         the route namespace array (ServiceRouteMapper 19, GoogleMailOAuthProvider 234) and the
         IList<SmtpOAuthSetting> returns of GetSettingsFromPortal / GetSettingsFromHost /
         CreateAuthorizationCodeFlow (210, 240, 312), whose signatures deliberately mirror the
         originals. -->
    <WarningsNotAsErrors>CA1305,CA1725,CA1852,CA1853,CA1854,CA1859,CA1861,CA1863</WarningsNotAsErrors>
    <!-- Replaces the four per-configuration <DocumentationFile>bin\Dnn.GoogleMailAuthProvider.xml
         </DocumentationFile> blocks; the generated file is
         bin/Dnn.GoogleMailAuthProvider.xml, which is what Provider.build's DebugProject target
         copies to the website. -->
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <!-- SolutionInfo.cs (linked below) carries the shared company/product/copyright/version
         attributes, as it did on net48. The two attributes the deleted
         Properties/AssemblyInfo.cs declared (AssemblyTitle and CLSCompliant) are preserved in
         AssemblyInfo.cs in this folder. -->
    <GenerateAssemblyInfo>false</GenerateAssemblyInfo>
    <!-- This is a Razor Class Library of Blazor components (Authorize.razor), not an MVC view
         assembly. -->
    <AddRazorSupportForMvc>false</AddRazorSupportForMvc>
  </PropertyGroup>

  <!-- The solution still defines the Cloud_Debug / Cloud_Release configurations, so their
       DefineConstants are preserved. -->
  <PropertyGroup Condition=" '$(Configuration)' == 'Debug' ">
    <DebugSymbols>true</DebugSymbols>
    <DebugType>full</DebugType>
    <Optimize>false</Optimize>
    <DefineConstants>DEBUG;TRACE</DefineConstants>
  </PropertyGroup>
  <PropertyGroup Condition=" '$(Configuration)' == 'Release' ">
    <DebugType>pdbonly</DebugType>
    <Optimize>true</Optimize>
    <DefineConstants>TRACE</DefineConstants>
  </PropertyGroup>
  <PropertyGroup Condition=" '$(Configuration)' == 'Cloud_Debug' ">
    <DebugSymbols>true</DebugSymbols>
    <DebugType>full</DebugType>
    <Optimize>false</Optimize>
    <DefineConstants>DEBUG;TRACE;CLOUD;CLOUD_DEBUG</DefineConstants>
  </PropertyGroup>
  <PropertyGroup Condition=" '$(Configuration)' == 'Cloud_Release' ">
    <DebugType>pdbonly</DebugType>
    <Optimize>true</Optimize>
    <DefineConstants>TRACE;CLOUD;CLOUD_RELEASE</DefineConstants>
  </PropertyGroup>

  <ItemGroup>
    <!-- Authorize.razor (the component that replaced Authorize.aspx) takes its
         Microsoft.AspNetCore.Components / Microsoft.AspNetCore.Http types from the shared
         framework, as does the DotNetNuke.Web.Api controller base of Services/. -->
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>

  <ItemGroup>
    <!-- Centrally versioned in Directory.Packages.props. -->
    <PackageReference Include="Google.Apis.Auth" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\..\DotNetNuke.Abstractions\DotNetNuke.Abstractions.csproj" Private="false" />
    <ProjectReference Include="..\..\..\DotNetNuke.Web\DotNetNuke.Web.csproj" Private="false" />
    <ProjectReference Include="..\..\..\Library\DotNetNuke.Library.csproj" Private="false" />
  </ItemGroup>

  <ItemGroup>
    <AdditionalFiles Include="..\..\..\..\stylecop.json" Link="stylecop.json" />
    <Compile Include="..\..\..\..\SolutionInfo.cs" Link="SolutionInfo.cs" />
  </ItemGroup>

  <ItemGroup>
    <!-- SharedResources.resx keeps its App_LocalResources path: Constants.LocalResourcesFile
         resolves it at runtime as
         ~/Providers/SmtpOAuthProviders/GoogleMail/App_LocalResources/SharedResources.resx, which
         is where DNN's file-based Localization.GetString looks and where portal-level overrides
         and language packs land. The SDK's default EmbeddedResource glob already picks it up (as
         Dnn.GoogleMailAuthProvider.App_LocalResources.SharedResources, the same manifest name the
         net48 project produced), so it is NOT listed again here - a second item would be a
         duplicate. Provider.build packages the same file into Resources.zip. -->
  </ItemGroup>

  <ItemGroup>
    <!-- DNN extension package content (see Provider.build's GetFiles target). -->
    <None Include="GoogleMailAuthProvider.dnn" />
    <Content Include="license.txt" />
    <Content Include="releaseNotes.txt" />
    <Content Include="Provider.build" />
  </ItemGroup>

  <Import Project="Provider.build" />
</Project>
