<Project Sdk="Microsoft.NET.Sdk.Razor">

  <PropertyGroup>
    <OutputPath>bin/Providers</OutputPath>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>DotNetNuke.Providers.FolderProviders</RootNamespace>
    <AssemblyName>DotNetNuke.Providers.FolderProviders</AssemblyName>
    <Configurations>Debug;Release;Cloud_Debug;Cloud_Release</Configurations>
    <Deterministic>true</Deterministic>
    <LangVersion>latest</LangVersion>
    <Nullable>disable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <EnableNETAnalyzers>true</EnableNETAnalyzers>
    <AnalysisLevel>latest</AnalysisLevel>
    <AnalysisMode>Recommended</AnalysisMode>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <!-- Retargeting net48 -> net10.0 newly enables a wave of net10-era analyzer diagnostics
         that the net48 build never saw. Every id below is reported in PRE-EXISTING code this
         migration did not change (Components/BaseRemoteStorageProvider.cs,
         AzureFolderProvider/Constants.cs and the untouched CheckSettings / GetFileUrl /
         GetObjectList bodies): CA1305/CA1309 culture-aware string.Format and comparisons,
         CA1845/CA1865/CA2249 string performance suggestions, CA1852 sealed-type and CA1862
         ToLowerInvariant suggestions, and CA2201 for the provider's own
         "Settings cannot be found." exception, whose type is part of the behavior the
         migration must preserve. They are follow-up code-quality debt, not migration
         defects, which matches the convention already set by the migrated DotNetNuke.Library
         and DotNetNuke.WebControls. Compiler diagnostics (CS*) deliberately remain errors. -->
    <WarningsNotAsErrors>SA1600,CA1305,CA1309,CA1845,CA1852,CA1862,CA1865,CA2201,CA2249</WarningsNotAsErrors>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <!-- SolutionInfo.cs (linked below) carries the assembly attributes, as it did on net48. -->
    <GenerateAssemblyInfo>false</GenerateAssemblyInfo>
    <!-- This is a Razor Class Library of Blazor components, not an MVC view assembly. -->
    <AddRazorSupportForMvc>false</AddRazorSupportForMvc>
  </PropertyGroup>

  <!-- The four original configurations are preserved, including the CLOUD constants. -->
  <PropertyGroup Condition=" '$(Configuration)' == 'Debug' ">
    <DebugSymbols>true</DebugSymbols>
    <DebugType>full</DebugType>
    <Optimize>false</Optimize>
    <DefineConstants>DEBUG;TRACE</DefineConstants>
  </PropertyGroup>
  <PropertyGroup Condition=" '$(Configuration)' == 'Release' ">
    <DebugType>pdbonly</DebugType>
    <Optimize>true</Optimize>
    <DefineConstants>TRACE</DefineConstants>
  </PropertyGroup>
  <PropertyGroup Condition=" '$(Configuration)' == 'Cloud_Debug' ">
    <DebugSymbols>true</DebugSymbols>
    <DebugType>full</DebugType>
    <Optimize>false</Optimize>
    <DefineConstants>DEBUG;TRACE;CLOUD;CLOUD_DEBUG</DefineConstants>
  </PropertyGroup>
  <PropertyGroup Condition=" '$(Configuration)' == 'Cloud_Release' ">
    <DebugType>pdbonly</DebugType>
    <Optimize>true</Optimize>
    <DefineConstants>TRACE;CLOUD;CLOUD_RELEASE</DefineConstants>
  </PropertyGroup>

  <ItemGroup>
    <!-- Cloud SDK Code Changes: Azure Blob Storage -> Amazon S3. -->
    <PackageReference Include="AWSSDK.S3" />
  </ItemGroup>

  <ItemGroup>
    <!-- The Blazor component (AzureFolderProvider/Settings.razor) takes its
         Microsoft.AspNetCore.Components types from the shared framework. -->
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\DotNetNuke.Abstractions\DotNetNuke.Abstractions.csproj" />
    <ProjectReference Include="..\..\DotNetNuke.Instrumentation\DotNetNuke.Instrumentation.csproj" />
    <ProjectReference Include="..\..\Library\DotNetNuke.Library.csproj" />
  </ItemGroup>

  <ItemGroup>
    <AdditionalFiles Include="..\..\..\stylecop.json" Link="stylecop.json" />
    <Compile Include="..\..\..\SolutionInfo.cs" Link="SolutionInfo.cs" />
  </ItemGroup>

  <!-- Resources/AzureFolderProvider.Settings.resx is picked up by the SDK's default
       EmbeddedResource glob; its logical name resolves to
       DotNetNuke.Providers.FolderProviders.Resources.AzureFolderProvider.Settings, which is what
       IStringLocalizer<Settings> probes for given the ResourcesPath "Resources" that
       DotNetNuke.Library's Startup registers with AddLocalization. -->

  <ItemGroup>
    <!-- DNN extension package content (see Provider.build). -->
    <Content Include="09.02.00.txt" />
    <Content Include="AzureFolderProvider\images\FolderAzure_16x16_Standard.png" />
    <Content Include="AzureFolderProvider\images\FolderAzure_32x32_Standard.png" />
    <Content Include="license.txt" />
    <Content Include="releaseNotes.txt" />
    <Content Include="Provider.build" />
    <None Include="FolderProviders.dnn" />
  </ItemGroup>

  <Import Project="Provider.build" />
</Project>
