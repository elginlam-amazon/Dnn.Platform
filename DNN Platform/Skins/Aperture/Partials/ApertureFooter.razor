@* Declared in the root namespace so the root _Imports.razor resolves this component by tag
   name: a namespace created only by generated Razor components is not visible during the Razor
   declaration pass. *@
@namespace Dnn.Skins.Aperture
@* Ported from partials/_footer.ascx.

   The original markup closed three </div> elements for the two it opened (a pre-existing bug that
   WebForms tolerated because the stray tags were emitted as literal text). Razor rejects unbalanced
   markup, so the intended DOM is restored here: footer > .aperture-container > (.footer-left,
   #FooterPane.footer-right). Every class name, skin object and the FooterPane module injection point
   are preserved. *@

<footer class="aperture-footer">
    <div class="aperture-container">
        <div class="footer-left">
            <div class="footer-menu">
                <FooterMenu CssClass="aperture-d-none aperture-d-md-block" NodeSelector="*,0,0" />
            </div>
            <div class="footer-terms-privacy">
                <ApertureTermsLink CssClass="aperture-terms" /><AperturePrivacyLink />
            </div>
            <div class="footer-copyright">
                <ApertureCopyright />
            </div>
        </div>
        <div id="FooterPane" class="footer-right">
            @this.FooterPane
        </div>
    </div>
</footer>

@code {
    /// <summary>
    /// Gets or sets the content rendered into the footer module pane.
    /// </summary>
    /// <remarks>
    /// Replaces <c>&lt;div id="FooterPane" runat="server" class="footer-right"&gt;</c>. In DNN a pane
    /// is where the framework injects the modules assigned to it, so this must stay a content hole
    /// rather than become a plain <c>div</c>.
    /// </remarks>
    [Parameter]
    public RenderFragment? FooterPane { get; set; }
}
