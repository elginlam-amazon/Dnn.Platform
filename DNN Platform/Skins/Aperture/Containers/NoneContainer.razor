@* Declared in the root namespace so the root _Imports.razor resolves this component by tag
   name: a namespace created only by generated Razor components is not visible during the Razor
   declaration pass. *@
@namespace Dnn.Skins.Aperture
@* Ported from containers/none.ascx (Inherits=DotNetNuke.UI.Containers.Container).

   The entire control was a single bare ContentPane with no chrome, used for modules that supply
   their own framing. The pane is a module injection point, so it stays a content hole. *@

<div id="ContentPane">
    @this.ChildContent
</div>

@code {
    /// <summary>Gets or sets the module content rendered inside the container.</summary>
    /// <remarks>Replaces <c>&lt;div runat="server" id="ContentPane" /&gt;</c>.</remarks>
    [Parameter]
    public RenderFragment? ChildContent { get; set; }
}
