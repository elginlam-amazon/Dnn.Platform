    "ErrorPagePath": "~/ErrorPage"
  },
  "StaticContentGuards": {
    "_PORT_TODO_security": "SECURITY CONTROL. Replaces Portals/Web.config, DesktopModules/MVC/Web.config and Install/Web.config, enforced by Website/Configuration/StaticContentGuardMiddleware (auto-wired through IDnnStartup + IStartupFilter, so it runs ahead of UseStaticFiles). The defaults live in StaticContentGuardOptions.cs; anything listed here is ADDED to them, so a rule can be extended but never silently weakened. Do not add .aspx/.ashx/.asmx/.svc to BlockedExtensions: those are routed endpoints now (Logoff.aspx, RSS.aspx, LinkClick.aspx, DnnImageHandler.ashx, admin/Sales/paypalipn.aspx), not files.",
    "BlockedExtensions": [],
    "BlockedPathSegments": [],
    "NoCachePathPrefixes": []
  },
  "MobileRedirect": {
    "MobileViewSiteCookieName": "dnn_IsMobile",
    "DisableMobileViewSiteCookieName": "dnn_NoMobile"
  },
  "ImageHandler": {
    "Settings": "",
    "Transforms": {}
  },
  "AppSettings": {
    "_PORT_TODO_nodestination": "ValidationSettings:UnobtrusiveValidationMode was a WebForms-only key (it told the ASP.NET validator controls not to emit unobtrusive jQuery validation). WebForms validator controls do not exist on net10.0, so the key has NO destination and is deliberately dropped. Recorded in migration-summary.md.",
    "InstallTemplate": "DotNetNuke.install.config",
    "AutoUpgrade": "true",
    "UseInstallWizard": "true",
    "InstallMemberRole": "true",
    "ShowMissingKeys": "false",
    "EnableCachePersistence": "false",
    "HostHeader": "",
    "RemoveAngleBrackets": "false",
    "PersistentCookieTimeout": "0",
    "EnableServicesFrameworkTracing": "false",
    "UpdateServiceUrl": "https://dnnplatform.io",
    "PreserveLoginUrl": "true",
    "loginUrl": "~/Login.aspx",
    "AllowDnnImagePlaceholderText": "false",
    "AllowDnnUpgradeUpload": "true",
    "DisableCsp": "false"
  },
