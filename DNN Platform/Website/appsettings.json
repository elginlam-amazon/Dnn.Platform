{
  "_PORT_TODO_secrets": "MachineKey:DecryptionKey and MachineKey:ValidationKey are key material and MUST NOT be committed. Set them per environment via `dotnet user-secrets set \"MachineKey:DecryptionKey\" \"...\"`, the MachineKey__DecryptionKey environment variable, or a secrets manager. Do the same for ConnectionStrings:SiteSqlServer whenever it carries a password (User ID=/Password=).",
  "_PORT_TODO_encryption": "Microsoft.Data.SqlClient 4.0+ defaults to Encrypt=Mandatory. TrustServerCertificate=True keeps an existing installation connecting; replace it with Encrypt=True plus a CA-trusted server certificate for production. The same applies to DotNetNuke:data:providers[0]:upgradeConnectionString when it is set (empty means \"reuse SiteSqlServer\").",
  "ConnectionStrings": {
    "SiteSqlServer": "Data Source=.\\SQLExpress;Integrated Security=True;User Instance=True;AttachDBFilename=|DataDirectory|Database.mdf;TrustServerCertificate=True;"
  },
  "MachineKey": {
    "ValidationKey": "<<SECRET>>",
    "DecryptionKey": "<<SECRET>>",
    "Decryption": "AES",
    "Validation": "SHA1"
  },
  "Membership": {
    "ApplicationName": "DotNetNuke",
    "ConnectionStringName": "SiteSqlServer",
    "PasswordFormat": 1,
    "HashAlgorithmType": "SHA256",
    "EnablePasswordRetrieval": false,
    "EnablePasswordReset": true,
    "RequiresQuestionAndAnswer": false,
    "RequiresUniqueEmail": false,
    "MinRequiredPasswordLength": 7,
    "MinRequiredNonAlphanumericCharacters": 0,
    "MaxInvalidPasswordAttempts": 5,
    "PasswordAttemptWindow": 10,
    "PasswordStrengthRegularExpression": "",
    "UserIsOnlineTimeWindow": 15
  },
  "Authentication": {
    "Cookie": {
      "Name": ".DOTNETNUKE",
      "Domain": "",
      "Path": "/",
      "RequireSsl": false,
      "TimeoutMinutes": 60,
      "SlidingExpiration": true,
      "LoginUrl": "~/Login"
    }
  },
  "HttpRuntime": {
    "FcnMode": "Single",
    "MaxRequestLength": 28672,
    "RequestLengthDiskThreshold": 80,
    "ExecutionTimeout": 1200,
    "MaxUrlLength": 2048
  },
  "CustomErrors": {
    "Mode": "RemoteOnly",
    "ErrorPagePath": "~/ErrorPage.aspx",
    "_PORT_TODO_errorpage": "ErrorPage.aspx is still served by the net48 Website project. Update this to the new route once Website is migrated to Blazor."
  },
  "MobileRedirect": {
    "MobileViewSiteCookieName": "dnn_IsMobile",
    "DisableMobileViewSiteCookieName": "dnn_NoMobile"
  },
  "ImageHandler": {
    "Settings": "",
    "Transforms": {}
  },
  "AppSettings": {
    "InstallTemplate": "DotNetNuke.install.config",
    "AutoUpgrade": "true",
    "UseInstallWizard": "true",
    "InstallMemberRole": "true",
    "ShowMissingKeys": "false",
    "EnableCachePersistence": "false",
    "HostHeader": "",
    "RemoveAngleBrackets": "false",
    "PersistentCookieTimeout": "0",
    "EnableServicesFrameworkTracing": "false",
    "UpdateServiceUrl": "https://dnnplatform.io",
    "PreserveLoginUrl": "true",
    "loginUrl": "~/Login.aspx",
    "AllowDnnImagePlaceholderText": "false",
    "AllowDnnUpgradeUpload": "true",
    "DisableCsp": "false"
  },
  "DotNetNuke": {
    "htmlEditor": {
      "defaultProvider": "DNNConnect.CKE",
      "providers": [
        {
          "name": "DNNConnect.CKE",
          "type": "DNNConnect.CKEditorProvider.CKHtmlEditorProvider, DNNConnect.CKEditorProvider",
          "providerPath": "~/Providers/HtmlEditorProviders/DNNConnect.CKE/",
          "settingsControlPath": "~/Providers/HtmlEditorProviders/DNNConnect.CKE/Module/EditorConfigManager.ascx"
        }
      ]
    },
    "navigationControl": {
      "defaultProvider": "DDRMenuNavigationProvider",
