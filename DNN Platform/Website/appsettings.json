{
  "_PORT_TODO_secrets": "MachineKey:DecryptionKey and MachineKey:ValidationKey are key material and MUST NOT be committed. Set them per environment via `dotnet user-secrets set \"MachineKey:DecryptionKey\" \"...\"`, the MachineKey__DecryptionKey environment variable, or a secrets manager. Do the same for ConnectionStrings:SiteSqlServer whenever it carries a password (User ID=/Password=).",
  "_PORT_TODO_encryption": "Microsoft.Data.SqlClient 4.0+ defaults to Encrypt=Mandatory. TrustServerCertificate=True keeps an existing installation connecting; replace it with Encrypt=True plus a CA-trusted server certificate for production. The same applies to DotNetNuke:data:providers[0]:upgradeConnectionString when it is set (empty means \"reuse SiteSqlServer\").",
  "_PORT_TODO_secrets_connectionstrings": "ConnectionStrings:SiteSqlServer is REDACTED: it is the single credential-bearing setting in the application and must never be committed. Set it per environment with `dotnet user-secrets set \"ConnectionStrings:SiteSqlServer\" \"...\"`, the ConnectionStrings__SiteSqlServer environment variable, or a secrets manager. appsettings.Development.json carries a credential-free SQLExpress/Integrated Security default for local work only. The same applies to DotNetNuke:data:providers:0:upgradeConnectionString when it is set (empty means \"reuse SiteSqlServer\").",
  "ConnectionStrings": {
    "SiteSqlServer": "<<SECRET>>"
  },
  "MachineKey": {
    "ValidationKey": "<<SECRET>>",
    "DecryptionKey": "<<SECRET>>",
    "Decryption": "AES",
    "Validation": "SHA1"
  },
  "Membership": {
    "ApplicationName": "DotNetNuke",
    "ConnectionStringName": "SiteSqlServer",
    "PasswordFormat": 1,
    "HashAlgorithmType": "SHA256",
    "EnablePasswordRetrieval": false,
    "EnablePasswordReset": true,
    "RequiresQuestionAndAnswer": false,
    "RequiresUniqueEmail": false,
    "MinRequiredPasswordLength": 7,
    "MinRequiredNonAlphanumericCharacters": 0,
    "MaxInvalidPasswordAttempts": 5,
    "PasswordAttemptWindow": 10,
    "PasswordStrengthRegularExpression": "",
    "UserIsOnlineTimeWindow": 15
  },
  "Authentication": {
    "Cookie": {
      "Name": ".DOTNETNUKE",
      "Domain": "",
