    /// <summary>Validates file access permissions.</summary>
    /// <returns>Returns if the permissions are valid or an error message.</returns>
    /// <remarks>
    /// SECURITY CONTROL - preserved exactly, rule for rule. The same two verifiers over the same
    /// two directories with the same retry count (3), the same `Where(v =&gt; !v.VerifyAll())`
    /// failure test, the same single `permissionsValid = false` consequence and the same error
    /// message built from every verifier's BasePath. Nothing is relaxed or widened.
    /// The ONLY change is the path lookup: <c>HttpContext.Current.Server.MapPath("~")</c> and
    /// <c>HttpContext.Current.Server.MapPath("~/App_Data")</c> become
    /// <see cref="HttpContextSource.MapPath"/>, which resolves against the content root (TASK 101).
    /// </remarks>
    public static Tuple<bool, string> ValidatePermissions()
    {
        var permissionsValid = true;
        var errorMessage = string.Empty;

        var verifiers = new List<FileSystemPermissionVerifier>
                            {
                                new FileSystemPermissionVerifier(HttpContextSource.MapPath("~"), 3),
                                new FileSystemPermissionVerifier(HttpContextSource.MapPath("~/App_Data"), 3),
                            };

        var failedList = verifiers.Where(v => !v.VerifyAll()).ToArray();
        if (failedList.Any())
        {
            permissionsValid = false;
        }

        if (!permissionsValid)
        {
            errorMessage = string.Format(LocalizeStringStatic("FileAndFolderPermissionCheckFailed"), string.Join("; ", from v in verifiers select v.BasePath));
        }

        return new Tuple<bool, string>(permissionsValid, errorMessage);
    }

    /// <summary>Validates the password for password requirements.</summary>
    /// <param name="password">The entered password.</param>
    /// <returns>A value indicating whether the password is valid.</returns>
    /// <remarks>
    /// SECURITY CONTROL - preserved exactly, rule for rule and in the same order:
    /// (1) minimum length, (2) the password strength regular expression when one is configured,
    /// (3) the minimum count of non-alphanumeric characters. Each failing rule sets
    /// <c>result = false</c> and no rule can re-enable it, which is the original's semantics.
    /// The three settings are read through <see cref="MembershipProviderConfig"/>, which is the
    /// one-for-one replacement of <c>System.Web.Security.Membership</c>: DNN's
    /// <c>AspNetMembershipProvider</c> surfaces <c>MinPasswordLength</c>,
    /// <c>PasswordStrengthRegularExpression</c> and <c>MinNonAlphanumericCharacters</c> from the
    /// same membership configuration the static <c>Membership</c> class read
    /// (<c>MinRequiredPasswordLength</c>, <c>PasswordStrengthRegularExpression</c>,
    /// <c>MinRequiredNonAlphanumericCharacters</c>). No rule is relaxed, widened or reordered.
    /// </remarks>
    public static bool ValidatePassword(string password)
    {
        // Check Length
        var result = !(password.Length < MembershipProviderConfig.MinPasswordLength);

        // Check against regex
        if (!string.IsNullOrEmpty(MembershipProviderConfig.PasswordStrengthRegularExpression) && !Regex.IsMatch(password, MembershipProviderConfig.PasswordStrengthRegularExpression))
        {
            result = false;
        }

        // Check non-alphaNumeric
        var nonAlnumCount = password.Where((t, i) => !char.IsLetterOrDigit(password, i)).Count();
        if (nonAlnumCount < MembershipProviderConfig.MinNonAlphanumericCharacters)
        {
            result = false;
        }

        return result;
    }

