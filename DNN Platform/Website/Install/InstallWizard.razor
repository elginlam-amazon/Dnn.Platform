        this.Navigation.NavigateTo(Globals.ResolveUrl(DotNetNuke.Common.ErrorPage.Path), forceLoad: true);
    }

    /// <inheritdoc />
    protected override void OnInit(EventArgs e)
    {
        base.OnInit(e);

        // if previous config deleted create new empty one
        string installConfig = Path.Combine(AppDomain.CurrentDomain.BaseDirectory, "Install", "DotNetNuke.install.config");
        if (!File.Exists(installConfig))
        {
            File.Copy(installConfig + ".resources", installConfig);
        }

        GetInstallerLocales(this.AppStatusInfo);

        // Was: if (!this.Page.IsPostBack || installConfig == null). There are no postbacks any
        // more - the first initialization of the component instance is the former "not a
        // postback" - so the config is read exactly once per view of the page, which is what the
        // condition achieved.
        if (InstallWizard.installConfig == null)
        {
            InstallWizard.installConfig = InstallController.Instance.GetInstallConfig();
            connectionConfig = InstallWizard.installConfig.Connection;
        }
    }

    /// <inheritdoc />
    /// <remarks>
    /// Ports <c>OnPreRender</c>. The two script registrations it made
    /// (<c>dnn.initializePasswordStrength</c> and <c>dnn.initializePasswordComparer</c>) are
    /// replaced by the server-rendered rules panel and confirm-password message: the VALUES are
    /// still read from <see cref="DnnPaswordStrengthOptions"/>/<see cref="DnnConfirmPasswordOptions"/>
    /// and overridden with this page's own local resource strings for exactly the reason the
    /// original gave - the install wizard cannot assume App_GlobalResources/WebControls.resx has
    /// been translated for the selected culture at install time.
    /// </remarks>
    protected override void OnPreRender(EventArgs e)
    {
        base.OnPreRender(e);

        var options = new DnnPaswordStrengthOptions();

        // The Install Wizard cannot assume App_GlobalResources/WebControls.resx
        // (which DnnPaswordStrengthOptions reads by default) has been translated
        // for the selected culture at install time. Override with this page's
        // own local resource file, consistent with every other string on this page.
        options.MinLengthText = this.LocalizeString("PasswordStrengthMinLength");
        options.WeakText = this.LocalizeString("PasswordStrengthWeak");
        options.FairText = this.LocalizeString("PasswordStrengthFair");
        options.StrongText = this.LocalizeString("PasswordStrengthStrong");
        options.CriteriaAtLeastNCharsText = this.LocalizeString("CriteriaAtLeastNChars");
        options.CriteriaAtLeastNSpecialCharsText = this.LocalizeString("CriteriaAtLeastNSpecialChars");
        options.CriteriaValidationExpressionText = this.LocalizeString("CriteriaValidationExpression");
        options.PasswordRulesHeadText = this.LocalizeString("PasswordRulesHeadText");

        // Was the [OnSerializing] callback of DnnPaswordStrengthOptions, which ran while
        // Json.Serialize built the payload for the client script. The same three settings are read
        // from the same source and the same three criteria texts are formatted with them.
        // `PortalController` here is PageBase's injected IPortalController property (not the
        // concrete type), so the current settings come from the instance, not a static Instance.
        var passwordSettings = new MembershipPasswordSettings(this.PortalController.GetCurrentSettings()?.PortalId ?? -1);
        this.minPasswordLength = passwordSettings.MinPasswordLength;
        this.minNonAlphanumericCharacters = passwordSettings.MinNonAlphanumericCharacters;
        this.passwordValidationExpression = passwordSettings.ValidationExpression;

        this.passwordStrengthMinLengthText = options.MinLengthText;
        this.passwordStrengthWeakText = options.WeakText;
        this.passwordStrengthFairText = options.FairText;
        this.passwordStrengthStrongText = options.StrongText;
        this.passwordRulesHeadText = options.PasswordRulesHeadText;
        this.criteriaAtLeastNCharsText = string.Format(CultureInfo.CurrentCulture, options.CriteriaAtLeastNCharsText ?? string.Empty, this.minPasswordLength);
        this.criteriaAtLeastNSpecialCharsText = string.Format(CultureInfo.CurrentCulture, options.CriteriaAtLeastNSpecialCharsText ?? string.Empty, this.minNonAlphanumericCharacters);
        this.criteriaValidationExpressionText = string.Format(CultureInfo.CurrentCulture, options.CriteriaValidationExpressionText ?? string.Empty, this.passwordValidationExpression);
        this.weakColor = options.WeakColor;
        this.fairColor = options.FairColor;
        this.strongColor = options.StrongColor;

        var confirmPasswordOptions = new DnnConfirmPasswordOptions()
        {
            FirstElementSelector = "#passwordContainer input[type=password]",
            SecondElementSelector = ".password-confirm",
            ContainerSelector = ".dnnFormPassword",
            UnmatchedCssClass = "unmatched",
            MatchedCssClass = "matched",
            ConfirmPasswordUnmatchedText = this.LocalizeString("ConfirmPasswordUnmatched"),
            ConfirmPasswordMatchedText = this.LocalizeString("ConfirmPasswordMatched"),
        };

        this.confirmPasswordUnmatchedText = confirmPasswordOptions.ConfirmPasswordUnmatchedText;
        this.confirmPasswordMatchedText = confirmPasswordOptions.ConfirmPasswordMatchedText;
    }

    /// <inheritdoc />
    protected override void OnLoad(EventArgs e)
    {
        if (InstallBlocker.Instance.IsInstallInProgress())
        {
            // Preserved guard (was line 445): a running install owns the process, so the wizard
            // sends the operator to the installer's streamed progress page instead.
            this.Navigation.NavigateTo(Globals.ResolveUrl("~/Install/install.aspx"), forceLoad: true);
            return;
        }

        this.SetBrowserLanguage();
        this.LocalizePage();

        base.OnLoad(e);

        // Create Status Files
        if (!File.Exists(StatusFile))
        {
            File.CreateText(StatusFile).Close();
        }

        if (this.initialized)
        {
            return;
        }

        this.initialized = true;

        if (!string.IsNullOrEmpty(this.InitiateInstall))
        {
            // Was the "&initiateinstall=1" RawUrl suffix: synchronize the connection strings into
            // web.config and re-request the URL with "&executeinstall=1" so the application
            // restarts before the install runs.
            var synchConnectionString = new SynchConnectionStringStep();
            synchConnectionString.Execute();
            this.Navigation.NavigateTo(this.BuildWizardUrl(executeInstall: true), forceLoad: true);
            return;
        }

        if (!string.IsNullOrEmpty(this.ExecuteInstall) || installerRunning)
        {
            // Was the "&executeinstall=1" branch, and the `installerRunning` branch that put the
            // page straight onto the installation tab. The install itself is started from
            // OnAfterRenderAsync, which only runs on the interactive render - so the long
            // operation never blocks the HTTP response and its progress can actually be streamed
            // to the circuit. The original had to kick it off inline and rely on the browser
            // polling a file.
            this.step = WizardStep.Installation;
            return;
        }

        this.SetupDatabaseInfo();
        this.BindLanguageList();
        this.BindTemplates();

        if (CheckDatabaseConnection())
        {
            this.Initialise();

            // Replaces the PageMethods.VerifyDatabaseConnectionOnLoad(true) branch of
            // InitializeInstallScreen: hide the advanced panel and the standard-database note.
            // (The script's `installWizard.ValidDatabaseConnection = true` flag set here was never
            // read by anything - the observable effects are the two state changes below, which is
            // why no equivalent flag is kept.)
            this.showStandardDatabaseMessage = false;
            this.databaseInfoMessage = string.Empty;
        }
        else
        {
            // Install but connection string not configured to point at a valid SQL Server
            UpdateMachineKey(this.AppStatusInfo);

            // Replaces the PageMethods.VerifyDatabaseConnectionOnLoad(false) branch: show the
            // standard-database note, open the advanced panel, select "advanced" and disable
            // "standard" - the user cannot proceed with the unusable standard configuration.
            this.showStandardDatabaseMessage = true;
            this.databaseSetup = "advanced";
            this.standardDatabaseDisabled = true;
            this.databaseInfoMessage = string.Empty;
        }

        if (!Regex.IsMatch(this.Request.Host.Host, "^([a-zA-Z0-9.-]+)$"))
        {
            this.errorText = Localization.GetString("HostWarning", localResourceFile);
        }

        // ensure web.config is not read-only
        // TASK 101: was this.Server.MapPath("~/web.config").
        var configPath = HttpContextSource.MapPath("~/web.config");
        try
        {
            var attributes = File.GetAttributes(configPath);

            // file is read only
            if ((attributes & FileAttributes.ReadOnly) == FileAttributes.ReadOnly)
            {
                attributes = attributes & ~FileAttributes.ReadOnly;
                File.SetAttributes(configPath, attributes);
            }
        }
        catch (Exception ex)
        {
            this.errorText = ex.ToString();
            return;
        }

        // Ensure connection strings are in synch
        var synchConnectionStrings = new SynchConnectionStringStep();
        synchConnectionStrings.Execute();
        if (synchConnectionStrings.Status == StepStatus.AppRestart)
        {
            this.Navigation.NavigateTo(this.BuildWizardUrl(), forceLoad: true);
            return;
        }

        this.userName = installConfig.SuperUser.UserName;
        this.email = installConfig.SuperUser.Email;
        if (installConfig.Portals.Count > 0)
        {
            this.websiteName = installConfig.Portals[0].PortalName;

            // TODO Language and Template
        }

        this.emailValidationExpression = Globals.glbEmailRegEx;

        // Was this.chkWebsiteSsl.Checked = this.Request.IsSecureConnection.
        this.websiteSsl = this.Request?.IsHttps ?? false;

        // Replaces the PageMethods.ValidatePermissions(...) call InitializeInstallScreen made and
        // the jQuery dialog it opened with the result. The verification is the same SECURITY
        // control; only the presentation changed.
        var permissions = ValidatePermissions();
        this.PermissionsValid = permissions.Item1;
        this.permissionCheckMessage = permissions.Item1 ? null : permissions.Item2;
    }

    /// <inheritdoc />
    /// <remarks>
    /// The interactive render is where the long-running install is started and where progress
    /// reporting lives: <c>OnAfterRenderAsync</c> does not run during static server side
    /// rendering, so the install can never block the HTTP response, and it runs exactly once per
    /// circuit, so the install cannot be started twice by prerendering.
    /// </remarks>
    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        await base.OnAfterRenderAsync(firstRender);

        if (!firstRender || this.prerendered)
        {
            return;
        }

        this.prerendered = true;

        // Was the $(document).ready() branch: when the URL carries &executeinstall the wizard goes
        // to the installation tab and installs; otherwise PageMethods.IsInstallerRunning() decided
        // whether to show the installation tab and attach the progress bar.
        if (!string.IsNullOrEmpty(this.ExecuteInstall))
        {
            await this.InstallAsync();
        }
        else if (IsInstallerRunning())
        {
            this.step = WizardStep.Installation;
            this.StartProgressReporting();
            this.StateHasChanged();
        }
    }

    private static int NonAlphanumericCount(string value) =>
        string.IsNullOrEmpty(value) ? 0 : value.Count(c => !char.IsLetterOrDigit(c));

    /// <summary>Maps a status-file step state to its CSS class. Replaces <c>$.applyCssStyle</c>.</summary>
    private static string StepCssClass(string state)
    {
        if (string.IsNullOrEmpty(state))
        {
            state = string.Empty;
        }

        switch (state.ToLowerInvariant())
        {
            case "done":
                return "step-done";
            case "running":
                return "step-running";
            case "error":
                return "step-error";
            default:
                return "step-notstarted";
        }
    }

    private static void LaunchAutoInstall(IApplicationStatusInfo appStatus, string cultureCode = null)
    {
        if (appStatus.Status == UpgradeStatus.None)
        {
            // Was HttpContext.Current.Response.Redirect("~/"). There is no response to redirect
            // from a background install, so the caller observes the no-op; the component's
            // InstallAsync navigates to "~/" for exactly this case.
            return;
        }

        // Was: scriptTimeOut = Server.ScriptTimeout; Server.ScriptTimeout = int.MaxValue; ...
        // restore. ASP.NET Core has no script timeout; the install runs off the request thread
        // here, so no request timeout applies to it at all.

        // Prefer the culture passed in explicitly (e.g. from the client's PageLocale field) over the
        // static culture field, which does not survive an AppDomain restart triggered mid-install.
        var effectiveCulture = !string.IsNullOrEmpty(cultureCode) ? cultureCode : culture;
        if (effectiveCulture != null)
        {
            Thread.CurrentThread.CurrentUICulture = new CultureInfo(effectiveCulture);
        }

        Install(appStatus);
    }

    private static void Install(IApplicationStatusInfo appStatus)
    {
        // bail out early if we are already running
        if (installerRunning || InstallBlocker.Instance.IsInstallInProgress() || (appStatus.Status != UpgradeStatus.Install))
        {
            return;
        }

        var percentForEachStep = 100 / Steps.Count;
        var useGenericPercent = false;
        var totalPercent = Steps.Sum(step => step.Value);
        if (totalPercent != 100)
        {
            useGenericPercent = true;
        }

        installerRunning = true;
        installerProgress = 0;
        foreach (var step in Steps)
        {
            currentStep = step.Key;

            try
            {
                currentStep.Activity += CurrentStepActivity;
                currentStep.Execute();
            }
            catch (Exception ex)
            {
                Logger.InstallWizardError(ex);
                CurrentStepActivity("ERROR:" + ex.Message);
                installerRunning = false;
                return;
            }

            switch (currentStep.Status)
            {
                case StepStatus.AppRestart:
                    // Was HttpContext.Current.Response.Redirect(RawUrl, true). The install runs
                    // off the request thread, so there is no response to redirect; the step status
                    // is reported through the status file and the component's progress loop sees
                    // the install stop, which is what the operator observes. The AppDomain restart
                    // itself still happens, and the wizard resumes from the status file.
                    installerRunning = false;
                    break;
                default:
                    if (currentStep.Status != StepStatus.Done)
                    {
                        CurrentStepActivity(string.Format(
                            Localization.GetString("ErrorInStep", "~/Install/App_LocalResources/InstallWizard.aspx.resx"),
                            currentStep.Errors.Count > 0 ? string.Join(",", currentStep.Errors.ToArray()) : currentStep.Details));

                        installerRunning = false;
                        return;
                    }

                    break;
            }

            if (!installerRunning)
            {
                return;
            }

            if (useGenericPercent)
            {
                installerProgress += percentForEachStep;
            }
            else
            {
                installerProgress += step.Value;
            }
        }

        currentStep = null;

        installerProgress = 100;
        CurrentStepActivity(Localization.GetString("InstallationDone", "~/Install/App_LocalResources/InstallWizard.aspx.resx"));

        // indicate we are done
        installerRunning = false;
    }

    private static void CurrentStepActivity(string status)
    {
        var percentage = (currentStep == null) ? installerProgress : installerProgress + (currentStep.Percentage / Steps.Count);
        var obj = new
        {
            progress = percentage,
            details = status,
            check0 = FilePermissionCheck.Status.ToString() + (FilePermissionCheck.Errors.Count == 0 ? string.Empty : " Errors " + FilePermissionCheck.Errors.Count),
            check1 = InstallDatabaseStep.Status.ToString() + (InstallDatabaseStep.Errors.Count == 0 ? string.Empty : " Errors " + InstallDatabaseStep.Errors.Count),
            check2 = InstallExtensionsStep.Status.ToString() + (InstallExtensionsStep.Errors.Count == 0 ? string.Empty : " Errors " + InstallExtensionsStep.Errors.Count),
            check3 = InstallSiteStep.Status.ToString() + (InstallSiteStep.Errors.Count == 0 ? string.Empty : " Errors " + InstallSiteStep.Errors.Count),
            check4 = InstallSuperUserStep.Status.ToString() + (InstallSuperUserStep.Errors.Count == 0 ? string.Empty : " Errors " + InstallSuperUserStep.Errors.Count),
        };

        try
        {
            lock (@lock)
            {
                using (var sw = new StreamWriter(StatusFile, false))
                {
                    sw.WriteLine(obj.ToJson());
                }
            }
        }
        catch (Exception)
        {
            // TODO - do something
        }
    }

    private static void GetInstallerLocales(IApplicationStatusInfo appStatus)
    {
        var filePath = appStatus.ApplicationMapPath + LocalesFile.Replace("/", @"\");

        if (File.Exists(filePath))
        {
            var doc = new XPathDocument(filePath);
            var languages = doc.CreateNavigator().Select("root/language");

            if (languages.Count > 0)
            {
                supportedLanguages = new string[languages.Count];
                var i = 0;
                foreach (XPathNavigator nav in languages)
                {
                    if (nav.NodeType != XPathNodeType.Comment)
                    {
                        supportedLanguages.SetValue(nav.GetAttribute("key", string.Empty), i);
                    }

                    i++;
                }
            }
            else
            {
                supportedLanguages = new string[1];
                supportedLanguages.SetValue("en-US", 0);
            }
        }
        else
        {
            supportedLanguages = new string[1];
            supportedLanguages.SetValue("en-US", 0);
        }
    }

    private static string LocalizeStringStatic(string key)
    {
        return Localization.GetString(key, localResourceFile, culture);
    }

    private static bool CheckDatabaseConnection()
    {
        var success = false;
        connectionResult = CheckDatabaseConnection(connectionConfig);
        if (!connectionResult.StartsWith("ERROR:"))
        {
            success = true;
        }

        return success;
    }

    private static string CheckDatabaseConnection(ConnectionConfig connectionConfig)
    {
        connectionResult = InstallController.Instance.TestDatabaseConnection(connectionConfig);
        if (connectionResult.StartsWith("ERROR:"))
        {
            return connectionResult;
        }

        var connectionString = connectionResult;
        var details = Localization.GetString("IsAbleToPerformDatabaseActionsCheck", localResourceFile);
        if (!InstallController.Instance.IsAbleToPerformDatabaseActions(connectionString))
        {
            connectionResult = "ERROR: " + string.Format(CultureInfo.CurrentCulture, Localization.GetString("IsAbleToPerformDatabaseActions", localResourceFile), details);
        }

        // database actions check-running sql 2008 or higher
        details = Localization.GetString("IsValidSqlServerVersionCheck", localResourceFile);
        if (!InstallController.Instance.IsValidSqlServerVersion(connectionString))
        {
            connectionResult = "ERROR: " + string.Format(CultureInfo.CurrentCulture, Localization.GetString("IsValidSqlServerVersion", localResourceFile), details);
        }

        return connectionResult;
    }

    private static void UpdateMachineKey(IApplicationStatusInfo appStatus)
    {
        var installationDate = Config.GetSetting("InstallationDate");

        if (string.IsNullOrEmpty(installationDate))
        {
            string strError = Config.UpdateMachineKey(appStatus);
            if (string.IsNullOrEmpty(strError))
            {
                // send a new request to the application to initiate step 2
                var response = HttpContextSource.Current?.Response;
                if (response != null)
                {
                    response.Redirect(HttpContextSource.Current.Request.PathBase + HttpContextSource.Current.Request.Path + HttpContextSource.Current.Request.QueryString);
                }
            }
            else
            {
                // 403-3 Error - Redirect to ErrorPage
                // Was HttpContext.Current.Server.Transfer("~/ErrorPage.aspx?status=403_3&error=" + strError).
                // Server.Transfer has no ASP.NET Core counterpart and the error page is a routed
                // component now, so the browser is redirected to it instead; the URL comes from
                // the CustomErrors:ErrorPagePath key so it stays in step with that route.
                var strUrl = $"{DotNetNuke.Common.ErrorPage.Path}?status=403_3&error={System.Net.WebUtility.UrlEncode(strError)}";
                var response = HttpContextSource.Current?.Response;
                if (response != null)
                {
                    // Was response.Clear(): discard anything already buffered for this response
                    // before issuing the redirect. ASP.NET Core has no Response.Clear(), and this
                    // is only legal while the response has not started; the equivalent is to drop
                    // the headers (and any declared body length) that were set so far.
                    if (!response.HasStarted)
                    {
                        response.Headers.Clear();
                        response.ContentLength = null;
                    }

                    response.Redirect(Globals.ResolveUrl(strUrl));
                }
            }
        }
    }

    /// <summary>Updates and synchronizes DotNetNuke.install.config with Web.config.</summary>
    /// <param name="installInfo">The information about this installation.</param>
    private static void UpdateInstallConfig(Dictionary<string, string> installInfo)
    {
        installConfig = new InstallConfig
        {
            SuperUser = new SuperUserConfig
            {
                UserName = installInfo["username"],
                Password = installInfo["password"],
                Locale = culture,
                Email = installInfo["email"],
                FirstName = "SuperUser",
                LastName = "Account",
            },
            InstallCulture = installInfo["language"],
        };

        // Website Portal Config
        var portalConfig = new PortalConfig()
        {
            PortalName = installInfo["websiteName"],
            IsSsl = bool.Parse(installInfo["websiteSsl"]),
            TemplateFileName = installInfo["template"],
            IsChild = false,
        };
        installConfig.Portals = new List<PortalConfig>() { portalConfig };

        InstallController.Instance.SetInstallConfig(installConfig);
    }

    private static void UpdateDatabaseInstallConfig(Dictionary<string, string> installInfo)
    {
        // Database Config
        if (installInfo["databaseSetup"] == "advanced")
        {
            connectionConfig = new ConnectionConfig()
            {
                Server = installInfo["databaseServerName"],
                Qualifier = installInfo["databaseObjectQualifier"],
                Integrated = installInfo["databaseSecurity"] == "integrated",
                User = installInfo["databaseUsername"],
                Password = installInfo["databasePassword"],
                RunAsDbowner = installInfo["databaseRunAsOwner"] == "on",
            };

            if (installInfo["databaseType"] == "express")
            {
                connectionConfig.File = installInfo["databaseFilename"];
                connectionConfig.Database = string.Empty;
            }
            else
            {
                connectionConfig.Database = installInfo["databaseName"];
                connectionConfig.File = string.Empty;
            }
        }

        installConfig.Connection = connectionConfig;
        InstallController.Instance.SetInstallConfig(installConfig);
    }

    /// <summary>Builds the install information dictionary the page methods take.</summary>
    /// <remarks>
    /// This is the server-side equivalent of the `installWizard.installInfo = { ... }` object the
    /// continueLink click handler built from the form fields, including its rule that the database
    /// keys are only filled in for the "advanced" setup.
    /// </remarks>
    private Dictionary<string, string> BuildInstallInfo()
    {
        var installInfo = new Dictionary<string, string>
        {
            ["username"] = this.userName ?? string.Empty,
            ["password"] = this.password ?? string.Empty,
            ["confirmPassword"] = this.confirmPassword ?? string.Empty,
            ["email"] = this.email ?? string.Empty,
            ["websiteName"] = this.websiteName ?? string.Empty,
            ["websiteSsl"] = this.websiteSsl.ToString(),
            ["template"] = this.template ?? string.Empty,
            ["language"] = this.language ?? string.Empty,
            ["databaseSetup"] = this.databaseSetup,
            ["threadCulture"] = culture ?? string.Empty,
            ["databaseServerName"] = string.Empty,
            ["databaseFilename"] = string.Empty,
            ["databaseType"] = string.Empty,
            ["databaseName"] = string.Empty,
            ["databaseObjectQualifier"] = this.databaseObjectQualifier ?? string.Empty,
            ["databaseSecurity"] = string.Empty,
            ["databaseUsername"] = string.Empty,
            ["databasePassword"] = string.Empty,
            ["databaseRunAsOwner"] = null,
        };

        if (this.databaseSetup == "advanced")
        {
            installInfo["databaseServerName"] = this.databaseServerName ?? string.Empty;
            installInfo["databaseFilename"] = this.databaseFilename ?? string.Empty;
            installInfo["databaseType"] = this.databaseType;
            installInfo["databaseName"] = this.databaseName ?? string.Empty;
            installInfo["databaseSecurity"] = this.databaseSecurity;
            installInfo["databaseUsername"] = this.databaseUsername ?? string.Empty;
            installInfo["databasePassword"] = this.databasePassword ?? string.Empty;

            // The client sent the checkbox's `value` here, which is "on" when checked; for SQL
            // Express the checkbox was forced checked and disabled.
            installInfo["databaseRunAsOwner"] = (this.databaseType == "express" || this.databaseRunAsOwner) ? "on" : string.Empty;
        }

        return installInfo;
    }

    /// <summary>Replaces the <c>continueLink</c> click handler.</summary>
    private async Task ContinueAsync()
    {
        if (!this.ContinueEnabled)
        {
            // Was `installWizard.validateInput()` in the else branch: reveal the required-field
            // messages and stay on the tab.
            this.showValidation = true;
            return;
        }

        if (!this.ConfirmPasswords())
        {
            return;
        }

        this.accountInfoError = null;
        var installInfo = this.BuildInstallInfo();

        var result = ValidateInput(installInfo);
        if (!result.Item1)
        {
            this.showValidation = true;
            this.accountInfoError = result.Item2;
            return;
        }

        this.databaseError = null;
        this.databaseCheckFailed = false;
        this.databaseInfoMessage = this.LocalizeString("TestingDatabase");
        this.StateHasChanged();

        var valid = VerifyDatabaseConnection(installInfo);
        this.databaseInfoMessage = string.Empty;
        if (!valid.Item1)
        {
            this.databaseCheckFailed = true;
            this.databaseInfoMessage = this.LocalizeString("DatabaseError");
            this.databaseError = valid.Item2;
            return;
        }

        // Restart app to refresh config from web.config.
        // Preserved verbatim from the client script, which set culture and initiateinstall on the
        // current URL and replaced the location.
        this.Navigation.NavigateTo(this.BuildWizardUrl(initiateInstall: true), forceLoad: true);
    }

    /// <summary>Replaces the <c>retry</c> click handler.</summary>
    private async Task RetryAsync()
    {
        if (!this.RetryEnabled)
        {
            return;
        }

        this.showInstallationLog = false;
        await this.InstallAsync();
    }

    /// <summary>Replaces <c>installWizard.install()</c>: starts the install and the progress bar.</summary>
    private async Task InstallAsync()
    {
        this.step = WizardStep.Installation;
        this.installationComplete = false;
        this.installationFailed = false;
        this.progress = 0;
        this.progressDetails = string.Empty;
        this.StartProgressReporting();
        this.StateHasChanged();

        var appStatus = this.AppStatusInfo;
        if (appStatus.Status == UpgradeStatus.None)
        {
            // The LaunchAutoInstall guard: nothing to install, so go to the site.
            this.Navigation.NavigateTo(Globals.ResolveUrl("~/"), forceLoad: true);
            return;
        }

        var cultureCode = culture;

        // Call the page method which triggers the long running operation. It runs off the circuit's
        // thread so that the UI keeps rendering progress - this is what the AJAX call did.
        await Task.Run(() =>
        {
            try
            {
                RunInstall(cultureCode);
            }
            catch (Exception ex)
            {
                Logger.InstallWizardError(ex);
                CurrentStepActivity("ERROR:" + ex.Message);
            }
        });
    }

    /// <summary>Replaces the <c>seeLogs</c> click handler and its <c>GetInstallationLog</c> polling.</summary>
    private async Task SeeLogsAsync()
    {
        if (!this.SeeLogsEnabled)
        {
            return;
        }

        this.showInstallationLog = true;
        this.installationLog = this.LocalizeString("LoadingInstallationLog");
        this.installationLogStartLine = 0;
        this.StateHasChanged();

        // Was the recursive getInstallationLog() that appended 500 lines at a time until the
        // server returned an empty string.
        var builder = new StringBuilder();
        while (true)
        {
            var chunk = await Task.Run(() => GetInstallationLog(this.installationLogStartLine, culture) as string);
            if (string.IsNullOrEmpty(chunk))
            {
                break;
            }

            builder.Append(chunk);
            this.installationLogStartLine += 500;
            this.installationLog = builder.ToString();
            this.StateHasChanged();
        }

        if (builder.Length == 0)
        {
            this.installationLog = this.LocalizeString("NoInstallationLog");
        }
    }

    /// <summary>Replaces <c>VisitSiteClick</c>.</summary>
    private void VisitSiteClick()
    {
        if (!this.VisitSiteEnabled)
        {
            return;
        }

        // Delete the status file.
        try
        {
            File.Delete(StatusFile);
        }
        catch (Exception)
        {
            // Do nothing
        }

        // delete the initial install config -check readonly status first
        try
        {
            string installConfig = Path.Combine(AppDomain.CurrentDomain.BaseDirectory, "Install", "DotNetNuke.install.config");
            if (File.Exists(installConfig))
            {
                // make sure file is not read-only
                File.SetAttributes(installConfig, FileAttributes.Normal);
                File.Delete(installConfig);
            }
        }
        catch (Exception)
        {
            // Do nothing
        }

        Config.Touch(this.AppStatusInfo);
        this.Navigation.NavigateTo(Globals.ResolveUrl("~/Default.aspx"), forceLoad: true);
    }

