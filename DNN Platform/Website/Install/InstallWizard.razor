    /// <summary>Rebuilds the wizard URL, replacing the client script's URL manipulation.</summary>
    private string BuildWizardUrl(bool initiateInstall = false, bool executeInstall = false)
    {
        var url = new StringBuilder(Globals.ResolveUrl("~/Install/InstallWizard.aspx"));
        url.Append("?culture=").Append(System.Net.WebUtility.UrlEncode(culture ?? "en-US"));
        if (initiateInstall)
        {
            url.Append("&initiateinstall=1");
        }

        if (executeInstall)
        {
            url.Append("&executeinstall=1");
        }

        return url.ToString();
    }

    /// <summary>Starts the server-side progress loop that replaces the browser's 500ms poll.</summary>
    private void StartProgressReporting()
    {
        if (this.progressCancellation != null)
        {
            return;
        }

        this.progressStartedUtc = DateTime.UtcNow;
        this.progressCancellation = new CancellationTokenSource();
        var token = this.progressCancellation.Token;

        _ = Task.Run(async () =>
        {
            // 500ms is the interval the client used.
            using var timer = new PeriodicTimer(TimeSpan.FromMilliseconds(500));
            try
            {
                while (await timer.WaitForNextTickAsync(token))
                {
                    await this.InvokeAsync(this.ReadStatus);
                    if (this.installationComplete || this.installationFailed)
                    {
                        break;
                    }
                }
            }
            catch (OperationCanceledException)
            {
                // The circuit went away.
            }
        });
    }

    /// <summary>Reads the install status file and applies it. Replaces <c>$.updateProgressbar</c>.</summary>
    private void ReadStatus()
    {
        try
        {
            if (!File.Exists(StatusFile))
            {
                return;
            }

            string content;
            lock (@lock)
            {
                using var stream = new FileStream(StatusFile, FileMode.Open, FileAccess.Read, FileShare.ReadWrite);
                using var reader = new StreamReader(stream);
                content = reader.ReadToEnd();
            }

            var lines = content.Split('\n').Where(l => !string.IsNullOrWhiteSpace(l)).ToArray();
            if (lines.Length == 0)
            {
                return;
            }

            var status = Json.Deserialize<InstallStatus>(lines[lines.Length - 1]);
            if (status == null)
            {
                return;
            }

            // The client ignored a progress value lower than the one already shown.
            if (status.Progress < this.progress)
            {
                return;
            }

            this.progress = status.Progress;
            this.progressDetails = status.Details ?? string.Empty;
            this.check0 = status.Check0;
            this.check1 = status.Check1;
            this.check2 = status.Check2;
            this.check3 = status.Check3;
            this.check4 = status.Check4;

            var installationError = this.progressDetails.ToUpperInvariant().IndexOf("ERROR", StringComparison.Ordinal) > -1;

            if (this.progress >= 100 || this.progressDetails == this.LocalizeString("InstallationDone"))
            {
                // Was installWizard.finishInstall(): stop the bar, mark every step done and move
                // the wizard onto the "view website" tab.
                this.installationComplete = true;
                this.installationFailed = false;
                this.check0 = this.check1 = this.check2 = this.check3 = this.check4 = "Done";
                this.step = WizardStep.ViewWebsite;
            }
            else if (installationError)
            {
                this.installationFailed = true;
            }

            this.StateHasChanged();
        }
        catch (Exception)
        {
            // The client swallowed parse failures of a partially written status line; so does this.
        }
    }

    private string GetNextScriptVersion(string strProviderPath, Version currentVersion)
    {
        var strNextVersion = "Done";

        if (currentVersion == null)
        {
            strNextVersion = this.GetBaseDatabaseVersion();
        }
        else
        {
            var strScriptVersion = Null.NullString;
            var arrScripts = Upgrade.GetUpgradeScripts(strProviderPath, currentVersion);

            if (arrScripts.Count > 0)
            {
                // First Script is next script
                strScriptVersion = Path.GetFileNameWithoutExtension(Convert.ToString(arrScripts[0]));
            }

            if (!string.IsNullOrEmpty(strScriptVersion))
            {
                strNextVersion = strScriptVersion;
            }
        }

        return strNextVersion;
    }

    private void SetBrowserLanguage()
    {
        string cultureCode;
        if (string.IsNullOrEmpty(culture))
        {
            cultureCode = !string.IsNullOrEmpty(this.CultureParameter)
                ? this.CultureParameter
                : TestableLocalization.Instance.BestCultureCodeBasedOnBrowserLanguages(supportedLanguages);
        }
        else
        {
            cultureCode = culture;
        }

        culture = cultureCode;

        Thread.CurrentThread.CurrentUICulture = new CultureInfo(cultureCode);
    }

    private void Initialise()
    {
        if (this.TestDataBaseInstalled())
        {
            // running current version, so redirect to site home page
            this.Navigation.NavigateTo(Globals.ResolveUrl("~/Default.aspx"), forceLoad: true);
        }
        else
        {
            if (this.DatabaseVersion > new Version(0, 0, 0))
            {
                // Upgrade
                this.introDetail = string.Format(this.LocalizeString("Upgrade"), Upgrade.GetStringVersion(this.DatabaseVersion));
            }
            else
            {
                // Install
                UpdateMachineKey(this.AppStatusInfo);
            }
        }
    }

    private string InstallDatabase()
    {
        var strProviderPath = this.dataProvider.GetProviderPath();
        var strErrorMessage = strProviderPath.StartsWith("ERROR:")
            ? strProviderPath
            : Upgrade.InstallDatabase(this.BaseVersion, strProviderPath, this.InstallTemplate, false);
        if (string.IsNullOrEmpty(strErrorMessage))
        {
            // Get Next Version
            strErrorMessage = this.GetNextScriptVersion(strProviderPath, this.BaseVersion);
        }
        else if (!strErrorMessage.StartsWith("ERROR:"))
        {
            strErrorMessage = "ERROR: " + string.Format(this.LocalizeString("ScriptError"), Upgrade.GetLogFile(strProviderPath, this.BaseVersion));
        }

        return strErrorMessage;
    }

    private string InstallVersion(string strVersion)
    {
        var strErrorMessage = Null.NullString;
        var version = new Version(strVersion);
        var strScriptFile = Null.NullString;
        var strProviderPath = this.dataProvider.GetProviderPath();
        if (!strProviderPath.StartsWith("ERROR:"))
        {
            // Install Version
            strScriptFile = Upgrade.GetScriptFile(strProviderPath, version);
            strErrorMessage += Upgrade.UpgradeVersion(strScriptFile, false);
            this.Versions += "," + strVersion;
        }
        else
        {
            strErrorMessage = strProviderPath;
        }

        if (string.IsNullOrEmpty(strErrorMessage))
        {
            // Get Next Version
            strErrorMessage = this.GetNextScriptVersion(strProviderPath, version);
        }
        else
        {
            strErrorMessage = "ERROR: (see " + (Path.GetFileName(strScriptFile) ?? string.Empty)
                .Replace("." + Upgrade.DefaultProvider, ".log") + " for more information)";
        }

        return strErrorMessage;
    }

    private void LocalizePage()
    {
        // Was this.Page.Title (now the <PageTitle> above, which reads the same key) and
        // lblIntroDetail.
        this.introDetail = this.LocalizeString("IntroDetail");
    }

    /// <summary>TestDataBaseInstalled checks whether the Database is the current version.</summary>
    /// <returns>A value indicating whether the database is the current version.</returns>
    private bool TestDataBaseInstalled()
    {
        var success = !(this.DatabaseVersion == null || this.DatabaseVersion.Major != this.ApplicationVersion.Major || this.DatabaseVersion.Minor != this.ApplicationVersion.Minor || this.DatabaseVersion.Build != this.ApplicationVersion.Build);
        return success;
    }

    private void SetupDatabaseInfo()
    {
        // Try to use connection information in DotNetNuke.Install.Config. If not found use from web.config
        connectionConfig = installConfig.Connection;
        if (connectionConfig == null || string.IsNullOrEmpty(connectionConfig.Server))
        {
            connectionConfig = InstallController.Instance.GetConnectionFromWebConfig();
        }

        if (connectionConfig != null)
        {
            this.databaseServerName = connectionConfig.Server;

            // SQL Express Or SQL Server
            if (!string.IsNullOrEmpty(connectionConfig.File))
            {
                this.databaseFilename = connectionConfig.File;
                this.databaseType = "express";
            }
            else
            {
                this.databaseName = connectionConfig.Database;
                this.databaseType = "server";
            }

            // Integrated or Custom
            if (connectionConfig.Integrated)
            {
                this.databaseSecurity = "integrated";
            }
            else
            {
                this.databaseSecurity = "userDefined";
                this.databaseUsername = connectionConfig.User;
                this.databasePassword = connectionConfig.Password;
            }

            // Owner or Not
            this.databaseRunAsOwner = connectionConfig.RunAsDbowner;
        }
    }

    private void BindLanguageList()
    {
        try
        {
            var myResponseReader = UpdateService.GetLanguageList();

            // empty language list
            this.languageList.Clear();
            this.languagePackVersions.Clear();

            // Loading into XML doc
            var xmlDoc = new XmlDocument { XmlResolver = null };
            using (var xmlReader = XmlReader.Create(myResponseReader, new XmlReaderSettings { XmlResolver = null, }))
            {
                xmlDoc.Load(xmlReader);
            }

            var languages = xmlDoc.SelectNodes("available/language");
            var packages = new List<PackageInfo>();

            if (languages != null)
            {
                foreach (XmlNode language in languages)
                {
                    string cultureCode = string.Empty;
                    string version = string.Empty;
                    foreach (XmlNode child in language.ChildNodes)
                    {
                        if (child.Name == "culturecode")
                        {
                            cultureCode = child.InnerText;
                        }

                        if (child.Name == "version")
                        {
                            version = child.InnerText;
                        }
                    }

                    if (!string.IsNullOrEmpty(cultureCode) && !string.IsNullOrEmpty(version) && version.Length == 6)
                    {
                        var myCIintl = new CultureInfo(cultureCode, true);
                        version = version.Insert(4, ".").Insert(2, ".");
                        var package = new PackageInfo { Name = "LanguagePack-" + myCIintl.Name, FriendlyName = myCIintl.NativeName };
                        package.Name = myCIintl.NativeName;
                        package.Description = cultureCode;
                        Version ver;
                        Version.TryParse(version, out ver);
                        package.Version = ver;

                        if (packages.Any(p => p.Name == package.Name))
                        {
                            var existPackage = packages.First(p => p.Name == package.Name);
                            if (package.Version > existPackage.Version)
                            {
                                packages.Remove(existPackage);
                                packages.Add(package);
                            }
                        }
                        else
                        {
                            packages.Add(package);
                        }
                    }
                }
            }

            foreach (var package in packages)
            {
                this.languageList.Add(new ListEntry(package.Name, package.Description));

                // Was lastItem.Attributes.Add("onclick", "javascript:LegacyLangaugePack('<version>');"),
                // attached only to packs whose version does not match the application's.
                if (DotNetNukeContext.Current.Application.Version.Major != package.Version.Major
                    || DotNetNukeContext.Current.Application.Version.Minor != package.Version.Minor
                    || DotNetNukeContext.Current.Application.Version.Build != package.Version.Build)
                {
                    this.languagePackVersions[package.Description] = package.Version;
                }
            }
        }
        catch (Exception)
        {
            // suppress for now - need to decide what to do when webservice is unreachable
            // throw;
        }
        finally
        {
            // ensure there is always an en-us
            if (!this.languageList.Any(i => i.Value == "en-US"))
            {
                var myCIintl = new CultureInfo("en-US", true);
                this.languageList.Add(new ListEntry(myCIintl.NativeName, "en-US"));
                this.languagePackVersions.Remove("en-US");
            }

            this.language = this.languageList.Any(i => i.Value == culture) ? culture : "en-US";
        }
    }

    private void BindTemplates()
    {
        var templates = this.PortalTemplateController.GetPortalTemplates();
        this.templateList.Clear();
        foreach (var template in templates)
        {
            this.templateList.Add(new ListEntry(template.Name, Path.GetFileName(template.TemplateFilePath)));
        }

        this.template = this.templateList.Any(i => i.Value == "Default Website.template")
            ? "Default Website.template"
            : this.templateList.FirstOrDefault()?.Value;
    }

