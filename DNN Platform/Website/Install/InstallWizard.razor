    /// <summary>The shape of a line of the install status file written by <see cref="CurrentStepActivity"/>.</summary>
    private sealed class InstallStatus
    {
        [Newtonsoft.Json.JsonProperty("progress")]
        public int Progress { get; set; }

        [Newtonsoft.Json.JsonProperty("details")]
        public string Details { get; set; }

        [Newtonsoft.Json.JsonProperty("check0")]
        public string Check0 { get; set; }

        [Newtonsoft.Json.JsonProperty("check1")]
        public string Check1 { get; set; }

        [Newtonsoft.Json.JsonProperty("check2")]
        public string Check2 { get; set; }

        [Newtonsoft.Json.JsonProperty("check3")]
        public string Check3 { get; set; }

        [Newtonsoft.Json.JsonProperty("check4")]
        public string Check4 { get; set; }
    }
