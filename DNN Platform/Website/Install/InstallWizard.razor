    /// <summary>Replaces the <c>languageList</c> change handler and <c>LegacyLangaugePack</c>/<c>ClearLegacyLangaugePack</c>.</summary>
    private void LanguageListChanged(ChangeEventArgs e)
    {
        this.language = e.Value?.ToString();

        // The client attached javascript:LegacyLangaugePack('<version>') to every item whose pack
        // version did not match the application version, and ClearLegacyLangaugePack() to en-US.
        if (!string.IsNullOrEmpty(this.language) && this.languagePackVersions.TryGetValue(this.language, out var version))
        {
            this.legacyLanguagePackMessage = this.LocalizeString("LegacyLangaugePack") + version;
        }
        else
        {
            this.legacyLanguagePackMessage = string.Empty;
        }
    }

    /// <summary>Replaces <c>installWizard.confirmPasswords</c>.</summary>
    private bool ConfirmPasswords()
    {
        if (this.password != this.confirmPassword)
        {
            this.adminInfoError = this.LocalizeString("PasswordMismatch");
            this.confirmPasswordMatched = false;
            this.confirmPasswordMessage = this.confirmPasswordUnmatchedText;
            return false;
        }

        this.adminInfoError = null;
        this.confirmPasswordMatched = true;
        this.confirmPasswordMessage = this.confirmPasswordMatchedText;
        return true;
    }

    /// <summary>Replaces <c>installWizard.validatePassword</c>, including its PageMethods call.</summary>
    private Task ValidatePasswordAsync()
    {
        var validate = !string.IsNullOrEmpty(this.confirmPassword)
            ? this.ConfirmPasswords()
            : !string.IsNullOrEmpty(this.password);

        if (!validate)
        {
            return Task.CompletedTask;
        }

        // The SAME ValidatePassword security control the AJAX call invoked.
        if (ValidatePassword(this.password ?? string.Empty))
        {
            this.adminInfoError = null;
        }
        else
        {
            this.adminInfoError = this.LocalizeString("InputErrorInvalidPassword");
        }

        return Task.CompletedTask;
    }

