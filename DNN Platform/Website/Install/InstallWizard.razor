    /// <summary>Handles an unhandled error on this page.</summary>
    /// <param name="exc">The exception.</param>
    /// <param name="statusCode">The status code the exception maps to.</param>
    /// <remarks>
    /// Replaces <c>OnError</c>, which did
    /// <c>Response.Clear(); Server.Transfer("~/ErrorPage.aspx")</c>. <c>Server.Transfer</c> does not
    /// exist on ASP.NET Core and the error page is a routed component now, so the browser is sent
    /// to it. The URL comes from <see cref="DotNetNuke.Common.ErrorPage.Path"/> (the
    /// <c>CustomErrors:ErrorPagePath</c> key), which keeps it in step with the error page's route.
    /// </remarks>
