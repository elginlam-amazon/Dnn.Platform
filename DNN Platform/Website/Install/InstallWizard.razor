@* The legacy URL is preserved: upgrade documentation, the installer's own redirects and
   Upgrade.DeleteInstallerFiles all name Install/InstallWizard.aspx. *@
@page "/Install/InstallWizard.aspx"

@namespace DotNetNuke.Services.Install
@inherits DotNetNuke.Framework.PageBase
@layout DotNetNuke.Website.Components.StandaloneLayout
@implements DotNetNuke.UI.Utilities.IClientAPICallbackEventHandler
@implements IDisposable

@using System
@using System.Collections
@using System.Collections.Generic
@using System.Globalization
@using System.IO
@using System.Linq
@using System.Text
@using System.Text.RegularExpressions
@using System.Threading
@using System.Threading.Tasks
@using System.Xml
@using System.Xml.XPath
@using Microsoft.AspNetCore.Components
@using Microsoft.AspNetCore.Components.Web
@using Microsoft.Extensions.DependencyInjection
@using Microsoft.Extensions.Logging
@using DotNetNuke.Abstractions.Application
@using DotNetNuke.Abstractions.Portals.Templates
@using DotNetNuke.Application
@using DotNetNuke.Common
@using DotNetNuke.Common.Utilities
@using DotNetNuke.Data
@using DotNetNuke.Entities.Portals
@using DotNetNuke.Entities.Users.Membership
@using DotNetNuke.Instrumentation
@using DotNetNuke.Security.Membership
@using DotNetNuke.Services.Installer.Blocker
@using DotNetNuke.Services.Installer.Packages
@using DotNetNuke.Services.Localization.Internal
@using DotNetNuke.Services.Upgrade
@using DotNetNuke.Services.Upgrade.InternalController.Steps
@using DotNetNuke.Services.Upgrade.Internals
@using DotNetNuke.Services.Upgrade.Internals.InstallConfiguration
@using DotNetNuke.Services.Upgrade.Internals.Steps
@using DotNetNuke.Website
@using DotNetNuke.Web.UI.WebControls
@using Localization = DotNetNuke.Services.Localization.Localization

@*
    =====================================================================================
    The Installation Wizard.

    WHAT REPLACED THE CLIENT SCRIPT, AND WHY
    InstallWizard.aspx carried ~500 lines of jQuery that existed for one reason: a WebForms page
    cannot talk to its own server code without a postback, so every step was an
    `asp:ScriptManager EnablePageMethods` AJAX call (PageMethods.ValidatePassword,
    ValidatePermissions, VerifyDatabaseConnectionOnLoad, VerifyDatabaseConnection, ValidateInput,
    IsInstallerRunning, RunInstall, GetInstallationLog) plus jQuery UI for the three wizard tabs
    and a 500ms `$.get` poll of the install status file for the progress bar.

    On Blazor Server every one of those is a direct server call on an open circuit, so the whole
    script layer is gone and NOT reimplemented - no <script> is emitted from this component
    (Blazor does not execute component-rendered script anyway):
      * jQuery UI tabs          -> the `step` field + @@if blocks below.
      * PageMethods.X(...)      -> @@onclick/@@onblur handlers calling the SAME static methods,
                                   which are preserved verbatim with their original signatures
                                   because they are the page's public API surface.
      * $.get(installstat...)   -> ReadStatusAsync(), a server-side PeriodicTimer that reads the
                                   same status file the installer writes and calls StateHasChanged.
                                   This is strictly better than before: the status file no longer
                                   has to be web-servable (Install/ is not served content now).
      * dnn.initializePasswordStrength / dnn.PasswordComparer
                                -> the server-rendered password rules panel and the
                                   confirm-password message below, built from the very same
                                   DnnPaswordStrengthOptions / DnnConfirmPasswordOptions values and
                                   the same localized strings OnPreRender configured.

    The progress file is still written by CurrentStepActivity: it is what lets the wizard resume
    reporting after the AppDomain restart an install step can trigger, so it must not be dropped.
    =====================================================================================
*@

<PageTitle>@this.LocalizeString("PageTitle")</PageTitle>

<HeadContent>
    @* The standalone document's stylesheets. Top-level wwwroot directories are lowercase now. *@
    <link rel="stylesheet" type="text/css" href="~/resources/Shared/stylesheets/dnndefault/10.0.0/default.css" />
    <link rel="stylesheet" type="text/css" href="~/install/Install.css" />
    <link rel="stylesheet" type="text/css" href="~/resources/Shared/stylesheets/dnn.PasswordStrength.css" />
</HeadContent>

<br />

@* Was <div id="languageFlags"> with seven asp:LinkButtons whose OnClientClick set the PageLocale
   hidden field. The hidden field is now the `culture` state and each flag is a real server
   handler, so switching language re-localizes the page immediately.
   Hidden on the installation step, which is what showInstallationTab()'s $("#languageFlags").hide() did. *@
@if (this.step == WizardStep.AccountInfo && this.SupportLocalization)
{
    <div id="languageFlags">
        @foreach (var flag in LanguageFlags)
        {
            @* `culture` is static, exactly as in InstallWizard.aspx.cs, because the static install
               API (RunInstall/GetInstallationLog) reads it; it must be type-qualified here. *@
            <a class="flag @(culture == flag.Code ? "selectedFlag" : null)"
               value="@flag.Code" title="@flag.Title" href="javascript:void(0);"
               @onclick="() => this.ChangePageLocale(flag.Code)" @onclick:preventDefault="true">
                <img src="@Globals.ResolveUrl($"~/images/flags/{flag.Code}.gif")" alt="@flag.Code" class="flagimage" />
            </a>
        }
    </div>
}

<div class="install">
    <h2 class="dnnForm dnnInstall dnnClear">
        @this.LocalizeString("InstallTitle")
        <hr />
    </h2>
    @if (!string.IsNullOrEmpty(this.errorText))
    {
        <span id="lblError" class="dnnFormMessage dnnFormError" style="display:block">@this.errorText</span>
    }

    @* Was <div id="permissionCheckMessage"> plus the jQuery dialog ValidatePermissions() opened.
       The verification now runs server-side during initialization and its message is rendered
       inline - the dialog was only a way to surface an AJAX result. *@
    @if (!string.IsNullOrEmpty(this.permissionCheckMessage))
    {
        <div id="permissionCheckMessage">
            <span class="NormalBold promptMessage permissionCheck">@((MarkupString)this.permissionCheckMessage)</span>
        </div>
    }

    <div id="tabs" class="dnnWizardTab">
        <ul>
            <li id="accountInfo" class="@(this.step == WizardStep.AccountInfo ? "ui-tabs-active ui-state-active" : null)">
                <div class="dnnWizardStep">
                    <span class="dnnWizardStepNumber">1</span>
                    <span class="dnnWizardStepTitle">@this.LocalizeString("AccountInfo")</span>
                    <span class="dnnWizardStepArrow"></span>
                </div>
            </li>
            <li id="installInfo" class="@(this.step == WizardStep.Installation ? "ui-tabs-active ui-state-active" : null)">
                <div class="dnnWizardStep">
                    <span class="dnnWizardStepNumber">2</span>
                    <span class="dnnWizardStepTitle">@this.LocalizeString("Installation")</span>
                    <span class="dnnWizardStepArrow"></span>
                </div>
            </li>
            <li id="webInfo" class="@(this.step == WizardStep.ViewWebsite ? "ui-tabs-active ui-state-active" : null)">
                <div class="dnnWizardStep">
                    <span><img id="finishImage" src="@Globals.ResolveUrl("~/images/finishflag.png")" alt="" /></span>
                    <span class="dnnWizardStepTitle">@this.LocalizeString("ViewWebsite")</span>
                </div>
            </li>
        </ul>

        @if (this.step == WizardStep.AccountInfo)
        {
            <div class="installAccountInfo dnnClear" id="installAccountInfo">
                <span id="lblAccountInfoIntro">@this.LocalizeString("AccountInfoIntro")</span>
                <span id="lblIntroDetail">@this.introDetail</span>
                <p style="display: block; margin: 10px 0 10px 0;">
                    @if (!string.IsNullOrEmpty(this.accountInfoError))
                    {
                        <span id="lblAccountInfoError" class="dnnFormMessage dnnFormError" style="display:block">@this.accountInfoError</span>
                    }
                </p>

                <div id="adminInfo" class="dnnForm">
                    <DotNetNuke.UI.UserControls.LabelControl ID="lblAdminInfo" CssClass="tabSubTitle" ResourceKey="AdminInfo" LocalResourceFile="@LocalResourceFileName" />
                    @if (!string.IsNullOrEmpty(this.adminInfoError))
                    {
                        <span id="lblAdminInfoError" class="NormalRed">@this.adminInfoError</span>
                    }
                    <div class="dnnFormItem dnnFormPassword">
                        <div class="dnnFormItem">
                            <DotNetNuke.UI.UserControls.LabelControl ID="lblUsername" ControlName="txtUsername" ResourceKey="UserName" CssClass="dnnFormRequired" LocalResourceFile="@LocalResourceFileName" />
                            <input id="txtUsername" type="text" value="@this.userName" @onchange="e => this.userName = e.Value?.ToString()" />
                            @if (this.showValidation && string.IsNullOrEmpty(this.userName))
                            {
                                <span id="valUsername" class="dnnFormMessage dnnFormError dnnRequired">@this.LocalizeString("UserName.Required")</span>
                            }
                        </div>
                        <div class="dnnFormItem">
                            <DotNetNuke.UI.UserControls.LabelControl ID="lblPassword" ControlName="txtPassword" ResourceKey="Password" CssClass="dnnFormRequired" LocalResourceFile="@LocalResourceFileName" />
                            <div id="passwordContainer" class="password-strength-container">
                                <input id="txtPassword" class="password-strength" type="password" value="@this.password"
                                       @onchange="e => this.password = e.Value?.ToString()" @onblur="this.ValidatePasswordAsync" />
                            </div>
                            @if (this.showValidation && string.IsNullOrEmpty(this.password))
                            {
                                <span id="valPassword" class="dnnFormMessage dnnFormError dnnRequired">@this.LocalizeString("Password.Required")</span>
                            }

                            @* The server-rendered replacement for dnn.initializePasswordStrength's meter
                               and rules list. Same head text, same three criteria lines, same colors. *@
                            <div class="dnnFormHelpContent password-rules">
                                <span class="password-rules-head">@this.passwordRulesHeadText</span>
                                <ul>
                                    <li class="@(this.password?.Length >= this.minPasswordLength ? "criteria-met" : "criteria-unmet")">@this.criteriaAtLeastNCharsText</li>
                                    <li class="@(NonAlphanumericCount(this.password) >= this.minNonAlphanumericCharacters ? "criteria-met" : "criteria-unmet")">@this.criteriaAtLeastNSpecialCharsText</li>
                                    @if (!string.IsNullOrEmpty(this.passwordValidationExpression))
                                    {
                                        <li class="@(Regex.IsMatch(this.password ?? string.Empty, this.passwordValidationExpression) ? "criteria-met" : "criteria-unmet")">@this.criteriaValidationExpressionText</li>
                                    }
                                </ul>
                                <span class="min-length-text" style="color:@this.PasswordStrengthColor">@this.PasswordStrengthText</span>
                            </div>
                        </div>
                        <div class="dnnFormItem">
                            <DotNetNuke.UI.UserControls.LabelControl ID="lblConfirmPassword" ControlName="txtConfirmPassword" ResourceKey="Confirm" CssClass="dnnFormRequired" LocalResourceFile="@LocalResourceFileName" />
                            <input id="txtConfirmPassword" class="password-confirm @this.ConfirmPasswordCssClass" type="password" value="@this.confirmPassword"
                                   @onchange="e => this.confirmPassword = e.Value?.ToString()" @onblur="this.ValidatePasswordAsync" />
                            @if (this.showValidation && string.IsNullOrEmpty(this.confirmPassword))
                            {
                                <span id="valConfirmPassword" class="dnnFormMessage dnnFormError dnnRequired">@this.LocalizeString("Confirm.Required")</span>
                            }
                            @if (!string.IsNullOrEmpty(this.confirmPasswordMessage))
                            {
                                <span class="confirm-password-message">@this.confirmPasswordMessage</span>
                            }
                        </div>
                        <div class="dnnFormItem">
                            <DotNetNuke.UI.UserControls.LabelControl ID="lblEmail" ControlName="txtEmail" ResourceKey="Email" CssClass="dnnFormRequired" LocalResourceFile="@LocalResourceFileName" />
                            <input id="txtEmail" type="text" value="@this.email" @onchange="e => this.email = e.Value?.ToString()" />
                            @if (this.showValidation && string.IsNullOrEmpty(this.email))
                            {
                                <span id="valEmail" class="dnnFormMessage dnnFormError dnnRequired">@this.LocalizeString("Email.Required")</span>
                            }
                            else if (this.showValidation && !Regex.IsMatch(this.email, this.emailValidationExpression))
                            {
                                @* Was <asp:RegularExpressionValidator ID="valEmailValid"> whose
                                   ValidationExpression OnLoad set to Globals.glbEmailRegEx. *@
                                <span id="valEmailValid" class="dnnFormMessage dnnFormError dnnRequired">@this.LocalizeString("Email.Invalid")</span>
                            }
                        </div>
                    </div>
                </div>

                <div id="websiteInfo" class="dnnForm">
                    <DotNetNuke.UI.UserControls.LabelControl ID="lblWebsiteInfo" CssClass="tabSubTitle" ResourceKey="WebsiteInfo" LocalResourceFile="@LocalResourceFileName" />
                    <div class="dnnFormItem">
                        <div class="dnnFormItem">
                            <DotNetNuke.UI.UserControls.LabelControl ID="lblWebsiteName" ControlName="txtWebsiteName" ResourceKey="WebsiteName" CssClass="dnnFormRequired" LocalResourceFile="@LocalResourceFileName" />
                            <input id="txtWebsiteName" type="text" value="@this.websiteName" @onchange="e => this.websiteName = e.Value?.ToString()" />
                            @if (this.showValidation && string.IsNullOrEmpty(this.websiteName))
                            {
                                <span id="valWebsiteName" class="dnnFormMessage dnnFormError dnnRequired">@this.LocalizeString("WebsiteName.Required")</span>
                            }
                        </div>
                        <div class="dnnFormItem">
                            <DotNetNuke.UI.UserControls.LabelControl ID="lblWebsiteSsl" ControlName="chkWebsiteSsl" ResourceKey="WebsiteSsl" LocalResourceFile="@LocalResourceFileName" />
                            <input id="chkWebsiteSsl" type="checkbox" checked="@this.websiteSsl" @onchange="e => this.websiteSsl = Convert.ToBoolean(e.Value)" />
                        </div>
                        <div class="dnnFormItem">
                            <DotNetNuke.UI.UserControls.LabelControl ID="lblTemplate" ControlName="templateList" ResourceKey="WebsiteTemplate" LocalResourceFile="@LocalResourceFileName" />
                            @* Was <dnn:DnnComboBox id="templateList">, bound in BindTemplates(). *@
                            <select id="templateList" @bind="this.template">
                                @foreach (var item in this.templateList)
                                {
                                    <option value="@item.Value">@item.Text</option>
                                }
                            </select>
                        </div>
                        @if (this.SupportLocalization)
                        {
                            @* Was <div id="languagesRow" runat="server">, hidden by OnPreRender when
                               installConfig.SupportLocalization was false. *@
                            <div id="languagesRow" class="dnnFormItem">
                                <DotNetNuke.UI.UserControls.LabelControl ID="lblLanguage" ControlName="languageList" ResourceKey="Language" LocalResourceFile="@LocalResourceFileName" />
                                <select id="languageList" @onchange="this.LanguageListChanged">
                                    @foreach (var item in this.languageList)
                                    {
                                        <option value="@item.Value" selected="@(item.Value == this.language)">@item.Text</option>
                                    }
                                </select>
                                <br />
                                @* Replaces LegacyLangaugePack()/ClearLegacyLangaugePack(), which set this
                                   label from the selected pack's version. *@
                                <span id="lblLegacyLangaugePack" class="NormalBold">@this.legacyLanguagePackMessage</span>
                            </div>
                        }
                    </div>
                </div>

                <div id="databaseInfo" class="dnnForm">
                    <DotNetNuke.UI.UserControls.LabelControl ID="lblDatabaseInfo" CssClass="tabSubTitle" ResourceKey="DatabaseInfo" LocalResourceFile="@LocalResourceFileName" />
                    <div>
                        <span id="lblDatabaseInfoMsg" class="databaseCheck promptMessage NormalBold @(this.databaseCheckFailed ? "promptMessageError" : null)">@this.databaseInfoMessage</span>
                    </div>
                    <div class="dnnFormItem">
                        <div class="dnnFormItem">
                            <DotNetNuke.UI.UserControls.LabelControl ID="lblDatabaseSetup" ControlName="databaseSetupType" ResourceKey="DatabaseSetup" LocalResourceFile="@LocalResourceFileName" />
                            <span id="databaseSetupType">
                                <label>
                                    <input type="radio" name="databaseSetupType" value="standard" disabled="@this.standardDatabaseDisabled"
                                           checked="@(this.databaseSetup == "standard")" @onchange="this.SetDatabaseSetupStandard" />
                                    @this.LocalizeString("DatabaseStandard")
                                </label>
                                <label>
                                    <input type="radio" name="databaseSetupType" value="advanced"
                                           checked="@(this.databaseSetup == "advanced")" @onchange="this.SetDatabaseSetupAdvanced" />
                                    @this.LocalizeString("DatabaseAdvanced")
                                </label>
                            </span>
                        </div>
                        @if (this.showStandardDatabaseMessage)
                        {
                            <div id="StandardDatabaseMsg" class="dnnFormItem">
                                <div class="dnnLabel"></div>
                                <span id="lblStandardDatabaseMsg" class="dnnFormMessage">@this.LocalizeString("StandardDatabaseMsg")</span>
                            </div>
                        }
                        @if (this.databaseSetup == "advanced")
                        {
                            @* Was #advancedDatabase, slid in/out by toggleAdvancedDatabase(). *@
                            <div id="advancedDatabase" class="dnnFormItem">
                                <div class="dnnFormItem">
                                    <DotNetNuke.UI.UserControls.LabelControl ID="lblDatabaseType" ControlName="databaseType" ResourceKey="DatabaseType" LocalResourceFile="@LocalResourceFileName" />
                                    <span id="databaseType">
                                        <label>
                                            <input type="radio" name="databaseType" value="express" checked="@(this.databaseType == "express")" @onchange="this.SetDatabaseTypeExpress" />
                                            @this.LocalizeString("SqlTypeExpress")
                                        </label>
                                        <label>
                                            <input type="radio" name="databaseType" value="server" checked="@(this.databaseType == "server")" @onchange="this.SetDatabaseTypeServer" />
                                            @this.LocalizeString("SqlTypeServer")
                                        </label>
                                    </span>
                                </div>
                                <div class="dnnFormItem">
                                    <DotNetNuke.UI.UserControls.LabelControl ID="lblDatabaseServerName" ControlName="txtDatabaseServerName" ResourceKey="DatabaseServer" CssClass="dnnFormRequired" LocalResourceFile="@LocalResourceFileName" />
                                    <input id="txtDatabaseServerName" type="text" value="@this.databaseServerName" @onchange="e => this.databaseServerName = e.Value?.ToString()" />
                                    @if (this.showValidation && string.IsNullOrEmpty(this.databaseServerName))
                                    {
                                        <span id="valDatabaseServerName" class="dnnFormMessage dnnFormError dnnRequired">@this.LocalizeString("DatabaseServer.Required")</span>
                                    }
                                </div>
                                @if (this.databaseType == "express")
                                {
                                    @* Was #databaseFilename / #databaseName, toggled by toggleDatabaseType(). *@
                                    <div class="dnnFormItem" id="databaseFilename">
                                        <DotNetNuke.UI.UserControls.LabelControl ID="lblDatabaseFilename" ControlName="txtDatabaseFilename" ResourceKey="DatabaseFilename" CssClass="dnnFormRequired" LocalResourceFile="@LocalResourceFileName" />
                                        <input id="txtDatabaseFilename" type="text" value="@this.databaseFilename" @onchange="e => this.databaseFilename = e.Value?.ToString()" />
                                        @if (this.showValidation && string.IsNullOrEmpty(this.databaseFilename))
                                        {
                                            <span id="valDatabaseFilename" class="dnnFormMessage dnnFormError dnnRequired">@this.LocalizeString("DatabaseFilename.Required")</span>
                                        }
                                    </div>
                                }
                                else
                                {
                                    <div class="dnnFormItem" id="databaseName">
                                        <DotNetNuke.UI.UserControls.LabelControl ID="lblDatabaseName" ControlName="txtDatabaseName" ResourceKey="DatabaseName" CssClass="dnnFormRequired" LocalResourceFile="@LocalResourceFileName" />
                                        <input id="txtDatabaseName" type="text" value="@this.databaseName" @onchange="e => this.databaseName = e.Value?.ToString()" />
                                        @if (this.showValidation && string.IsNullOrEmpty(this.databaseName))
                                        {
                                            <span id="valDatabaseName" class="dnnFormMessage dnnFormError dnnRequired">@this.LocalizeString("DatabaseName.Required")</span>
                                        }
                                    </div>
                                }

                                @if (this.databaseType != "express")
                                {
                                    @* Was #dbSecurityTypeRow, hidden for SQL Express by toggleDatabaseType(). *@
                                    <div id="dbSecurityTypeRow" class="dnnFormItem">
                                        <DotNetNuke.UI.UserControls.LabelControl ID="lblDatabaseSecurity" ControlName="databaseSecurityType" ResourceKey="DatabaseSecurity" LocalResourceFile="@LocalResourceFileName" />
                                        <span id="databaseSecurityType">
                                            <label>
                                                <input type="radio" name="databaseSecurityType" value="integrated" checked="@(this.databaseSecurity == "integrated")" @onchange="this.SetDatabaseSecurityIntegrated" />
                                                @this.LocalizeString("DbSecurityIntegrated")
                                            </label>
                                            <label>
                                                <input type="radio" name="databaseSecurityType" value="userDefined" checked="@(this.databaseSecurity == "userDefined")" @onchange="this.SetDatabaseSecurityUserDefined" />
                                                @this.LocalizeString("DbSecurityUserDefined")
                                            </label>
                                        </span>
                                    </div>
                                }
                                @if (this.databaseType != "express" && this.databaseSecurity == "userDefined")
                                {
                                    <div id="securityUserDefined" class="dnnFormItem" style="padding-top: 5px;">
                                        <div class="dnnFormItem">
                                            <DotNetNuke.UI.UserControls.LabelControl ID="lblDatabaseUsername" ControlName="txtDatabaseUsername" ResourceKey="DatabaseUsername" CssClass="dnnFormRequired" LocalResourceFile="@LocalResourceFileName" />
                                            <input id="txtDatabaseUsername" type="text" value="@this.databaseUsername" @onchange="e => this.databaseUsername = e.Value?.ToString()" />
                                            @if (this.showValidation && string.IsNullOrEmpty(this.databaseUsername))
                                            {
                                                <span id="valDatabaseUsername" class="dnnFormMessage dnnFormError dnnRequired">@this.LocalizeString("DatabaseUsername.Required")</span>
                                            }
                                        </div>
                                        <div class="dnnFormItem">
                                            <DotNetNuke.UI.UserControls.LabelControl ID="lblDatabasePassword" ControlName="txtDatabasePassword" ResourceKey="DatabasePassword" LocalResourceFile="@LocalResourceFileName" />
                                            <input id="txtDatabasePassword" type="password" value="@this.databasePassword" @onchange="e => this.databasePassword = e.Value?.ToString()" />
                                        </div>
                                    </div>
                                }
                                <div class="dnnFormItem">
                                    <DotNetNuke.UI.UserControls.LabelControl ID="lblDatabaseRunAs" ControlName="databaseRunAs" ResourceKey="DatabaseRunAs" LocalResourceFile="@LocalResourceFileName" />
                                    @* For SQL Express the original forced this checked and disabled. *@
                                    <input id="databaseRunAs" type="checkbox" disabled="@(this.databaseType == "express")"
                                           checked="@(this.databaseType == "express" || this.databaseRunAsOwner)"
                                           @onchange="e => this.databaseRunAsOwner = Convert.ToBoolean(e.Value)" />
                                </div>
                            </div>
                        }
                        @if (!string.IsNullOrEmpty(this.databaseError))
                        {
                            <div id="databaseError" class="dnnFormItem">
                                <DotNetNuke.UI.UserControls.LabelControl ID="lblDatabaseConnectionError" ResourceKey="DatabaseConnectionError" LocalResourceFile="@LocalResourceFileName" />
                                <span id="lblDatabaseError" class="NormalRed">@((MarkupString)this.databaseError)</span>
                            </div>
                        }
                    </div>
                </div>
                <hr />
                <ul class="dnnForm dnnActions dnnClear">
                    <li>
                        <a id="continueLink" href="javascript:void(0);"
                           class="dnnPrimaryAction @(this.ContinueEnabled ? null : "dnnDisabledAction")"
                           @onclick="this.ContinueAsync" @onclick:preventDefault="true">@this.LocalizeString("cmdContinue")</a>
                    </li>
                </ul>
            </div>
        }

        @if (this.step == WizardStep.Installation || this.step == WizardStep.ViewWebsite)
        {
            <div class="installInstallation dnnClear" id="installInstallation">
                <span id="lblInstallationIntroInfo" class="installIntro">
                    @(this.installationComplete ? this.LocalizeString("InstallationComplete") : this.LocalizeString("InstallationIntroInfo"))
                </span>
                <div id="installInstallationPanel" class="dnnForm ui-tabs-panel">
                    <div class="dnnFormItem">
                        <div id="installation-progress">
                            <span id="timer">@this.ElapsedText</span>&nbsp;&nbsp;&nbsp;|&nbsp;&nbsp;&nbsp;<span id="percentage" style="height: auto; max-height: 200px; overflow: auto">@this.progress% @this.progressDetails</span>
                            <div class="dnnProgressbar">
                                <progress id="progressbar" class="@(this.installationFailed ? "stoppedProgress" : "inProgress")" value="@this.progress" max="100"></progress>
                            </div>
                            <div id="installation-buttons">
                                <a id="retry" href="javascript:void(0)" class="dnnPrimaryAction @(this.RetryEnabled ? null : "dnnDisabledAction")"
                                   @onclick="this.RetryAsync" @onclick:preventDefault="true">@this.LocalizeString("Retry")</a>
                                <a id="seeLogs" href="javascript:void(0)" class="dnnSecondaryAction @(this.SeeLogsEnabled ? null : "dnnDisabledAction")"
                                   @onclick="this.SeeLogsAsync" @onclick:preventDefault="true">@this.LocalizeString("SeeLogs")</a>
                                <a id="visitSite" href="javascript:void(0)" class="dnnPrimaryAction visitSiteLink @(this.VisitSiteEnabled ? null : "dnnDisabledAction")"
                                   @onclick="this.VisitSiteClick" @onclick:preventDefault="true">@this.LocalizeString("VisitWebsite")</a>
                            </div>
                            <hr />
                            @if (this.showInstallationLog)
                            {
                                <div id="installation-log-container" class="dnnScroll">
                                    <div id="installation-log">@((MarkupString)this.installationLog)</div>
                                </div>
                            }
                        </div>
                        @* Was #installation-steps, whose five <p> classes $.applyCssStyle() set from
                           the status file's check0..check4 values. Same mapping, server side. *@
                        <div id="installation-steps">
                            <p class="@StepCssClass(this.check0)" id="FileAndFolderPermissionCheck"><span class="states-icons"></span>@this.LocalizeString("FileAndFolderPermissionCheck")</p>
                            <p class="@StepCssClass(this.check1)" id="DatabaseInstallation"><span class="states-icons"></span>@this.LocalizeString("DatabaseInstallation")</p>
                            <p class="@StepCssClass(this.check2)" id="ExtensionsInstallation"><span class="states-icons"></span>@this.LocalizeString("ExtensionsInstallation")</p>
