    /// <summary>Replaces <c>CreateTelerikInstalledDetectedParagraph(Version)</c>: a &lt;p&gt; with the message, a space and the version in a <c>telerikVersion</c> span.</summary>
    private static RenderFragment CreateTelerikInstalledDetectedParagraph(Version version) => builder =>
    {
        builder.OpenElement(0, "p");
        builder.OpenElement(1, "span");
        builder.AddContent(2, LocalizeStringStatic("TelerikInstalledDetected"));
        builder.CloseElement();
        builder.AddContent(3, " ");
        builder.OpenElement(4, "span");
        builder.AddAttribute(5, "class", "telerikVersion");
        builder.AddContent(6, version.ToString());
        builder.CloseElement();
        builder.CloseElement();
    };

    /// <summary>Replaces <c>CreateBundle(params Control[])</c>: the <c>PlaceHolder</c> that grouped fragments without emitting a wrapper.</summary>
    private static RenderFragment CreateBundle(params RenderFragment[] fragments) => builder =>
    {
        var sequence = 0;
        foreach (var fragment in fragments)
        {
            if (fragment == null)
            {
                continue;
            }

            builder.OpenRegion(sequence++);
            builder.AddContent(0, fragment);
            builder.CloseRegion();
        }
    };

    /// <summary>Replaces <c>CreateHeading(string)</c>.</summary>
    private static RenderFragment CreateHeading(string localizationKey) => CreateLabel("h4", localizationKey);

    /// <summary>Replaces <c>CreateParagraph(string)</c>.</summary>
    private static RenderFragment CreateParagraph(string localizationKey) => CreateLabel("p", localizationKey);

    /// <summary>Replaces <c>CreateLabel(string tag, string localizationKey)</c>: the given tag wrapping a localized label.</summary>
    private static RenderFragment CreateLabel(string tag, string localizationKey) => builder =>
    {
        builder.OpenElement(0, tag);
        builder.OpenElement(1, "span");
        builder.AddContent(2, LocalizeStringStatic(localizationKey));
        builder.CloseElement();
        builder.CloseElement();
    };

    /// <summary>Replaces <c>CreateHiddenField(string id, string value)</c>.</summary>
    /// <remarks>
    /// The id matters: <see cref="RunUpgrade"/> reads the anti-forgery token and the uninstall
    /// option out of the account dictionary by exactly these names.
    /// </remarks>
    private static RenderFragment CreateHiddenField(string id, string value) => builder =>
    {
        builder.OpenElement(0, "input");
        builder.AddAttribute(1, "type", "hidden");
        builder.AddAttribute(2, "id", id);
        builder.AddAttribute(3, "name", id);
        builder.AddAttribute(4, "value", value);
        builder.CloseElement();
    };

    /// <summary>Replaces <c>CreateTable(IEnumerable&lt;string&gt; items, int maxRows, int maxColumns)</c>.</summary>
    /// <remarks>
    /// Same layout rules as the WebForms <c>Table</c>/<c>BulletedList</c> tree: one row, a new
    /// column every <paramref name="maxRows"/> items, at most
    /// <paramref name="maxRows"/>&#215;<paramref name="maxColumns"/>&#160;-&#160;1 items taken, a
    /// trailing "..." when there were more, equal column widths and a 100% wide table.
    /// </remarks>
    private static RenderFragment CreateTable(IEnumerable<string> items, int maxRows, int maxColumns) => builder =>
    {
        var capacity = maxRows * maxColumns;

        // StartNewColumn(row) built a TableCell containing a BulletedList and appended it to the
        // row; here the columns are built up first and then rendered, which is the same shape.
        var columns = new List<List<string>>();
        var current = new List<string>();
        columns.Add(current);

        foreach (var extension in items.Take(capacity - 1))
        {
            current.Add(extension);

            if (current.Count == maxRows)
            {
                current = new List<string>();
                columns.Add(current);
            }
        }

        if (capacity < items.Count())
        {
            current.Add("...");
        }

        var width = (100.0 / columns.Count).ToString("0.####", CultureInfo.InvariantCulture) + "%";

        builder.OpenElement(0, "table");
        builder.AddAttribute(1, "style", "width:100%");
        builder.OpenElement(2, "tr");

        var sequence = 3;
        foreach (var column in columns)
        {
            builder.OpenRegion(sequence++);
            builder.OpenElement(0, "td");
            builder.AddAttribute(1, "style", $"vertical-align:top;width:{width}");
            builder.OpenElement(2, "ul");

            var itemSequence = 3;
            foreach (var item in column)
            {
                builder.OpenRegion(itemSequence++);
                builder.OpenElement(0, "li");
                builder.AddContent(1, item);
                builder.CloseElement();
                builder.CloseRegion();
            }

            builder.CloseElement();
            builder.CloseElement();
            builder.CloseRegion();
        }

        builder.CloseElement();
        builder.CloseElement();
    };

    /// <summary>Replaces <c>RenderControls(params Control[])</c>.</summary>
    /// <remarks>
    /// The original wrapped its arguments in a bundle and then flattened the bundle to an HTML
    /// string with an <c>HtmlTextWriter</c>. There is nothing left to flatten: the bundle IS the
    /// renderable value, so this is just <see cref="CreateBundle"/>.
    /// </remarks>
    private static RenderFragment RenderControls(params RenderFragment[] fragments) => CreateBundle(fragments);

    /// <summary>Renders a literal markup fragment, replacing <c>new Literal { Text = "&lt;br /&gt;" }</c>.</summary>
    private static RenderFragment CreateLineBreak() => builder => builder.OpenElement(0, "br");

