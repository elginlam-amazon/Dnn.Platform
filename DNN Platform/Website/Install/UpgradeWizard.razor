    /// <summary>Replaces the <c>continueLink</c> click handler.</summary>
    private async Task ContinueAsync()
    {
        if (!this.continueEnabled)
        {
            return;
        }

        this.accountInfo["username"] = this.userName ?? string.Empty;
        this.accountInfo["password"] = this.password ?? string.Empty;

        this.continueEnabled = false;

        var result = await Task.Run(() => ValidateInput(this.accountInfo));
        if (result.Item1)
        {
            this.accountInfoError = null;
            this.ShowSecurityTab();
        }
        else
        {
            this.accountInfoError = result.Item2;
            this.continueEnabled = true;
        }
    }

    /// <summary>Replaces <c>upgradeWizard.showSecurityTab</c> and its <c>GetSecurityTab</c> call.</summary>
    private void ShowSecurityTab()
    {
        this.step = WizardStep.Security;

        var result = GetSecurityTab(this.accountInfo);
        if (result.Item1)
        {
            this.securityError = null;
            this.securityTab = result.Item3;

            // The hidden fields the view renders carry the token and the uninstall default; the
            // account dictionary is populated with them here so that RunUpgrade finds them, which
            // is what the client script did by reading the rendered inputs.
            this.accountInfo[TelerikAntiForgeryTokenClientID] = CreateTelerikAntiForgeryToken(this.Cryptography);
            this.accountInfo[TelerikUninstallOptionClientID] = this.DefaultUninstallOption();
        }
        else
        {
            this.securityError = result.Item2;
            this.step = WizardStep.AccountInfo;
            this.continueEnabled = true;
        }
    }

    /// <summary>Determines the uninstall option the security tab defaults to, mirroring the four branches of <see cref="GetSecurityTab"/>.</summary>
    private string DefaultUninstallOption()
    {
        var telerikUtils = CreateTelerikUtils();
        if (!telerikUtils.TelerikIsInstalled())
        {
            return OptionNo;
        }

        var version = telerikUtils.GetTelerikVersion();
        return telerikUtils.IsTelerikVersionVulnerable(version)
            ? DotNetNuke.Maintenance.Constants.TelerikUninstallYesValue
            : DotNetNuke.Maintenance.Constants.TelerikUninstallNoValue;
    }

    /// <summary>Replaces the <c>UpgradeNowButton</c> click handler.</summary>
    private async Task UpgradeNowAsync()
    {
        if (!this.UpgradeNowEnabled)
        {
