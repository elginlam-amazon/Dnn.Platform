    /// <summary>Maps a status-file step state to its CSS class. Replaces <c>$.applyCssStyle</c>.</summary>
    private static string StepCssClass(string state)
    {
        if (string.IsNullOrEmpty(state))
        {
            state = string.Empty;
        }

        switch (state.ToLowerInvariant())
        {
            case "done":
                return "step-done";
            case "running":
                return "step-running";
            case "error":
                return "step-error";
            default:
                return "step-notstarted";
        }
    }

    // =================================================================================
    // The programmatic control builders, as RenderFragments.
    //
    // Each one corresponds 1:1 to the method of the same name in UpgradeWizard.aspx.cs and
    // produces the same element shape - but as real markup in the render tree instead of a
    // WebForms control flattened into an HTML string by RenderControls/HtmlTextWriter.
    // =================================================================================

    /// <summary>Replaces <c>CreateTelerikInstalledHeader(Version)</c>.</summary>
    private static RenderFragment CreateTelerikInstalledHeader(Version version) =>
        CreateBundle(
            CreateHeading("TelerikInstalledHeading"),
