    /// <summary>Handles an unhandled error on this page.</summary>
    /// <param name="exc">The exception.</param>
    /// <param name="statusCode">The status code the exception maps to.</param>
    /// <remarks>
    /// Replaces <c>OnError</c>, which did
    /// <c>Response.Clear(); Server.Transfer("~/ErrorPage.aspx")</c>. <c>Server.Transfer</c> has no
    /// ASP.NET Core counterpart and the error page is a routed component now, so the browser is
    /// sent to it; the URL comes from the <c>CustomErrors:ErrorPagePath</c> key, which keeps it in
    /// step with that route.
    /// </remarks>
    protected override void HandleError(Exception exc, int statusCode)
    {
        this.Navigation.NavigateTo(Globals.ResolveUrl(DotNetNuke.Common.ErrorPage.Path), forceLoad: true);
    }

    /// <inheritdoc />
    protected override void OnInit(EventArgs e)
    {
        base.OnInit(e);

        if (Upgrade.Upgrade.UpdateNewtonsoftVersion())
        {
            // Was this.Response.Redirect(this.Request.RawUrl, true): re-request so the application
            // restarts with the updated assembly.
            this.Navigation.NavigateTo(this.RawUrl(), forceLoad: true);
            return;
        }

        this.SslRequiredCheck();
        GetInstallerLocales(this.ApplicationStatus);
    }

    /// <inheritdoc />
    protected override void OnLoad(EventArgs e)
    {
        if (InstallBlocker.Instance.IsInstallInProgress())
        {
            // Preserved guard: a running install owns the process, so the operator is sent to the
            // installer's streamed progress page instead.
            this.Navigation.NavigateTo(Globals.ResolveUrl("~/Install/install.aspx"), forceLoad: true);
            return;
        }

        base.OnLoad(e);
        this.LocalizePage();

        if (this.Complete != null)
        {
            // Was this.Request.RawUrl.EndsWith("?complete").
            this.CompleteUpgrade();
            return;
        }

        // Create Status Files
        // Was `if (!this.Page.IsPostBack)`: there are no postbacks, so the first initialization of
        // the component instance is the former "not a postback".
        if (!this.loaded)
        {
            this.loaded = true;

            if (!File.Exists(StatusFile))
            {
                File.CreateText(StatusFile).Close();
            }

            Upgrade.Upgrade.RemoveInvalidAntiForgeryCookie();
        }
    }

