        this.step = WizardStep.Upgrade;
        await this.UpgradeAsync();
    }

    /// <summary>Replaces <c>upgradeWizard.upgrade()</c>: starts the upgrade and the progress bar.</summary>
    private async Task UpgradeAsync()
    {
        this.upgradeComplete = false;
        this.upgradeFailed = false;
        this.progress = 0;
        this.progressDetails = string.Empty;
        this.StartProgressReporting();
        this.StateHasChanged();

        var info = new Dictionary<string, string>(this.accountInfo);

        // Call the page method which triggers the long running operation, off the circuit's thread
        // so the UI keeps rendering progress - which is what the AJAX call achieved.
        await Task.Run(() =>
        {
            try
            {
                RunUpgrade(info);
            }
            catch (Exception ex)
            {
                CurrentStepActivity(Localization.GetString("ErrorInStep", localResourceFile) + ": " + ex.Message);
            }
        });
    }

    /// <summary>Replaces the <c>retry</c> click handler.</summary>
    private async Task RetryAsync()
    {
        if (!this.RetryEnabled)
        {
            return;
        }

        this.showInstallationLog = false;
        await this.UpgradeAsync();
    }

    /// <summary>Replaces the <c>seeLogs</c> click handler and its <c>GetInstallationLog</c> polling.</summary>
    private async Task SeeLogsAsync()
    {
        if (!this.SeeLogsEnabled)
        {
            return;
        }

        this.showInstallationLog = true;
        this.installationLog = this.LocalizeString("LoadingInstallationLog");
        this.installationLogStartLine = 0;
        this.StateHasChanged();

        var builder = new StringBuilder();
        while (true)
        {
            var chunk = await Task.Run(() => GetInstallationLog(this.installationLogStartLine) as string);
            if (string.IsNullOrEmpty(chunk))
            {
                break;
            }

            builder.Append(chunk);
            this.installationLogStartLine += 500;
            this.installationLog = builder.ToString();
            this.StateHasChanged();
        }

        if (builder.Length == 0)
        {
            this.installationLog = this.LocalizeString("NoInstallationLog");
        }
    }

    /// <summary>Replaces the <c>visitSite</c> link, whose href was <c>location.pathname + "?complete"</c>.</summary>
    private Task VisitSiteAsync()
    {
        if (!this.VisitSiteEnabled)
        {
            return Task.CompletedTask;
        }

        this.Navigation.NavigateTo(Globals.ResolveUrl("~/Install/UpgradeWizard.aspx") + "?complete", forceLoad: true);
        return Task.CompletedTask;
    }

    /// <summary>Starts the server-side progress loop that replaces the browser's 500ms poll.</summary>
    private void StartProgressReporting()
    {
        if (this.progressCancellation != null)
        {
            return;
        }

        this.progressStartedUtc = DateTime.UtcNow;
        this.progressCancellation = new CancellationTokenSource();
        var token = this.progressCancellation.Token;

        _ = Task.Run(async () =>
        {
            using var timer = new PeriodicTimer(TimeSpan.FromMilliseconds(500));
            try
            {
                while (await timer.WaitForNextTickAsync(token))
                {
                    await this.InvokeAsync(this.ReadStatus);
                    if (this.upgradeComplete || this.upgradeFailed)
                    {
                        break;
                    }
                }
            }
            catch (OperationCanceledException)
            {
                // The circuit went away.
            }
        });
    }

    /// <summary>Reads the upgrade status file and applies it. Replaces <c>$.updateProgressbar</c>.</summary>
    private void ReadStatus()
    {
        try
        {
            if (!File.Exists(StatusFile))
            {
                return;
            }

            string content;
            lock (StatusLock)
            {
                using var stream = new FileStream(StatusFile, FileMode.Open, FileAccess.Read, FileShare.ReadWrite);
                using var reader = new StreamReader(stream);
                content = reader.ReadToEnd();
            }

            var lines = content.Split('\n').Where(l => !string.IsNullOrWhiteSpace(l)).ToArray();
            if (lines.Length == 0)
            {
                return;
            }

            var status = Json.Deserialize<UpgradeStatus>(lines[lines.Length - 1]);
            if (status == null || status.Progress < this.progress)
            {
                return;
            }

            this.progress = status.Progress;
            this.progressDetails = status.Details ?? string.Empty;
            this.check0 = status.Check0;
            this.check1 = status.Check1;

            // The client matched the LOCALIZED "Error" string, not the literal word - preserved.
            var upgradeError = this.progressDetails.ToUpperInvariant()
                .IndexOf((this.LocalizeString("Error") ?? "ERROR").ToUpperInvariant(), StringComparison.Ordinal) > -1;

            if (upgradeError)
            {
                // The client walked check0/check1 and marked the step after the last completed one
                // as "Error"; same rule here.
                if (this.check0 == "Done")
                {
                    this.check1 = "Error";
                }
                else
                {
                    this.check0 = "Error";
                }
            }

            if (this.progress >= 100 || this.progressDetails == this.LocalizeString("UpgradeDone"))
            {
                // Was upgradeWizard.finishInstall().
                this.upgradeComplete = true;
                this.upgradeFailed = false;
                this.check0 = this.check1 = "Done";
                this.step = WizardStep.ViewWebsite;
            }
            else if (upgradeError)
            {
                this.upgradeFailed = true;
            }

            this.StateHasChanged();
        }
        catch (Exception)
        {
            // The client swallowed parse failures of a partially written status line; so does this.
        }
    }

    private void LocalizePage()
    {
        this.SetBrowserLanguage();

        // Was this.Page.Title, which is the <PageTitle> above reading the same key.
        if (Globals.FormatVersion(this.ApplicationVersion) == Globals.FormatVersion(this.CurrentVersion))
        {
            this.versionText = null;
            this.currentVersionText = null;
            this.versionsMatchText = this.LocalizeString("VersionsMatch");
            if (this.ApplicationStatus.IncrementalVersionExists(this.CurrentVersion))
            {
                this.versionsMatchText = this.LocalizeString("VersionsMatchButIncrementalExists");
            }
        }
        else
        {
            this.versionsMatchText = null;
            this.versionText = string.Format(this.LocalizeString("Version"), Globals.FormatVersion(this.ApplicationVersion));
            this.currentVersionText = string.Format(this.LocalizeString("CurrentVersion"), Globals.FormatVersion(this.CurrentVersion));
        }
    }

    private void SetBrowserLanguage()
    {
        string cultureCode;
        if (string.IsNullOrEmpty(culture))
        {
            cultureCode = TestableLocalization.Instance.BestCultureCodeBasedOnBrowserLanguages(supportedLanguages);
        }
        else
        {
            cultureCode = culture;
        }

        culture = cultureCode;

        Thread.CurrentThread.CurrentUICulture = new CultureInfo(cultureCode);
    }

    private void CompleteUpgrade()
    {
        // Delete the status file.
        try
        {
            File.Delete(StatusFile);
        }
        catch (Exception)
        {
            // Do nothing
        }

        // remove installwizard files added back by upgrade package
        Upgrade.Upgrade.DeleteInstallerFiles();

        Config.Touch(this.ApplicationStatus);
        this.Navigation.NavigateTo(Globals.ResolveUrl("~/Default.aspx"), forceLoad: true);
    }

    /// <summary>Redirects to HTTPS when the host requires SSL for the upgrade.</summary>
    /// <remarks>
    /// SECURITY CONTROL - preserved exactly: the same <c>UpgradeForceSsl</c> + not-secure
    /// condition, the same SslDomain resolution (fall back to the request host, strip a scheme
    /// prefix) and the same <c>https://{sslDomain}{RawUrl}</c> target.
    /// </remarks>
    private void SslRequiredCheck()
    {
        if (this.HostSettingsService.UpgradeForceSsl && !(this.Request?.IsHttps ?? false))
        {
            var sslDomain = this.HostSettingsService.SslDomain;
            if (string.IsNullOrEmpty(sslDomain))
            {
                sslDomain = this.Request.Host.Host;
            }
            else if (sslDomain.Contains("://"))
            {
                sslDomain = sslDomain.Substring(sslDomain.IndexOf("://") + 3);
            }

            var sslUrl = $"https://{sslDomain}{this.RawUrl()}";

            this.Navigation.NavigateTo(sslUrl, forceLoad: true);
        }
    }

    /// <summary>Replaces <c>HttpRequest.RawUrl</c>, which does not exist on ASP.NET Core.</summary>
    private string RawUrl()
    {
        var request = this.Request;
        return request == null
            ? Globals.ResolveUrl("~/Install/UpgradeWizard.aspx")
            : (request.PathBase + request.Path + request.QueryString).ToString();
    }

    /// <summary>The shape of a line of the upgrade status file written by <see cref="CurrentStepActivity"/>.</summary>
    private sealed class UpgradeStatus
    {
        [JsonProperty("progress")]
        public int Progress { get; set; }

        [JsonProperty("details")]
        public string Details { get; set; }

        [JsonProperty("check0")]
        public string Check0 { get; set; }

        [JsonProperty("check1")]
        public string Check1 { get; set; }
    }
}
