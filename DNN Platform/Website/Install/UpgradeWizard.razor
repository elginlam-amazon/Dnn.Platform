@*
    =====================================================================================
    The Upgrade Wizard.

    THE PROGRAMMATIC CONTROL BUILDERS ARE NOW RENDERFRAGMENTS.
    UpgradeWizard.aspx.cs built the Security tab's UI in code - CreateTelerikInstalledHeader,
    CreateTelerikInstalledDetectedParagraph, CreateBundle, CreateHeading, CreateParagraph,
    CreateLabel, CreateHiddenField, CreateTable(items, maxRows, maxColumns),
    StartNewColumn(row) - as a PlaceHolder/HtmlGenericControl/Label/Table/BulletedList tree, then
    flattened it with RenderControls(...) -> HtmlTextWriter -> a `string View`, which the client
    script injected with $('#upgradeSecurityView').html(...).

    Every one of those builders is reproduced below as a RenderFragment composing REAL markup
    (<h4>, <p>, <table>, <ul>, the hidden fields), never a concatenated string. Same element
    shapes, same CSS classes (telerikVersion), same 3x4 table layout with the same "..." overflow
    marker and the same equal column widths, same localization keys. The two hidden fields keep
    their exact ids - telerikAntiForgeryToken and the TelerikUninstallOptionSettingKey - because
    RunUpgrade reads the posted values by those names.

    WHAT REPLACED THE CLIENT SCRIPT
    As with the install wizard, the jQuery/jQuery-UI/PageMethods layer existed only because a
    WebForms page cannot call its own server code without a postback. On Blazor Server:
      * jQuery UI tabs (4 tabs)   -> the `step` field + @@if blocks.
      * PageMethods.ValidateInput / GetSecurityTab / RunUpgrade / GetInstallationLog
                                  -> @@onclick handlers calling the SAME static methods, which keep
                                     their original signatures as the page's API surface.
      * $.get("upgradestat...")   -> ReadStatusAsync(), a server-side 500ms loop over the same
                                     status file, which no longer has to be web-servable.
    No <script> is emitted from this component.

    THE TELERIK STRINGS ARE DETECTION MESSAGES. They belong to Dnn.Modules.TelerikRemoval and are
    read through ITelerikUtils; there is no Telerik UI control anywhere in this page, and none is
    introduced.
    =====================================================================================
*@

<PageTitle>@this.LocalizeString("Title")</PageTitle>

<HeadContent>
    @* Was the two <link class="needVer"> elements whose href the client script suffixed with the
       application version. The version is appended here, server side. *@
    <link rel="stylesheet" type="text/css" href="@($"{Globals.ResolveUrl("~/resources/Shared/stylesheets/dnndefault/10.0.0/default.css")}?{Globals.FormatVersion(this.ApplicationVersion)}")" />
    <link rel="stylesheet" type="text/css" href="@($"{Globals.ResolveUrl("~/install/Install.css")}?{Globals.FormatVersion(this.ApplicationVersion)}")" />
</HeadContent>

@* Was <div id="languageFlags">, hidden by showSecurityTab(). *@
@if (this.step == WizardStep.AccountInfo)
{
    <div id="languageFlags">
        @foreach (var flag in LanguageFlags)
        {
            <a class="flag @(culture == flag ? "selectedFlag" : null)" value="@flag" href="javascript:void(0);"
               @onclick="() => this.ChangePageLocale(flag)" @onclick:preventDefault="true">
                <img src="@Globals.ResolveUrl($"~/images/flags/{flag}.gif")" alt="@flag" class="flagimage" />
            </a>
        }
    </div>
}

<div class="install">
    <h2 class="dnnForm dnnInstall dnnClear">
        @this.LocalizeString("Title")
        @* LocalizePage() showed either the two version labels or the "versions match" label. *@
        <h5><span id="currentVersionLabel">@this.currentVersionText</span></h5>
        <h5><span id="versionLabel">@this.versionText</span></h5>
        <h5><span id="versionsMatch">@this.versionsMatchText</span></h5>
    </h2>
    <br />
    @* Was <div id="dnnInstall" runat="server">, hidden by showSecurityTab(). *@
    @if (this.step == WizardStep.AccountInfo)
    {
        <div class="dnnForm dnnInstall dnnClear" id="dnnInstall">
            <hr />
            <span id="lblIntroDetail">@this.LocalizeString("BestPractices")</span>
        </div>
    }

    <div id="tabs" class="dnnWizardTab">
        <ul>
            <li class="@(this.step == WizardStep.AccountInfo ? "ui-tabs-active ui-state-active" : null)">
                <div class="dnnWizardStep">
                    <span class="dnnWizardStepNumber">1</span>
                    <span class="dnnWizardStepTitle">@this.LocalizeString("AccountInfo")</span>
                    <span class="dnnWizardStepArrow"></span>
                </div>
            </li>
            <li class="@(this.step == WizardStep.Security ? "ui-tabs-active ui-state-active" : null)">
                <div class="dnnWizardStep">
                    <span class="dnnWizardStepNumber">2</span>
                    <span class="dnnWizardStepTitle">@this.LocalizeString("Security")</span>
                    <span class="dnnWizardStepArrow"></span>
                </div>
            </li>
            <li class="@(this.step == WizardStep.Upgrade ? "ui-tabs-active ui-state-active" : null)">
                <div class="dnnWizardStep">
                    <span class="dnnWizardStepNumber">3</span>
                    <span class="dnnWizardStepTitle">@this.LocalizeString("Upgrade")</span>
                    <span class="dnnWizardStepArrow"></span>
                </div>
            </li>
            <li class="@(this.step == WizardStep.ViewWebsite ? "ui-tabs-active ui-state-active" : null)">
                <div class="dnnWizardStep">
                    <span><img id="finishImage" src="@Globals.ResolveUrl("~/images/finishflag.png")" alt="" /></span>
                    <span class="dnnWizardStepTitle">@this.LocalizeString("ViewWebsite")</span>
                </div>
            </li>
        </ul>

        @if (this.step == WizardStep.AccountInfo)
        {
            <div class="upgradeAccountInfo dnnClear" id="upgradeAccountInfo">
                @if (!string.IsNullOrEmpty(this.accountInfoError))
                {
                    <span id="lblAccountInfoError" class="NormalRed" style="display:block">@this.accountInfoError</span>
                }
                <div class="dnnFormItem">
                    <label for="txtUsername" class="dnnFormRequired dnnLabel"><span id="lblUsername">@this.LocalizeString("Username")</span></label>
                    <input id="txtUsername" type="text" value="@this.userName" @onchange="e => this.userName = e.Value?.ToString()" />
                </div>
                <div class="dnnFormItem">
                    <label for="txtPassword" class="dnnFormRequired dnnLabel"><span id="lblPassword">@this.LocalizeString("Password")</span></label>
                    <input id="txtPassword" type="password" value="@this.password" @onchange="e => this.password = e.Value?.ToString()" />
                </div>
                <hr />
                <ul class="dnnForm dnnActions dnnClear">
                    <li>
                        @* enable("#continueLink") ran unconditionally on load, so this action starts enabled. *@
                        <a id="continueLink" href="javascript:void(0);"
                           class="dnnPrimaryAction @(this.continueEnabled ? null : "dnnDisabledAction")"
                           @onclick="this.ContinueAsync" @onclick:preventDefault="true">@this.LocalizeString("NextStep")</a>
                    </li>
                </ul>
            </div>
        }

        @if (this.step == WizardStep.Security)
        {
            <div class="upgradeSecurity dnnClear" id="upgradeSecurity">
                @if (!string.IsNullOrEmpty(this.securityError))
                {
                    <span id="lblSecurityError" class="NormalRed" style="display:block">@this.securityError</span>
                }
                <div id="upgradeSecurityView">
                    @if (this.securityTab?.View != null)
                    {
                        @* The RenderFragment that replaced SecurityTabResult.View's HTML string. *@
                        @this.securityTab.View
                    }
                    else
                    {
                        @* Was the inline "checking security" placeholder and its SVG spinner. *@
                        <span class="upgradeSecurityMessage">@this.LocalizeString("CheckingSecurity")</span>
                        <svg class="wizspinner" viewbox="0 0 50 50">
                            <circle class="path" cx="25" cy="25" r="20" fill="none" stroke-width="5"></circle>
                        </svg>
                    }
                </div>
                <hr />
                <ul class="dnnForm dnnActions dnnClear">
                    <li>
                        <a id="UpgradeNowButton" href="javascript:void(0);"
                           class="dnnPrimaryAction @(this.UpgradeNowEnabled ? null : "dnnDisabledAction")"
                           @onclick="this.UpgradeNowAsync" @onclick:preventDefault="true">@this.LocalizeString("Next")</a>
                    </li>
                </ul>
            </div>
        }

        @if (this.step == WizardStep.Upgrade || this.step == WizardStep.ViewWebsite)
        {
            <div class="upgradeInstallation dnnClear" id="upgradeInstallation">
                <span id="lblUpgradeIntroInfo" class="installIntro">@this.LocalizeString("UpgradeIntroInfo")</span>
                <div id="upgrade" class="dnnForm">
                    <div class="dnnFormItem">
                        <div id="installation-progress">
                            <span id="timer">@this.ElapsedText</span>&nbsp;&nbsp;&nbsp;|&nbsp;&nbsp;&nbsp;<span id="percentage" style="height: auto; max-height: 200px; overflow: auto">@this.progress% @this.progressDetails</span>
                            <div class="dnnProgressbar">
                                <progress id="progressbar" class="@(this.upgradeFailed ? "stoppedProgress" : "inProgress")" value="@this.progress" max="100"></progress>
                            </div>
                            <div id="installation-buttons">
                                <a id="retry" href="javascript:void(0)" class="dnnPrimaryAction @(this.RetryEnabled ? null : "dnnDisabledAction")"
                                   @onclick="this.RetryAsync" @onclick:preventDefault="true">@this.LocalizeString("Retry")</a>
                                <a id="seeLogs" href="javascript:void(0)" class="dnnSecondaryAction @(this.SeeLogsEnabled ? null : "dnnDisabledAction")"
                                   @onclick="this.SeeLogsAsync" @onclick:preventDefault="true">@this.LocalizeString("SeeLogs")</a>
                            </div>
                            @if (this.showInstallationLog)
                            {
                                <div id="installation-log-container" class="dnnScroll">
                                    <div id="installation-log">@((MarkupString)this.installationLog)</div>
                                </div>
                            }
                        </div>
                        @* Was #installation-steps; $.applyCssStyle() mapped check0/check1 onto these. *@
                        <div id="installation-steps">
                            <p class="@StepCssClass(this.check0)" id="DatabaseUpgrade"><span class="states-icons"></span>@this.LocalizeString("DatabaseUpgrade")</p>
                            <p class="@StepCssClass(this.check1)" id="ExtensionsUpgrade"><span class="states-icons"></span>@this.LocalizeString("ExtensionsUpgrade")</p>
                        </div>
                        <hr />
                        @* Was <asp:HyperLink ID="visitSite" NavigateUrl="#">, whose href finishInstall()
                           set to location.pathname + "?complete" - the URL CompleteUpgrade() handles. *@
                        <a id="visitSite" href="javascript:void(0)" class="dnnPrimaryAction visitSiteLink @(this.VisitSiteEnabled ? null : "dnnDisabledAction")"
                           @onclick="this.VisitSiteAsync" @onclick:preventDefault="true">@this.LocalizeString("VisitWebsite")</a>
                    </div>
                </div>
            </div>
        }
    </div>
</div>

@* The WebForms page ended with <asp:Label ID="txtErrorMessage" runat="server" />, which no code
   path on the page or in its client script ever assigned or read - it was a dead placeholder. The
   live error surfaces (accountInfoError / securityError) are preserved above, so neither the label
   nor its backing field is carried over. *@

@code {
    /// <summary>Client ID of the hidden input containing the Telerik anti-forgery token.</summary>
    protected static readonly string TelerikAntiForgeryTokenClientID = "telerikAntiForgeryToken";

    /// <summary>Client ID of the Telerik uninstall radio buttons.</summary>
    protected static readonly string TelerikUninstallOptionClientID = DotNetNuke.Maintenance.Constants.TelerikUninstallOptionSettingKey;

    /// <summary>Form value when user selects Yes.</summary>
    protected static readonly string OptionYes = "Y";

    /// <summary>Form value when user selects No.</summary>
    protected static readonly string OptionNo = "N";

    /// <summary>The upgrade status filename.</summary>
    /// <remarks>
    /// Still written by <see cref="CurrentStepActivity"/> under the same name; it is no longer
    /// fetched by the browser (Install/ is not web-served content now) - the component reads it.
    /// </remarks>
    protected static readonly string StatusFilename = "upgradestat.log.resources.txt";

    private const string LocalesFile = "/Install/App_LocalResources/Locales.xml";

    /// <summary>The flags rendered by the language selector, in the order the markup declared them.</summary>
    private static readonly string[] LanguageFlags = ["en-US", "de-DE", "es-ES", "fr-FR", "it-IT", "nl-NL", "tr-TR"];

    private static readonly ILogger Logger = DnnLoggingController.GetLogger(typeof(UpgradeWizard));
    private static string localResourceFile = "~/Install/App_LocalResources/UpgradeWizard.aspx.resx";
    private static string culture;
    private static string[] supportedLanguages;
    private static IInstallationStep currentStep;
    private static bool upgradeRunning;
    private static int upgradeProgress;

    // steps shown in UI
    private static IInstallationStep upgradeDatabase = new InstallDatabaseStep();
    private static IInstallationStep upgradeExtensions = new InstallExtensionsStep();
    private static IInstallationStep iisVerification = new IISVerificationStep();

    // Ordered List of Steps (and weight in percentage) to be executed
    private static IDictionary<IInstallationStep, int> steps = new Dictionary<IInstallationStep, int>
        {
        // {new AddFcnModeStep(), 1},
            { iisVerification, 1 },
            { upgradeDatabase, 49 },
            { upgradeExtensions, 49 },
            { new InstallVersionStep(), 1 },
        };

    private static readonly object StatusLock = new object();

    // --- UI state (replaces the control tree and the PageLocale hidden field) ---
    private WizardStep step = WizardStep.AccountInfo;
    private string userName = string.Empty;
    private string password = string.Empty;
    private bool continueEnabled = true;

    private string accountInfoError;
    private string securityError;
    private string versionText;
    private string currentVersionText;
    private string versionsMatchText;

    private SecurityTabResult securityTab;

    private int progress;
    private string progressDetails = string.Empty;
    private string check0;
    private string check1;
    private bool upgradeComplete;
    private bool upgradeFailed;
    private bool showInstallationLog;
    private string installationLog = string.Empty;
    private int installationLogStartLine;
    private DateTime? progressStartedUtc;
    private CancellationTokenSource progressCancellation;
    private bool loaded;

    /// <summary>The account information dictionary the page methods take.</summary>
    /// <remarks>
    /// Was `upgradeWizard.accountInfo`, the client-side object the handlers accumulated the
    /// username/password, the anti-forgery token and the uninstall option into before each
    /// PageMethods call. It is server state now, but it is still the same dictionary with the same
    /// keys, because ValidateInput/GetSecurityTab/RunUpgrade read it by those keys.
    /// </remarks>
    private readonly Dictionary<string, string> accountInfo = new Dictionary<string, string>();

    static UpgradeWizard()
    {
        IsAuthenticated = false;
    }

    /// <summary>Initializes a new instance of the <see cref="UpgradeWizard"/> class.</summary>
    /// <remarks>
    /// Blazor activates the component through its parameterless constructor. This declares it
    /// explicitly so it chains to the non-obsolete <see cref="DotNetNuke.Framework.PageBase"/> overload rather than the
    /// deprecated parameterless one; passing nulls is exactly what that deprecated overload did,
    /// and PageBase resolves each service lazily from the current service provider on first use.
    /// </remarks>
    public UpgradeWizard()
        : base(null, null, null, null)
    {
    }

    /// <summary>The wizard tabs, which jQuery UI used to enable/disable.</summary>
    private enum WizardStep
    {
        /// <summary>The <c>#upgradeAccountInfo</c> tab.</summary>
        AccountInfo,

        /// <summary>The <c>#upgradeSecurity</c> tab.</summary>
        Security,

        /// <summary>The <c>#upgradeInstallation</c> tab.</summary>
        Upgrade,

        /// <summary>The finish tab.</summary>
        ViewWebsite,
    }

    /// <summary>Gets or sets the application status.</summary>
    /// <remarks>
    /// This and the three properties below replace the five-overload constructor chain
    /// (<c>IPortalController</c>, <c>IApplicationStatusInfo</c>, <c>IHostSettings</c>,
    /// <c>IUserController</c>, <c>IApplicationInfo</c>, <c>ICryptographyProvider</c>) and its
    /// <c>GetRequiredService&lt;T&gt;()</c> fallbacks: Blazor activates a component through its
    /// parameterless constructor, so the dependencies are injected as properties.
    /// <see cref="DotNetNuke.Framework.PageBase"/> still resolves <c>IPortalController</c>/<c>IUserController</c>
    /// through the same lazy mechanism its own constructors used.
    /// </remarks>
    [Inject]
    protected IApplicationStatusInfo ApplicationStatus { get; set; }

    /// <summary>Gets or sets the host settings.</summary>
    [Inject]
    protected IHostSettings HostSettingsService { get; set; }

    /// <summary>Gets or sets the application info.</summary>
    [Inject]
    protected IApplicationInfo Application { get; set; }

    /// <summary>Gets or sets the cryptography provider.</summary>
    [Inject]
    protected ICryptographyProvider Cryptography { get; set; }

    /// <summary>Gets or sets the navigation manager used for the page's redirects.</summary>
    [Inject]
    protected Microsoft.AspNetCore.Components.NavigationManager Navigation { get; set; }

    /// <summary>Gets a value indicating whether the upgrade has been completed on this URL.</summary>
    /// <remarks>Replaces the <c>this.Request.RawUrl.EndsWith("?complete")</c> test.</remarks>
    [SupplyParameterFromQuery(Name = "complete")]
    private string Complete { get; set; }

    /// <summary>Gets the application version.</summary>
    protected Version ApplicationVersion => this.Application.Version;

    /// <summary>Gets the current version.</summary>
    protected Version CurrentVersion => this.Application.CurrentVersion;

    private static string StatusFile => Path.Combine(AppDomain.CurrentDomain.BaseDirectory, "Install", StatusFilename);

    private static bool IsAuthenticated { get; set; }

    /// <summary>Gets a value indicating whether the Upgrade Now action is enabled.</summary>
    /// <remarks>
    /// The client enabled it when the security tab reported CanProceed. It also attached a click
    /// handler to <c>input[name=&lt;TelerikUninstallOptionClientID&gt;]</c> to enable it, but the
    /// security view only ever rendered that name as a HIDDEN field (CreateHiddenField), so that
    /// handler could never fire - CanProceed is the only rule that ever applied, and it is the only
    /// one reproduced here.
    /// </remarks>
    private bool UpgradeNowEnabled => this.securityTab?.CanProceed ?? false;

    private bool RetryEnabled => this.upgradeFailed;

    private bool SeeLogsEnabled => this.upgradeFailed || this.upgradeComplete;

    private bool VisitSiteEnabled => this.upgradeComplete;

    /// <summary>Gets the elapsed time, replacing the JS timer that wrote into <c>#timer</c>.</summary>
    private string ElapsedText
    {
        get
        {
            var elapsed = this.progressStartedUtc.HasValue ? DateTime.UtcNow - this.progressStartedUtc.Value : TimeSpan.Zero;
            return $"{(int)elapsed.TotalMinutes}:{elapsed.Seconds:00} {this.LocalizeString("TimerMinutes")}";
        }
    }

    /// <summary>Validates the user input.</summary>
    /// <param name="accountInfo">The account information.</param>
    /// <returns>A tuple with the result and a message.</returns>
    /// <remarks>
    /// Was a <c>[WebMethod]</c> page method; the signature and body are unchanged because this IS
    /// the page's API surface. SECURITY CONTROL: it delegates to <see cref="VerifyHostUser"/>,
    /// which is preserved verbatim.
    /// </remarks>
    public static Tuple<bool, string> ValidateInput(Dictionary<string, string> accountInfo)
    {
        var result = VerifyHostUser(accountInfo, out var errorMsg);

        return new Tuple<bool, string>(result, errorMsg);
    }

    /// <summary>Gets the installation log.</summary>
    /// <param name="startRow">At which line to start obtaining log lines.</param>
    /// <returns>Log string from the provided line number forward.</returns>
    /// <remarks>
    /// SECURITY: the <c>IsAuthenticated</c> gate is preserved exactly - the installer log is only
    /// readable once a host user has authenticated through <see cref="VerifyHostUser"/>.
    /// </remarks>
    public static object GetInstallationLog(int startRow)
    {
        const int maxLines = 500;
        if (!IsAuthenticated)
        {
            return string.Empty;
        }

        var logFile = $"InstallerLog{DateTime.Now.Year}{DateTime.Now.Month}{DateTime.Now.Day}.resources";
        try
        {
            var lines = File.ReadAllLines(Path.Combine(AppDomain.CurrentDomain.BaseDirectory, "Portals", "_default", "logs", logFile));
            var sb = new StringBuilder();
            var errorLogged = false;
            var lineCount = 0;

            // Important to return empty string to stop retries.
            if (startRow > lines.Count())
            {
                return string.Empty;
            }

            for (var i = 0; i < lines.Length; i++)
            {
                if (lines[i].Contains("[ERROR]"))
                {
                    errorLogged = true;

                    // Only append if error is in current lines range.
                    if (i > startRow && lineCount < maxLines)
                    {
                        sb.Append(lines[i]).Append("<br />");
                        lineCount++;

                        // If we have reached the max lines, break out of loop.
                        if (lineCount >= maxLines)
                        {
                            break;
                        }
                    }
                }
            }

            if (!errorLogged)
            {
                return Localization.GetString("NoErrorsLogged", "~/Install/App_LocalResources/UpgradeWizard.aspx.resx");
            }

            return sb.ToString();
        }
        catch (Exception)
        {
            return string.Empty;
        }
    }

    /// <summary>Returns information to render the Security tab.</summary>
    /// <param name="accountInfo">Username and password to validate host user.</param>
    /// <returns>An instance of <see cref="SecurityTabResult"/>.</returns>
    /// <remarks>
    /// SECURITY CONTROL: the host-user verification gate and the four Telerik branches (not
    /// installed / installed-but-not-vulnerable / installed-but-unused / installed-and-used) are
    /// preserved exactly, in the same order, with the same uninstall-option default each branch
    /// chose. Only the rendering of the resulting view changed from a string to a
    /// <see cref="RenderFragment"/>.
    /// </remarks>
    public static Tuple<bool, string, SecurityTabResult> GetSecurityTab(Dictionary<string, string> accountInfo)
    {
        if (!VerifyHostUser(accountInfo, out var errorMsg))
        {
            return Tuple.Create(false, errorMsg, default(SecurityTabResult));
        }

        var cryptographyProvider = CreateCryptographyProvider();
        var telerikUtils = CreateTelerikUtils();
        if (!telerikUtils.TelerikIsInstalled())
        {
            return Tuple.Create(
                true,
                default(string),
                GetTelerikNotInstalledResult(cryptographyProvider));
        }

        var version = telerikUtils.GetTelerikVersion();
        if (!telerikUtils.IsTelerikVersionVulnerable(version))
        {
            return Tuple.Create(
                true,
                default(string),
                GetTelerikInstalledWithVersionNotKnownToBeVulnerable(cryptographyProvider, version));
        }

        var assemblies = telerikUtils.GetAssembliesThatDependOnTelerik()
            .Select(a => Path.GetFileName(a));

        if (!assemblies.Any())
        {
            return Tuple.Create(
                true,
                default(string),
                GetTelerikInstalledButNotUsedResult(cryptographyProvider, version));
        }

        return Tuple.Create(
            true,
            default(string),
            GetTelerikInstalledAndUsedResult(cryptographyProvider, assemblies, version));
    }

    /// <summary>Runs the upgrade.</summary>
    /// <param name="accountInfo">The account information.</param>
    /// <remarks>
    /// SECURITY CONTROL - preserved exactly, in the same order: (1) the host user must verify,
    /// (2) the Telerik anti-forgery token must be present and valid, (3) the uninstall option must
    /// be present. Each failure throws or returns before any upgrade work happens, and the
    /// InstallerFilesRemoved reset at the end (DNN-9355) is kept.
    /// </remarks>
    public static void RunUpgrade(Dictionary<string, string> accountInfo)
    {
        if (!VerifyHostUser(accountInfo, out _))
        {
            return;
        }

        var cryptograpyProvider = CreateCryptographyProvider();
        if (!TelerikAntiForgeryTokenIsValid(cryptograpyProvider, accountInfo))
        {
            throw new InvalidOperationException(LocalizeStringStatic("TelerikInvalidAntiForgeryToken"));
        }

        if (!accountInfo.TryGetValue(TelerikUninstallOptionClientID, out var option))
        {
            throw new InvalidOperationException(LocalizeStringStatic("TelerikUninstallOptionMissing"));
        }

        SetHostSetting(DotNetNuke.Maintenance.Constants.TelerikUninstallOptionSettingKey, option);

        upgradeRunning = false;
        LaunchUpgrade();

        // DNN-9355: reset the installer files check flag after each upgrade, to make sure the installer files removed.
        var hostSettingsService = Globals.GetCurrentServiceProvider().GetRequiredService<IHostSettingsService>();
        hostSettingsService.Update("InstallerFilesRemoved", "False", true);
    }

