<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <OutputPath>bin</OutputPath>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>DotNetNuke.Website</RootNamespace>
    <AssemblyName>DotNetNuke.Website</AssemblyName>
    <Deterministic>true</Deterministic>
    <LangVersion>latest</LangVersion>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <WarningsNotAsErrors>SA1600</WarningsNotAsErrors>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <!-- SolutionInfo.cs (linked below) supplies the shared assembly/version attributes, so the
         SDK must not generate its own and produce CS0579 duplicates. -->
    <GenerateAssemblyInfo>false</GenerateAssemblyInfo>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="../../DotNetNuke.Internal.SourceGenerators/DotNetNuke.Internal.SourceGenerators.csproj" ReferenceOutputAssembly="false" OutputItemType="Analyzer" />
    <ProjectReference Include="../DotNetNuke.Abstractions/DotNetNuke.Abstractions.csproj" />
    <ProjectReference Include="../DotNetNuke.ContentSecurityPolicy/DotNetNuke.ContentSecurityPolicy.csproj" />
    <ProjectReference Include="../DotNetNuke.Instrumentation/DotNetNuke.Instrumentation.csproj" />
    <ProjectReference Include="../DotNetNuke.Log4net/DotNetNuke.Log4Net.csproj" />
    <ProjectReference Include="../DotNetNuke.Maintenance/DotNetNuke.Maintenance.csproj" />
    <ProjectReference Include="../DotNetNuke.Web.Client.ResourceManager/DotNetNuke.Web.Client.ResourceManager.csproj" />
    <ProjectReference Include="../DotNetNuke.Web.Client/DotNetNuke.Web.Client.csproj" />
    <ProjectReference Include="../DotNetNuke.Web.Mvc/DotNetNuke.Web.Mvc.csproj" />
    <ProjectReference Include="../DotNetNuke.WebUtility/DotNetNuke.WebUtility.csproj" />
    <ProjectReference Include="../DotNetNuke.Web/DotNetNuke.Web.csproj" />
    <ProjectReference Include="../HttpModules/DotNetNuke.HttpModules.csproj" />
    <ProjectReference Include="../Library/DotNetNuke.Library.csproj" />
    <ProjectReference Include="../Modules/CoreMessaging/DotNetNuke.Modules.CoreMessaging.csproj" />
    <ProjectReference Include="../Modules/DDRMenu/DotNetNuke.Modules.DDRMenu.csproj" />
    <ProjectReference Include="../Syndication/DotNetNuke.Syndication.csproj" />
    <!-- The GeoIP-backed country list control is a Razor Class Library consumed by the host. -->
    <ProjectReference Include="../Controls/CountryListBox/CountryListBox.csproj" />
    <!-- Replaces the former file reference into ../Controls/DotNetNuke.WebControls/bin\. -->
    <ProjectReference Include="../Controls/DotNetNuke.WebControls/DotNetNuke.WebControls.csproj" />
    <!-- The simple web-farm caching provider is registered from Program.cs. -->
    <ProjectReference Include="../Providers/CachingProviders/DotNetNuke.Providers.Caching.SimpleWebFarmCachingProvider/DotNetNuke.Providers.Caching.SimpleWebFarmCachingProvider.csproj" />
    <!-- The Aperture skin is a Razor Class Library providing the default theme components. -->
    <ProjectReference Include="../Skins/Aperture/Dnn.Skins.Aperture.csproj" />
    <!-- The CKEditor HTML editor provider is a Razor Class Library: the host must reference it
         so that its routable components (Options.razor, Browser/Browser.razor) and its
         MapCKEditorProviderEndpoints() aggregator, both named from Program.cs, are available. -->
    <ProjectReference Include="../Providers/HtmlEditorProviders/DNNConnect.CKE/DNNConnect.CKEditorProvider.csproj" />
    <!-- The Google Mail SMTP OAuth provider is a Razor Class Library: the host must reference it
         so that its routable component (Authorize.razor, the Google OAuth callback URL
         /Providers/SmtpOAuthProviders/GoogleMail/Authorize.aspx) named from Program.cs is
         available. -->
    <ProjectReference Include="../Providers/SmtpOAuthProviders/GoogleMailAuthProvider/Dnn.GoogleMailAuthProvider.csproj" />
    <!-- The Exchange Online SMTP OAuth provider is a Razor Class Library: the host must reference
         it so that its routable component (Authorize.razor, the Microsoft Entra OAuth callback
         URL /Providers/SmtpOAuthProviders/ExchangeOnline/Authorize.aspx) named from Program.cs is
         available. -->
    <ProjectReference Include="../Providers/SmtpOAuthProviders/ExchangeOnlineAuthProvider/Dnn.ExchangeOnlineAuthProvider.csproj" />
  </ItemGroup>

  <ItemGroup>
    <AdditionalFiles Include="../../stylecop.json" Link="stylecop.json" />
    <Compile Include="../../SolutionInfo.cs" Link="Properties/SolutionInfo.cs" />
  </ItemGroup>

  <!-- Runtime data trees that are NOT web-served and therefore do not move to wwwroot/.
       The SDK already globs **/*.config and **/*.json as Content, so those extensions are
       excluded here and given their copy metadata through Update to avoid duplicate items. -->
  <ItemGroup>
    <Content Include="App_Data/**/*" Exclude="App_Data/**/*.config;App_Data/**/*.json" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="Config/**/*" Exclude="Config/**/*.config;Config/**/*.json" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="Install/Config/**/*" Exclude="Install/Config/**/*.config;Install/Config/**/*.json" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="Install/Scripts/**/*" Exclude="Install/Scripts/**/*.config;Install/Scripts/**/*.json" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="Licenses/**/*" Exclude="Licenses/**/*.config;Licenses/**/*.json" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="Components/Portals/*.xsd;Components/Portals/*.xsx" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="Components/ResourceInstaller/*.xsd;Components/ResourceInstaller/template.dnn.txt" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="Portals/_default/**/*" Exclude="Portals/_default/**/*.config;Portals/_default/**/*.json" CopyToOutputDirectory="PreserveNewest" />
    <!-- The GeoIP database the CountryListBox RCL reads. It is NOT web-served: the control
         resolves it through IWebHostEnvironment.ContentRootFileProvider at the content-root
         relative path "controls/CountryListBox/Data/GeoIP.dat" (its default GeoIPFile value) and
         watches that same file for its cache dependency, so it must ship at the content root
         rather than under wwwroot/. -->
    <Content Include="controls/CountryListBox/Data/GeoIP.dat" CopyToOutputDirectory="PreserveNewest" />
    <!-- Server-side data trees that stay OUTSIDE wwwroot/ (checklist 88, 89, 92).
         Microsoft.NET.Sdk.Web only globs **/*.config, **/*.json and wwwroot/** as Content, so
         these extensions (.SqlDataProvider, .sql, .xslt, .xml, .txt, .htm, .template, .resources)
         would otherwise be absent from the build output even though the code reads them from the
         content root through HttpContextSource.MapPath / IApplicationStatusInfo.ApplicationMapPath. -->
    <Content Include="Providers/**/*" Exclude="Providers/**/*.config;Providers/**/*.json" CopyToOutputDirectory="PreserveNewest" />
    <!-- Install.htm, Install.template.htm, UnderConstruction.template.htm and
         DotNetNuke.install.config.resources are READ FROM DISK and inlined into the response by
         HtmlUtils.WriteHeader / the installer, so they must be deployed - they are not served as
         static files. The .razor replacements of install.aspx/InstallWizard.aspx/UpgradeWizard.aspx/
         WizardUser.ascx are excluded because the SDK already includes them as RazorComponent
         items; including them here as well would both duplicate the item and ship the sources. -->
    <Content Include="Install/**/*" Exclude="Install/Config/**/*;Install/Scripts/**/*;Install/**/*.config;Install/**/*.json;Install/**/*.cs;Install/**/*.resx;Install/**/*.ascx;Install/**/*.aspx;Install/**/*.razor" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="admin/**/*.xml;admin/**/*.xslt" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="Resources/AppOffline/**/*" CopyToOutputDirectory="PreserveNewest" />
    <Content Update="App_Data/**/*.config;App_Data/**/*.json;Config/**/*.config;Config/**/*.json;Install/Config/**/*.config;Install/Config/**/*.json;Install/Scripts/**/*.config;Install/Scripts/**/*.json;Portals/_default/**/*.config;Portals/_default/**/*.json" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

