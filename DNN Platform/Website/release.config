<?xml version="1.0" encoding="utf-8"?>
<!--
  ============================================================================================
  IIS hosting fragment (production). NOT an ASP.NET configuration file any more.
  ============================================================================================
  On .NET Framework this file was the web.config template that the DNN installer copied to
  ~/web.config. On net10.0 the application is configured by appsettings.json + IOptions and
  composed in Website/Program.cs, so everything that used to live here has moved:

    <configSections>                  -> gone. Options types bound by AddDnnPlatformConfiguration;
                                         the ClientDependency.Core and log4net section handlers no
                                         longer exist as types.
    <connectionStrings>               -> appsettings.json "ConnectionStrings" (values REDACTED;
                                         supply them through user secrets / environment).
    <appSettings>                     -> appsettings.json "AppSettings" + the typed options.
    <dotnetnuke> (provider groups)    -> appsettings.json "DotNetNuke" (bound provider options).
    system.web.webPages.razor         -> no destination; see migration-summary.md (RazorHost
                                         implicit-import behavioural delta).
    system.web (ALL of it, removed)   -> Program.cs / appsettings.json. See the one-for-one map in
                                         migration-summary.md. machineKey -> Data Protection API.
    <runtime><assemblyBinding>        -> gone. Binding redirects are meaningless on net10.0.

  ONLY the <system.webServer> fragment survives, because it is consumed by IIS itself (not by
  ASP.NET) when the app is hosted behind IIS/ANCM. Kestrel ignores this file entirely.

  The <modules> and <handlers> entries that used to be here are deliberately absent: every one of
  them is now middleware or an endpoint registered in Program.cs / UseDnnPlatform. Re-adding any
  of them would double-run the behaviour.
-->
<configuration>
  <system.webServer>
    <staticContent>
      <clientCache cacheControlCustom="public" cacheControlMode="UseMaxAge" cacheControlMaxAge="365.00:00:00" />
    </staticContent>

    <!--
      Response.TrySkipIisCustomErrors no longer exists on ASP.NET Core. Without PassThrough, IIS
      replaces the response body that DNN's own exception handler / 404 handling produced with its
      own generic error page. See specialist7-wiring-notes.md.
    -->
    <httpErrors existingResponse="PassThrough" />

    <httpProtocol>
      <customHeaders>
        <remove name="X-Powered-By" />
        <remove name="X-XSS-Protection" />
        <remove name="X-Frame-Options" />
        <add name="X-XSS-Protection" value="1; mode=block" />
        <add name="X-Frame-Options" value="SAMEORIGIN" />
      </customHeaders>
    </httpProtocol>

    <security>
      <requestFiltering>
        <!-- Mirrors HttpRuntime:MaxRequestLength (28672 KB) in appsettings.json. -->
        <requestLimits maxAllowedContentLength="29360128" />
      </requestFiltering>
    </security>
  </system.webServer>
</configuration>
