<?xml version="1.0" encoding="utf-8"?>
<!--
  ============================================================================================
  IIS hosting fragment (development). NOT an ASP.NET configuration file any more.
  ============================================================================================
  See release.config for the full one-for-one map of where each removed section went. The only
  differences this development variant ever carried were:

    <compilation debug="true">        -> no destination. Runtime page compilation does not exist;
                                         the Debug build configuration replaces it.
    <trust level="Full" />            -> no destination. Code Access Security was removed in .NET
                                         Core; there is no partial trust to opt out of.
    <dotnetnuke><data objectQualifier="dnn_">
                                      -> appsettings.Development.json
                                         ("DotNetNuke:data:providers:0:objectQualifier").
    <dotnetnuke><scheduling> without delayAtAppStart
                                      -> appsettings.Development.json
                                         ("DotNetNuke:scheduling:providers:0:delayAtAppStart": "0").

  Everything else is identical to release.config, so this file keeps only the IIS fragment.
-->
<configuration>
  <system.webServer>
    <staticContent>
      <clientCache cacheControlCustom="public" cacheControlMode="UseMaxAge" cacheControlMaxAge="365.00:00:00" />
    </staticContent>

    <!--
      Response.TrySkipIisCustomErrors no longer exists on ASP.NET Core. Without PassThrough, IIS
      replaces the response body that DNN's own exception handler / 404 handling produced with its
      own generic error page. See specialist7-wiring-notes.md.
    -->
    <httpErrors existingResponse="PassThrough" />

    <httpProtocol>
      <customHeaders>
        <remove name="X-Powered-By" />
        <remove name="X-XSS-Protection" />
        <remove name="X-Frame-Options" />
        <add name="X-XSS-Protection" value="1; mode=block" />
        <add name="X-Frame-Options" value="SAMEORIGIN" />
      </customHeaders>
    </httpProtocol>

    <security>
      <requestFiltering>
        <!-- Mirrors HttpRuntime:MaxRequestLength (28672 KB) in appsettings.json. -->
        <requestLimits maxAllowedContentLength="29360128" />
      </requestFiltering>
    </security>
  </system.webServer>
</configuration>
