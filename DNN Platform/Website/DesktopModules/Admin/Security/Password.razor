@* Replaces Password.ascx + Password.ascx.cs + Password.ascx.designer.cs.

   Every panel, row and button keeps its original id, CSS class and resource key, and each one's
   visibility is rendered from the same flag DataBind()/OnLoad() computed. The three <asp:panel>s
   (pnlChange, pnlReset, pnlQA), the three conditional rows (oldPasswordRow, captchaRow,
   questionRow, answerRow) and the five buttons are therefore shown in exactly the cases they were
   before - and those cases are security rules, not cosmetics (see the remarks in
   Password.razor.cs).

   Forced changes:
   - <asp:textbox textmode="Password"> becomes <input type="password"> with @@bind, keeping size and
     maxlength. The confirm box keeps its "password-confirm" class, which the comparer script
     selects on, and the new-password box still gets "password-strength" (and its container
     "password-strength-container") when the strength meter is enabled.
   - <dnn:captchacontrol> is the migrated CaptchaControl component; it validates itself as the
     answer is typed and still exposes IsValid, which is what the update handler gates on.
   - <dnn:label> is the migrated LabelControl component; the ids and controlname values are kept so
     the same resource keys (<id>.Text / <id>.Help) are looked up.
   - the two <asp:LinkButton>s that ran the MS-AJAX/ClientScript start-up scripts for the strength
     meter and the password comparer are unaffected; those scripts moved to IJSRuntime calls in
     OnAfterRenderAsync (no <script> is legal in a .razor file).
   - ViewStateMode="Disabled" is moot - there is no view state. *@

@namespace DotNetNuke.Modules.Admin.Users
@inherits DotNetNuke.Entities.Modules.UserModuleBase

@using DotNetNuke.UI.UserControls
@using DotNetNuke.UI.WebControls

<div class="dnnForm dnnPassword dnnClear" id="dnnPassword">
    <fieldset>
        @if (this.cannotChangePasswordMessageVisible)
        {
            <div id="CannotChangePasswordMessage" class="dnnFormMessage dnnFormWarning">@this.LocalizeText("CannotChangePassword")</div>
        }
        @if (this.pnlChangeVisible)
        {
            <div id="pnlChange">
                <h2 class="dnnFormSectionHead"><span id="lblChangePasswordHeading">@this.LocalizeText("ChangePassword.Text")</span></h2>
                <div class="dnnFormItem"><p><span id="lblChangeHelp">@this.changeHelpText</span></p></div>
                @if (this.oldPasswordRowVisible)
                {
                    <div id="oldPasswordRow" class="dnnFormItem">
                        <LabelControl ID="plOldPassword" ControlName="txtOldPassword" LocalResourceFile="@this.LocalResourceFile" />
                        <input type="password" id="txtOldPassword" size="25" maxlength="39" @bind="this.oldPassword" />
                    </div>
                }
                <div class="dnnFormItem">
                    <LabelControl ID="plNewPassword" ControlName="txtNewPassword" LocalResourceFile="@this.LocalResourceFile" />
                    <div id="@this.PasswordContainerClientId" class="@this.passwordContainerCssClass">
                        <input type="password" id="txtNewPassword" class="@this.newPasswordCssClass" size="25" maxlength="39" @bind="this.newPassword" />
                    </div>
                </div>
                <div class="dnnFormItem">
                    <LabelControl ID="plNewConfirm" ControlName="txtNewConfirm" LocalResourceFile="@this.LocalResourceFile" />
                    <input type="password" id="txtNewConfirm" size="25" maxlength="39" class="password-confirm" @bind="this.newConfirm" />
                </div>
                @if (this.captchaRowVisible)
                {
                    <div id="captchaRow" class="dnnFormItem dnnCaptcha">
                        <LabelControl ID="captchaLabel" ControlName="ctlCaptcha" LocalResourceFile="@this.LocalResourceFile" />
                        <CaptchaControl @ref="this.ctlCaptcha"
                                        CaptchaWidth="Unit.Pixel(130)"
                                        CaptchaHeight="Unit.Pixel(40)"
                                        ErrorMessage="@this.captchaErrorMessage"
                                        Text="@this.captchaText" />
                    </div>
                }
                <div class="dnnClear"></div>
                <ul class="dnnActions dnnClear">
                    @if (this.cmdUpdateVisible)
                    {
                        <li><a id="cmdUpdate" class="dnnPrimaryAction" href="javascript:void(0);" @onclick="this.CmdUpdateClick" @onclick:preventDefault="true">@this.LocalizeText("ChangePassword.Text")</a></li>
                    }
                </ul>
            </div>
        }
        @if (this.pnlResetVisible)
        {
            <div id="pnlReset">
                <h2 class="dnnFormSectionHead"><span id="lblResetHeading">@this.LocalizeText("ResetPassword.Text")</span></h2>
                <div class="dnnFormItem"><span id="lblResetHelp">@this.resetHelpText</span></div>
                @if (this.questionRowVisible)
                {
                    <div id="questionRow" class="dnnFormItem">
                        <LabelControl ID="plQuestion" ControlName="lblQuestion" LocalResourceFile="@this.LocalResourceFile" />
                        <span id="lblQuestion">@this.questionText</span>
                    </div>
                }
                @if (this.answerRowVisible)
                {
                    <div id="answerRow" class="dnnFormItem">
                        <LabelControl ID="plAnswer" ControlName="txtAnswer" LocalResourceFile="@this.LocalResourceFile" />
                        <input type="text" id="txtAnswer" size="25" maxlength="20" @bind="this.answer" />
                    </div>
                }
            </div>
        }
        @if (this.pnlQAVisible)
        {
            <div id="pnlQA">
                <div class="dnnFormItem"><span id="lblChangeQA">@this.LocalizeText("ChangeQA.Text")</span></div>
                <div class="dnnFormItem"><span id="lblQAHelp" class="Normal">@this.LocalizeText("QAHelp.Text")</span></div>
                <div class="dnnFormItem">
                    <LabelControl ID="plQAPassword" ControlName="txtQAPassword" LocalResourceFile="@this.LocalResourceFile" />
                    <input type="password" id="txtQAPassword" size="25" maxlength="20" @bind="this.qaPassword" />
                </div>
                <div class="dnnFormItem">
                    <LabelControl ID="plEditQuestion" ControlName="txtEditQuestion" LocalResourceFile="@this.LocalResourceFile" />
                    <input type="text" id="txtEditQuestion" size="25" maxlength="20" @bind="this.editQuestion" />
                </div>
                <div class="dnnFormItem">
                    <LabelControl ID="plEditAnswer" ControlName="txtEditAnswer" LocalResourceFile="@this.LocalResourceFile" />
                    <input type="text" id="txtEditAnswer" size="25" maxlength="20" @bind="this.editAnswer" />
                </div>
            </div>
        }
        <div class="dnnFormItem">
            <LabelControl ID="plLastChanged" ControlName="lblLastChanged" LocalResourceFile="@this.LocalResourceFile" />
            <span id="lblLastChanged">@this.lastChangedText</span>
        </div>
        <div class="dnnFormItem">
            <LabelControl ID="plExpires" ControlName="lblExpires" LocalResourceFile="@this.LocalResourceFile" />
            <span id="lblExpires">@this.expiresText</span>
        </div>
    </fieldset>
    <ul class="dnnActions dnnClear">
        @if (this.cmdResetVisible)
        {
            <li><a id="cmdReset" class="dnnPrimaryAction" href="javascript:void(0);" @onclick="this.CmdResetClick" @onclick:preventDefault="true">@this.LocalizeText("ResetPassword.Text")</a></li>
        }
        @if (this.cmdUserResetVisible)
        {
            <li><a id="cmdUserReset" class="dnnPrimaryAction" href="javascript:void(0);" @onclick="this.CmdUserResetClick" @onclick:preventDefault="true">@this.LocalizeText("ResetPassword.Text")</a></li>
        }
        @if (this.cmdUpdateQAVisible)
        {
            <li><a id="cmdUpdateQA" class="dnnSecondaryAction" href="javascript:void(0);" @onclick="this.CmdUpdateQAClick" @onclick:preventDefault="true">@this.LocalizeText("SaveQA.Text")</a></li>
        }
    </ul>
</div>
