@* The dnn:DnnCssExclude skin object (was DnnCssExclude.ascx + .cs, which wrapped the
   <dnn:DnnCssExclude> control of DotNetNuke.Web.Client). The wrapped control's whole behaviour
   was IClientResourceController.RemoveStylesheetByName(Name) (see
   DotNetNuke.Web.Client/Controls/ClientResourceExcludeTagHelper.cs), called while the control
   initialized - i.e. before the page renders its dependencies - and it never emitted markup.
   Both properties are preserved here: the exclusion runs in OnInit and nothing is rendered. *@
@namespace DotNetNuke.UI.Skins.Controls
@inherits DotNetNuke.UI.Skins.SkinObjectBase
@using System
@using DotNetNuke.Abstractions.ClientResources
@using Microsoft.AspNetCore.Components
@inject IClientResourceController ClientResources

@code {
    /// <summary>Gets or sets the name of the stylesheet resource to exclude.</summary>
    [Parameter]
    public string Name { get; set; }

    /// <inheritdoc />
    protected override void OnInit(EventArgs e)
    {
        base.OnInit(e);
        this.ClientResources.RemoveStylesheetByName(this.Name);
    }
}
