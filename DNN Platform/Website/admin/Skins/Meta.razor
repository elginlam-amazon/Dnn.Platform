@* Ported from Meta.ascx / Meta.ascx.cs / Meta.ascx.designer.cs — the dnn:META skin object.

   The WebForms control had no markup of its own: from OnPreRender it added an HtmlMeta to
   Page.Header.Controls (at index 0 when InsertFirst was set). Blazor has no Page.Header; head
   content reaches the document through the <HeadContent> section, which the single
   <HeadOutlet @rendermode="RenderModeForPage" /> already declared in App.razor relocates into
   <head>. So this component contributes a <HeadContent> block of its own — no second HeadOutlet is
   added, and nothing is written to a placeholder.

   The emission guard is unchanged: a meta tag is produced only when Content is set AND at least one
   of Name / HttpEquiv is set, and each attribute is omitted when it is empty.

   REVIEW: InsertFirst can no longer place this tag ahead of the host page's own head content.
   <HeadContent> blocks are flushed in render order, and DefaultPage.razor (the head owner) renders
   before the skin tree it hosts, so an InsertFirst meta now lands after the page's metas instead of
   at index 0 of <head>. Element order inside <head> carries no behaviour for a name/content meta;
   verify if a theme relies on it for an http-equiv tag.
*@
@namespace DotNetNuke.UI.Skins.Controls
@inherits DotNetNuke.UI.Skins.SkinObjectBase

@using System
@using Microsoft.AspNetCore.Components
@using Microsoft.AspNetCore.Components.Web

@if (this.Visible && this.ShouldRenderMeta)
{
    <HeadContent>
        <meta http-equiv="@NullIfEmpty(this.EffectiveHttpEquiv)" name="@NullIfEmpty(this.Name)" content="@this.Content" />
    </HeadContent>
}

@code {
    /// <summary>Backing field for <see cref="Http" />.</summary>
    private readonly HttpPlaceholder http = new HttpPlaceholder();

    /// <summary>Gets an object to set the <see cref="HttpEquiv" /> property.</summary>
    public HttpPlaceholder Http
    {
        get { return this.http; }
    }

    /// <summary>
    /// Gets or sets the name of the <c>meta</c> element
    /// Either the name or the <see cref="HttpEquiv" /> must be set.
    /// The <c>name</c> attribute is not rendered if it is not set.
    /// </summary>
    [Parameter]
    public string Name { get; set; }

    /// <summary>Gets or sets the content of the <c>meta</c> element.</summary>
    [Parameter]
    public string Content { get; set; }

    /// <summary>
    /// Gets or sets the <c>http-equiv</c> attribute of the <c>meta</c> element.
    /// If specified, this is the name of the HTTP header that the
    /// <c>meta</c>
    /// The attribute is not rendered if it is not set.
    /// Either this or the <see cref="Name" /> must be set.
    /// </summary>
    [Parameter]
    public string HttpEquiv { get; set; }

    /// <summary>Gets the effective <c>http-equiv</c> value.</summary>
    /// <remarks>
    /// The WebForms property WAS <c>Http.Equiv</c>, so a skin could set it either directly or
    /// through the <c>Http-Equiv</c> attribute syntax the <see cref="HttpPlaceholder"/> exists for.
    /// A component parameter has to be an auto property, so the two are merged on read instead:
    /// the directly assigned value wins and the placeholder is the fallback, which makes both
    /// spellings behave exactly as they did.
    /// </remarks>
    private string EffectiveHttpEquiv =>
        string.IsNullOrEmpty(this.HttpEquiv) ? this.Http.Equiv : this.HttpEquiv;

    /// <summary>
    /// Gets or sets a value indicating whether to insert this <c>meta</c>
    /// element at the beginning of the <c>head</c> element, rather than the
    /// end.
    /// </summary>
    [Parameter]
    public bool InsertFirst { get; set; }

    /// <summary>Gets a value indicating whether the <c>meta</c> element is emitted.</summary>
    /// <remarks>
    /// The guard of the WebForms OnPreRender, unchanged. Named <c>ShouldRenderMeta</c> rather than
    /// <c>ShouldRender</c> because the latter hides <c>ComponentBase.ShouldRender()</c> (CS0108),
    /// which is part of Blazor's own render lifecycle and must not be shadowed.
    /// </remarks>
    private bool ShouldRenderMeta =>
        (!string.IsNullOrEmpty(this.Name) || !string.IsNullOrEmpty(this.EffectiveHttpEquiv))
        && !string.IsNullOrEmpty(this.Content);

    private static string NullIfEmpty(string value) => string.IsNullOrEmpty(value) ? null : value;

    /// <summary>
    /// A class used by the <see cref="Http" /> property to enable setting
    /// the <see cref="HttpEquiv" /> property via <c>Http-Equiv</c> syntax
    /// in Web Forms markup.
    /// </summary>
    public class HttpPlaceholder
    {
        /// <summary>
        /// Gets or sets the <see cref="Meta.HttpEquiv"/> of the parent
        /// <c>meta</c> element.
        /// </summary>
        public string Equiv { get; set; }
    }
}
