@namespace DotNetNuke.Modules.Admin.Security
@inherits DotNetNuke.Entities.Modules.UserModuleBase

@using DotNetNuke.UI.UserControls
@using DotNetNuke.UI.WebControls

@*
    Replaces SendPassword.ascx + SendPassword.ascx.cs + SendPassword.ascx.designer.cs (the module
    control stored as `Admin/Security/SendPassword.ascx`, ControlKey "SendPassword"). The logic is
    in SendPassword.razor.cs; see the remarks there for the user-enumeration guarantee, which is the
    whole point of this control's messaging.

    Every element keeps its id, CSS class and resource key, and every `runat="server"` visibility
    flag is rendered from the field the code-behind assigns:
      pnlRecover  -> pnlRecoverVisible   (hidden after a send attempt, success OR failure)
      divPassword -> divPasswordVisible  (hidden when password reset is disabled)
      divUsername -> divUsernameVisible  (hidden when e-mail is used as the user name)
      divEmail    -> divEmailVisible     (shown when a unique e-mail is required)
      divCaptcha  -> divCaptchaVisible   (the Security_CaptchaRetrivePassword portal setting)
      liSend      -> liSendVisible
      liCancel    -> liCancelVisible

    Forced changes only: <asp:textbox> -> <input type="text"> with @@bind; <asp:LinkButton> -> an
    anchor with @@onclick (no literal onclick attribute may be combined with @@onclick, RZ10008);
    <asp:HyperLink> -> an anchor whose href is the navigation URL the code-behind computes;
    <dnn:label> and <dnn:captchacontrol> are the migrated LabelControl / CaptchaControl components.
    The captcha's `errorstyle-cssclass` is applied through @@ref in OnPreRender because
    CaptchaControl.ErrorStyle is a read-only Style rather than a [Parameter].
*@

<div class="dnnForm dnnSendPassword dnnClear">

    @if (this.pnlRecoverVisible)
    {
        <div id="pnlRecover">

            <div class="dnnFormMessage dnnFormInfo"><span id="lblHelp">@((MarkupString)(this.helpText ?? string.Empty))</span></div>

            @if (this.divPasswordVisible)
            {
                <div id="divPassword" class="dnnSendPasswordContent">
                    @if (this.divUsernameVisible)
                    {
                        <div class="dnnFormItem" id="divUsername">
                            <LabelControl ID="plUsername" ControlName="txtUsername" LocalResourceFile="@this.LocalResourceFile" />
                            <input type="text" id="txtUsername" class="dnnFormRequired" @bind="this.username" />
                        </div>
                    }
                    @if (this.divEmailVisible)
                    {
                        <div class="dnnFormItem" id="divEmail">
                            <LabelControl ID="plEmail" ControlName="txtEmail" LocalResourceFile="@this.LocalResourceFile" />
                            <input type="text" id="txtEmail" @bind="this.email" />
                        </div>
                    }
                    @if (this.divCaptchaVisible)
                    {
                        <div id="divCaptcha" class="dnnFormItem">
                            <LabelControl ID="plCaptcha" ControlName="ctlCaptcha" LocalResourceFile="@this.LocalResourceFile" />
                            <CaptchaControl @ref="this.CtlCaptcha"
                                            ID="ctlCaptcha"
                                            CaptchaWidth="@(new Unit(130))"
                                            CaptchaHeight="@(new Unit(40))"
                                            ErrorMessage="@this.captchaErrorMessage"
                                            Text="@this.captchaText" />
                        </div>
                    }
                </div>
            }

        </div>
    }

    <ul class="dnnActions dnnClear">
        @if (this.liSendVisible)
        {
            <li id="liSend"><a id="cmdSendPassword" class="dnnPrimaryAction" href="javascript:void(0);" @onclick="this.OnSendPasswordClick" @onclick:preventDefault="true">@this.sendPasswordText</a></li>
        }
        @if (this.liCancelVisible)
        {
            <li id="liCancel"><a id="lnkCancel" class="dnnSecondaryAction" href="@this.cancelUrl">@this.LocalizeText(this.cancelResourceKey + ".Text")</a></li>
        }
    </ul>

</div>
