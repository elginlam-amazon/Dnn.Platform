@namespace DotNetNuke.Modules.Admin.Security
@inherits DotNetNuke.Entities.Modules.UserModuleBase

@*
    Replaces PasswordReset.ascx + PasswordReset.ascx.cs + PasswordReset.ascx.designer.cs (the module
    control stored as `Admin/Security/PasswordReset.ascx`, ControlKey "PasswordReset"). The logic is
    in PasswordReset.razor.cs; see the remarks there for the reset-token validation and expiry
    branches, which are security controls and are reproduced verbatim.

    Each element keeps its id, CSS class and resource key, and every `runat="server"` Visible flag is
    rendered from the field the code-behind assigns:
      resetMessages      -> resetMessagesVisible (Visible="False" in the markup, raised in OnPreRender)
      divPassword        -> divPasswordVisible   (hidden when the token is invalid or expired)
      divQA              -> divQAVisible         (visible="false", raised when the provider requires Q&A)
      liLogin            -> always rendered, as before

    The four ASP.NET validators become the same conditionally rendered messages, carrying the same
    `dnnFormMessage dnnFormError dnnRequired` class and the same resource keys
    (Username.Required / Email.Required, Password.Required, Confirm.Required, Answer.Required). The
    RegularExpressionValidator's ValidationExpression="[\w\W]{7,}" is applied verbatim server side.

    <asp:TextBox TextMode="Password"> becomes <input type="password">, keeping size/maxlength and the
    "password-confirm" class the comparer script selects on; txtUsername keeps its disabled state
    when a reset token was supplied. The `data-default` attributes the code-behind added are rendered
    as real attributes. <asp:LinkButton> becomes an anchor with @@onclick only (a literal onclick plus
    @@onclick on one element is RZ10008).
*@

<div class="dnnForm dnnPasswordReset dnnClear">
    @if (this.resetMessagesVisible)
    {
        <div class="dnnFormMessage dnnFormInfo" id="resetMessages">
            <span><span id="lblInfo">@this.infoText</span></span>
            <span class="error"><span id="lblHelp">@this.helpText</span></span>
        </div>
    }
    @if (this.divPasswordVisible)
    {
        <div id="divPassword" class="dnnPasswordResetContent">
            <div class="dnnFormItem">
                <input type="text" id="txtUsername" data-default="@this.usernameDefaultText" disabled="@(!this.usernameEnabled)" @bind="this.username" />
                @if (this.valUsernameVisible)
                {
                    <span id="valUsername" class="dnnFormMessage dnnFormError dnnRequired">@this.valUsernameText</span>
                }
            </div>
            <div class="dnnFormItem">
                <div id="passwordContainer" class="@this.passwordContainerCssClass">
                    <input type="password" id="txtPassword" class="@this.passwordCssClass" size="12" maxlength="39" autocomplete="off" data-default="@this.passwordDefaultText" @bind="this.password" />
                </div>
                @if (this.valPasswordVisible)
                {
                    <span id="valPassword" class="dnnFormMessage dnnFormError dnnRequired">@this.LocalizeText("Password.Required")</span>
                }
            </div>
            <div class="dnnFormItem">
                <input type="password" id="txtConfirmPassword" maxlength="39" class="password-confirm" data-default="@this.confirmDefaultText" @bind="this.confirmPassword" />
                @if (this.valConfirmPasswordVisible)
                {
                    <span id="valConfirmPassword" class="dnnFormMessage dnnFormError dnnRequired">@this.LocalizeText("Confirm.Required")</span>
                }
            </div>
            @if (this.divQAVisible)
            {
                <div id="divQA">
                    <div class="dnnFormItem">
                        <span id="lblQuestion">@this.questionText</span>
                    </div>
                    <div class="dnnFormItem">
                        <input type="text" id="txtAnswer" data-default="@this.answerDefaultText" @bind="this.answer" />
                        @if (this.valAnswerVisible)
                        {
                            <span id="valAnswer" class="dnnFormMessage dnnFormError dnnRequired">@this.LocalizeText("Answer.Required")</span>
                        }
                    </div>
                </div>
            }
            <ul class="dnnActions dnnClear">
                <li>
                    <a id="cmdChangePassword" class="dnnPrimaryAction" href="javascript:void(0);" @onclick="this.CmdChangePasswordClick" @onclick:preventDefault="true">@this.LocalizeText("cmdChangePassword.Text")</a>
                </li>
                <li id="liLogin">
                    <a id="hlCancel" class="dnnSecondaryAction" href="@this.cancelUrl">@this.LocalizeText("cmdCancel.Text")</a>
                </li>
            </ul>
        </div>
    }
</div>
