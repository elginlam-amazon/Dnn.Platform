<Project Sdk="Microsoft.NET.Sdk.Razor">

  <PropertyGroup>
    <RootDirectory>$(MSBuildProjectDirectory)/../..</RootDirectory>
    <OutputPath>bin</OutputPath>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    <RootNamespace>DotNetNuke.Services.Syndication</RootNamespace>
    <AssemblyName>DotNetNuke.Services.Syndication</AssemblyName>
    <TargetFramework>net10.0</TargetFramework>
    <Deterministic>true</Deterministic>
    <LangVersion>latest</LangVersion>
    <EnableNETAnalyzers>true</EnableNETAnalyzers>
    <AnalysisLevel>latest</AnalysisLevel>
    <AnalysisMode>Recommended</AnalysisMode>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <GenerateAssemblyInfo>false</GenerateAssemblyInfo>
  </PropertyGroup>

  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\DotNetNuke.Internal.SourceGenerators\DotNetNuke.Internal.SourceGenerators.csproj" ReferenceOutputAssembly="false" OutputItemType="Analyzer" />
    <ProjectReference Include="..\DotNetNuke.Instrumentation\DotNetNuke.Instrumentation.csproj" />
  </ItemGroup>

  <ItemGroup>
    <AdditionalFiles Include="..\..\stylecop.json" Link="stylecop.json" />
    <Compile Include="..\..\SolutionInfo.cs" Link="SolutionInfo.cs" />
  </ItemGroup>

  <Import Project="..\..\DNN_Platform.build" />
  <!-- Stages this project's build output into the website bin. Runs after Build (the net48 leg
       ran before Build and relied on the output of the previous build already being present),
       so the files it stages are the ones just produced. -->
  <Target Name="CopyBin" AfterTargets="Build">
    <ItemGroup>
      <CopyBinFiles Include="$(OutputPath)DotNetNuke.Services.Syndication.dll" />
      <CopyBinFiles Include="$(OutputPath)DotNetNuke.Services.Syndication.pdb" />
      <CopyBinFiles Include="$(OutputPath)DotNetNuke.Services.Syndication.xml" />
    </ItemGroup>
    <Copy SourceFiles="@(CopyBinFiles)" DestinationFolder="$(WebsitePath)\bin" SkipUnchangedFiles="true" />
  </Target>
</Project>
