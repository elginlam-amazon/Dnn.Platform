<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <IsPackable>false</IsPackable>
    <LangVersion>latest</LangVersion>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <GenerateAssemblyInfo>false</GenerateAssemblyInfo>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Bcl.AsyncInterfaces" />
    <!-- Microsoft.Extensions.DependencyInjection.Abstractions is NOT referenced as a package any
         more: on net10.0 it ships in the Microsoft.AspNetCore.App shared framework referenced
         below, so an explicit PackageReference is rejected by NuGet (NU1510, warning-as-error
         here). The DI abstractions the fixtures and the code under test use are unchanged, they
         now come from the framework - no downgrade. Same precedent as Dnn.PersonaBar.UI and
         DotNetNuke.Library. -->
    <PackageReference Include="Microsoft.Identity.Client" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" />
    <PackageReference Include="Moq" />
    <PackageReference Include="NUnit" />
    <PackageReference Include="NUnit.Analyzers">
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
    <PackageReference Include="NUnit3TestAdapter" />
  </ItemGroup>

  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>

  <ItemGroup>
    <Content Include="ExportImport/TestData/legacy_v3_large.dnndb">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
    <Content Include="ExportImport/TestData/legacy_v3_small.dnndb">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
  </ItemGroup>

  <ItemGroup>
    <None Update="appsettings.json">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="../../../DotNetNuke.Internal.SourceGenerators/DotNetNuke.Internal.SourceGenerators.csproj" ReferenceOutputAssembly="false" OutputItemType="Analyzer" />
    <ProjectReference Include="../../Library/DotNetNuke.Library.csproj" />
    <ProjectReference Include="../../Modules/HTML/DotNetNuke.Modules.Html.csproj" />
    <ProjectReference Include="../../Modules/DnnExportImportLibrary/DnnExportImportLibrary.csproj" />
    <ProjectReference Include="../DotNetNuke.Tests.Utilities/DotNetNuke.Tests.Utilities.csproj" />
  </ItemGroup>

  <ItemGroup>
    <AdditionalFiles Include="../../../stylecop.json" Link="stylecop.json" />
  </ItemGroup>

</Project>
