{
  "_PORT_TODO_secrets": "hostPassword, MachineKey:ValidationKey and MachineKey:DecryptionKey are not stored here. Supply them per developer/CI through user secrets or environment variables (AppSettings__hostPassword, MachineKey__ValidationKey, MachineKey__DecryptionKey) so an unset value reads as null rather than as a fake credential.",
  "_PORT_NOTE": "Transliteration of the net48 'DNN Platform/Tests/App.config' for this test assembly (the shared net48 App.config itself is left untouched, since other test projects still depend on it). The <connectionStrings>, <appSettings>, <system.web><machineKey> and <dotnetnuke> provider sections are carried over; the net48-only pieces (NUnit/TestRunner ApartmentState, the SQL Server Compact DbProviderFactories entry, assembly binding redirects and <system.webServer>) have no modern .NET equivalent and are intentionally absent. The project-local DotNetNuke.config and SiteUrls.config are DNN runtime content read through Config/ApplicationMapPath, not .NET app configuration, so they stay as copy-to-output content files rather than being folded in here.",
  "ConnectionStrings": {
    "SiteSqlServer": "Data Source=(localdb)\\MSSQLLocalDB;Initial Catalog=Dnn_Platform;Integrated Security=True;Encrypt=False;TrustServerCertificate=True",
    "PetaPoco": "Data Source=(localdb)\\MSSQLLocalDB;Integrated Security=True;Initial Catalog=Test;Encrypt=False;TrustServerCertificate=True",
    "Test": "Data Source=(localdb)\\MSSQLLocalDB;Integrated Security=True;Initial Catalog=Test;Encrypt=False;TrustServerCertificate=True"
  },
  "MachineKey": {
    "Decryption": "3DES",
    "Validation": "SHA1"
  },
  "Authentication": {
    "Cookie": {
      "Name": ".DOTNETNUKE",
      "Domain": "",
      "Path": "/",
      "RequireSsl": false,
      "TimeoutMinutes": 60,
      "SlidingExpiration": true
    }
  },
  "Membership": {
    "ApplicationName": "DotNetNuke",
    "ConnectionStringName": "SiteSqlServer",
    "EnablePasswordRetrieval": true,
    "EnablePasswordReset": true,
    "RequiresQuestionAndAnswer": false,
    "RequiresUniqueEmail": false,
    "MinRequiredPasswordLength": 7,
    "MinRequiredNonAlphanumericCharacters": 0,
    "UserIsOnlineTimeWindow": 15
  },
  "AppSettings": {
    "siteUrl": "http://DNN_Platform.dnndev.me",
    "hostUserName": "host",
    "loginCookie": ".DOTNETNUKE",
    "InstallTemplate": "DotNetNuke.install.config",
    "AutoUpgrade": "true",
    "UseInstallWizard": "true",
    "InstallMemberRole": "true",
    "ShowMissingKeys": "false",
    "EnableCachePersistence": "false",
    "HostHeader": "",
    "RemoveAngleBrackets": "false",
    "PersistentCookieTimeout": "0",
    "TestDatabaseServer": "(localdb)\\MSSQLLocalDB"
  },
