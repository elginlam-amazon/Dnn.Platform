<Project ToolsVersion="4.0" DefaultTargets="Build" xmlns="http://schemas.microsoft.com/developer/msbuild/2003">
  <PropertyGroup>
    <RootDirectory>$(MSBuildProjectDirectory)\..\..</RootDirectory>
  </PropertyGroup>
  <Import Project="..\..\DNN_Platform.build" />
  <PropertyGroup>
    <Extension>zip</Extension>
    <DNNFileName>Dnn.Jwt</DNNFileName>
    <PackageName>DnnJwtAuth</PackageName>
    <ModuleFolderName>$(WebsitePath)\DesktopModules\AuthenticationServices\JWTAuth</ModuleFolderName>
    <InstallPath>$(WebsiteInstallPath)\Provider</InstallPath>
  </PropertyGroup>
  <!-- The file on disk is Package.targets; the lower-case "t" matters on case-sensitive
       (Linux) file systems, where the old "Package.Targets" spelling fails with MSB4019. -->
  <Import Project="$(BuildScriptsPath)\Package.targets" />
  <!-- Staging and packaging must run AFTER the build, not before it. On net48 the NuGet
       dependencies were restored into bin ahead of compilation, so a BeforeTargets="Build"
       copy found them already there. With PackageReference the package assets are placed in
       bin by the build's own copy-local phase, so a pre-build copy raced it and failed with
       MSB3030 on files that did not exist yet. This matches the migrated DotNetNuke.Web. -->
  <Target Name="CopyAndPackage" AfterTargets="Build" DependsOnTargets="CopyBin;Package" />
  <!-- Stages this project's own output into the website bin. The net48 target also copied the
       Microsoft.IdentityModel.* assemblies and a set of netstandard polyfills (System.Text.Json,
       System.Text.Encodings.Web, System.Memory, System.Buffers,
       System.Runtime.CompilerServices.Unsafe, System.Numerics.Vectors,
       System.Threading.Tasks.Extensions, Microsoft.Bcl.AsyncInterfaces, Microsoft.Bcl.TimeProvider)
       by hand. On net10.0 the polyfills are types in the shared framework and are never produced,
       and the remaining transitive dependencies are staged by the SDK's own copy-local logic, so
       only this project's own outputs are staged here - with forward slashes and Exists() guards so
       staging works on non-Windows too. -->
  <Target Name="CopyBin">
    <ItemGroup>
      <CopyBinStagedFiles Include="$(TargetDir)$(AssemblyName).dll" Condition="Exists('$(TargetDir)$(AssemblyName).dll')" />
      <CopyBinStagedFiles Include="$(TargetDir)$(AssemblyName).pdb" Condition="Exists('$(TargetDir)$(AssemblyName).pdb')" />
      <CopyBinStagedFiles Include="$(TargetDir)$(AssemblyName).xml" Condition="Exists('$(TargetDir)$(AssemblyName).xml')" />
    </ItemGroup>
    <Copy SourceFiles="@(CopyBinStagedFiles)" DestinationFolder="$(WebsitePath)/bin" SkipUnchangedFiles="true" />
  </Target>
</Project>