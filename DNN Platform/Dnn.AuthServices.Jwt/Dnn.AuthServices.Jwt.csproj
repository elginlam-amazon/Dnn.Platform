<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputPath>bin</OutputPath>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>Dnn.AuthServices.Jwt</RootNamespace>
    <AssemblyName>Dnn.AuthServices.Jwt</AssemblyName>
    <Deterministic>true</Deterministic>
    <LangVersion>latest</LangVersion>
    <Nullable>disable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <EnableNETAnalyzers>true</EnableNETAnalyzers>
    <AnalysisLevel>latest</AnalysisLevel>
    <AnalysisMode>Recommended</AnalysisMode>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <!-- Retargeting net48 -> net10.0 newly enables a wave of net10-era analyzer diagnostics that
         the net48 build never saw. Every id below is reported in PRE-EXISTING code this migration
         did not change, and for this project most of them are diagnostics the SECURITY MANDATE
         forbids acting on:
           CA1848/CA1873/CA2254 - LoggerMessage-delegate and deferred-evaluation suggestions on the
             existing LogTrace/LogWarning/LogInformation calls in JwtController, JwtAuthMessageHandler
             and PurgeExpiredTokensTask. These log lines are the audit trail of each validation step
             and must keep their exact text and call sites.
           CA1727 - PascalCase for the named placeholders ({sessionId}, {userId}, {userName},
             {status}) in those same templates; renaming them changes the emitted log output.
           CA1309 - "use ordinal string comparison" on the two culture-sensitive comparisons in
             JwtController (the Bearer scheme compare in ValidateAuthHeader and the session-claim
             compare). The mandate explicitly forbids "fixing" the scheme compare to Ordinal: it
             would change which Authorization headers are accepted, i.e. who can authenticate.
           CA1305/CA1845 - culture provider and span-based Concat on NewSessionId's
             ticks.ToString("x16") + Guid Substring, and on PurgeExpiredTokensTask's string.Format.
             NewSessionId feeds the session id and the signing secret; it is not to be touched.
           CA1051 - public instance fields on LoginData, RenewalDto and MobileController.TestPostData.
             These field names are the JSON wire contract for the login/renew endpoints.
           CA1822 - marking LoginResultData.DeprecationNotice static would drop it from the
             serialized response, changing the wire contract.
           CA1852/CA1859 - sealing JwtController and narrowing an IPortalSettings local to the
             concrete PortalSettings; both change the type/extensibility surface.
         They are follow-up code-quality debt, not migration defects, which matches the convention
         already set by the migrated DotNetNuke.Library, DotNetNuke.WebControls and
         DotNetNuke.Providers.FolderProviders. Compiler diagnostics (CS*) deliberately remain
         errors, and this project builds with zero of them. -->
    <WarningsNotAsErrors>SA1600,CA1051,CA1305,CA1309,CA1727,CA1822,CA1845,CA1848,CA1852,CA1859,CA1873,CA2254</WarningsNotAsErrors>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <!-- Properties/AssemblyInfo.cs is retained (see below), so the SDK must not generate a
         second set of assembly attributes. -->
    <GenerateAssemblyInfo>false</GenerateAssemblyInfo>
  </PropertyGroup>

  <ItemGroup>
    <!-- HttpContext / HttpRequest (JwtController, JwtAuthMessageHandler) and
         ControllerBase / IActionResult (MobileController) come from the shared framework.
         The net48 <Reference> items for System.Web and System.IdentityModel are gone: both
         are .NET Framework-only, and their replacements (Microsoft.AspNetCore.Http and
         Microsoft.IdentityModel.JsonWebTokens) are referenced here instead. The remaining
         bare references (System, System.Core, System.Data, System.Numerics, System.Security,
         System.Net.Http, System.XML, Microsoft.CSharp) are all part of the shared framework. -->
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>

  <ItemGroup>
    <!-- Version comes from Directory.Packages.props (central package management). -->
    <PackageReference Include="Microsoft.IdentityModel.JsonWebTokens" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\DotNetNuke.Abstractions\DotNetNuke.Abstractions.csproj" />
    <ProjectReference Include="..\DotNetNuke.Instrumentation\DotNetNuke.Instrumentation.csproj" />
    <ProjectReference Include="..\DotNetNuke.Web\DotNetNuke.Web.csproj" />
    <ProjectReference Include="..\Library\DotNetNuke.Library.csproj" />
  </ItemGroup>

  <ItemGroup>
    <AdditionalFiles Include="..\..\stylecop.json" Link="stylecop.json" />
  </ItemGroup>

  <ItemGroup>
    <!-- DNN extension package content (see Library.build and Dnn.Jwt.dnn). -->
    <Content Include="Data\Scripts\01.00.00.SqlDataProvider" />
    <Content Include="Data\Scripts\09.08.00.SqlDataProvider" />
    <None Include="Data\Scripts\Uninstall.SqlDataProvider" />
    <None Include="Dnn.Jwt.dnn">
      <SubType>Designer</SubType>
    </None>
    <None Include="Library.build" />
    <Content Include="license.txt" />
    <Content Include="releaseNotes.txt" />
  </ItemGroup>

  <Import Project="Library.build" />
</Project>
