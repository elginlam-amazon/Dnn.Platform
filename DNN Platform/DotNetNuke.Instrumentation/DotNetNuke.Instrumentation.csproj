<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <RootDirectory>$(MSBuildProjectDirectory)\..\..</RootDirectory>
    <OutputPath>bin</OutputPath>
    <AppendTargetFrameworkToOutputPath>true</AppendTargetFrameworkToOutputPath>
    <TargetFramework>net10.0</TargetFramework>
    <Deterministic>true</Deterministic>
    <LangVersion>latest</LangVersion>
    <EnableNETAnalyzers>true</EnableNETAnalyzers>
    <AnalysisLevel>latest</AnalysisLevel>
    <AnalysisMode>Recommended</AnalysisMode>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <GenerateAssemblyInfo>false</GenerateAssemblyInfo>
    <!-- net48 copied every transitive package assembly into bin, which is what the CopyBin
         target below staged into the website. The modern SDK resolves package assemblies from
         the NuGet cache instead, so this is required to keep CopyBin's behaviour intact. -->
    <CopyLocalLockFileAssemblies>true</CopyLocalLockFileAssemblies>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Configuration" />
    <PackageReference Include="Microsoft.Extensions.Configuration.Json" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" />
    <PackageReference Include="Microsoft.Extensions.FileProviders.Abstractions" />
    <PackageReference Include="Microsoft.Extensions.FileProviders.Physical" />
    <PackageReference Include="Microsoft.Extensions.FileSystemGlobbing" />
    <PackageReference Include="Microsoft.Extensions.Logging" />
    <PackageReference Include="Serilog" />
    <PackageReference Include="Serilog.Extensions.Logging" />
    <PackageReference Include="Serilog.Sinks.File" />
    <PackageReference Include="Serilog.Settings.Configuration" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\DotNetNuke.Internal.SourceGenerators\DotNetNuke.Internal.SourceGenerators.csproj" ReferenceOutputAssembly="false" OutputItemType="Analyzer" />
    <ProjectReference Include="..\DotNetNuke.Abstractions\DotNetNuke.Abstractions.csproj" />
    <ProjectReference Include="..\DotNetNuke.Log4net\DotNetNuke.Log4Net.csproj" />
  </ItemGroup>

  <ItemGroup>
    <AdditionalFiles Include="..\..\stylecop.json" Link="stylecop.json" />
    <Compile Include="..\..\SolutionInfo.cs" Link="SolutionInfo.cs" />
  </ItemGroup>

  <Import Project="..\..\DNN_Platform.build" />
  <!-- Stages this project's build output and its dependency assemblies into the website bin,
       as the net48 leg did via an explicit 24-file list. That list named transitive package
       assemblies that the net48 build happened to copy into bin; on net10.0 the set is taken
       from the actual resolved output instead, so the staging stays correct as packages change.
       Framework assemblies (System.Text.Json, System.Threading.Channels, ...) are no longer
       copied because net10.0 supplies them from the shared framework, not from bin.
       Runs after Build so the files it stages are the ones just produced. -->
  <Target Name="CopyBin" AfterTargets="Build" Condition="'$(TargetFramework)' == 'net10.0'">
    <ItemGroup>
      <CopyBinFiles Include="$(OutputPath)*.dll" />
      <CopyBinFiles Include="$(OutputPath)DotNetNuke.Instrumentation.pdb" />
      <CopyBinFiles Include="$(OutputPath)DotNetNuke.Instrumentation.xml" />
    </ItemGroup>
    <Copy SourceFiles="@(CopyBinFiles)" DestinationFolder="$(WebsitePath)\bin" SkipUnchangedFiles="true" />
  </Target>
</Project>