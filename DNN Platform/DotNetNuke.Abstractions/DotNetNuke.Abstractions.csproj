<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <RootDirectory>$(MSBuildProjectDirectory)\..\..</RootDirectory>
    <TargetFrameworks>net10.0;netstandard2.0</TargetFrameworks>
    <Deterministic>true</Deterministic>
    <LangVersion>latest</LangVersion>
    <EnableNETAnalyzers>true</EnableNETAnalyzers>
    <AnalysisLevel>latest</AnalysisLevel>
    <AnalysisMode>Recommended</AnalysisMode>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <DocumentationFile>bin/$(Configuration)/$(TargetFramework)/DotNetNuke.Abstractions.xml</DocumentationFile>
    <GenerateAssemblyInfo>false</GenerateAssemblyInfo>
  </PropertyGroup>


  <ItemGroup>
    <Compile Include="..\..\SolutionInfo.cs" Link="SolutionInfo.cs" />
    <AdditionalFiles Include="..\..\stylecop.json" Link="stylecop.json" />
  </ItemGroup>

  <Import Project="..\..\DNN_Platform.build" />
  <!-- The .NET Framework website consumes the netstandard2.0 build (cross-platform copy instead of XCOPY). -->
  <Target Name="PostBuild" AfterTargets="PostBuildEvent" Condition="'$(TargetFramework)' == 'netstandard2.0'">
    <ItemGroup>
      <AbstractionsOutput Include="$(ProjectDir)bin\$(Configuration)\netstandard2.0\DotNetNuke.Abstractions*" />
    </ItemGroup>
    <Copy SourceFiles="@(AbstractionsOutput)" DestinationFolder="$(WebsitePath)\bin" SkipUnchangedFiles="true" />
  </Target>

</Project>
