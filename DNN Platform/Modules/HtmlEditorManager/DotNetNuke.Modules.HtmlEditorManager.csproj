<Project Sdk="Microsoft.NET.Sdk.Razor">

  <PropertyGroup>
    <!-- Module.build's CopyBin copies from bin\ directly, so no TFM subfolder. -->
    <OutputPath>bin</OutputPath>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    <TargetFramework>net10.0</TargetFramework>
    <OutputType>Library</OutputType>
    <RootNamespace>DotNetNuke.Modules.HtmlEditorManager</RootNamespace>
    <AssemblyName>DotNetNuke.Modules.HtmlEditorManager</AssemblyName>
    <Deterministic>true</Deterministic>
    <LangVersion>latest</LangVersion>
    <Nullable>disable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <!-- SA1600 was already suppressed on net48 and is kept. Any further id listed here is
         reported by the net10-era analyzers in code this migration did not author, matching the
         convention set by the already migrated DotNetNuke.Modules.Journal and
         DotNetNuke.Modules.MemberDirectory. Compiler diagnostics (CS*) remain errors.
         ASP0006: EditorControlHost builds its render tree with a running sequence number, which
           is how the platform's own component tree renders a hosted component
           (DotNetNuke.UI.DnnComponentBase.RenderControl, ModuleHost's holder); the id is listed
           for this reason by DotNetNuke.Library and DotNetNuke.Modules.Journal too.
         BL0005: the presenter assigns PortalModuleBase.ModuleConfiguration/LocalResourceFile on
           the provider settings control it loads, which is what makes those values survive the
           renderer instantiating the control by type; the already migrated Groups, CoreMessaging
           and RazorHost modules list it for the same reason. -->
    <WarningsNotAsErrors>SA1600,ASP0006,BL0005</WarningsNotAsErrors>
    <!-- Replaces the two per-configuration
         <DocumentationFile>bin\DotNetNuke.Modules.HtmlEditorManager.xml</DocumentationFile>
         entries; emits bin/DotNetNuke.Modules.HtmlEditorManager.xml, which CopyBin copies. -->
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <!-- AssemblyInfo.cs is kept (it carries AssemblyTitle/AssemblyDescription/ComVisible/Guid,
         none of which the linked SolutionInfo.cs declares), so the SDK must not generate them. -->
    <GenerateAssemblyInfo>false</GenerateAssemblyInfo>
    <!-- This is a Blazor component library, not an MVC view assembly. -->
    <AddRazorSupportForMvc>false</AddRazorSupportForMvc>
  </PropertyGroup>

  <!-- The two original configurations are preserved. -->
  <PropertyGroup Condition=" '$(Configuration)' == 'Debug' ">
    <DebugSymbols>true</DebugSymbols>
    <DebugType>full</DebugType>
    <Optimize>false</Optimize>
    <DefineConstants>DEBUG;TRACE</DefineConstants>
  </PropertyGroup>
  <PropertyGroup Condition=" '$(Configuration)' == 'Release' ">
    <DebugType>pdbonly</DebugType>
    <Optimize>true</Optimize>
    <DefineConstants>TRACE</DefineConstants>
  </PropertyGroup>

  <!-- DNN packaging properties consumed by Module.build / Package.targets. -->
  <PropertyGroup>
    <Extension>zip</Extension>
    <DNNFileName>dnn_HtmlEditorManager</DNNFileName>
    <PackageName>DNNCE_HtmlEditorManager</PackageName>
    <BuildScriptsPath>$(MSBuildProjectDirectory)\..\..\..\Build\BuildScripts</BuildScriptsPath>
  </PropertyGroup>

  <ItemGroup>
    <!-- The components need Microsoft.AspNetCore.Components and Microsoft.AspNetCore.Http types;
         this replaces the 16 GAC System.* references (System.Web, System.Web.Services,
         System.Web.Extensions, System.Drawing, System.Configuration, ...), none of which exist
         on net10.0. -->
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\..\DotNetNuke.Internal.SourceGenerators\DotNetNuke.Internal.SourceGenerators.csproj" ReferenceOutputAssembly="false" OutputItemType="Analyzer" />
    <ProjectReference Include="..\..\DotNetNuke.Abstractions\DotNetNuke.Abstractions.csproj" />
    <ProjectReference Include="..\..\DotNetNuke.Web.Client\DotNetNuke.Web.Client.csproj" />
    <ProjectReference Include="..\..\DotNetNuke.Web\DotNetNuke.Web.csproj" />
    <ProjectReference Include="..\..\Library\DotNetNuke.Library.csproj" />
  </ItemGroup>

  <ItemGroup>
    <AdditionalFiles Include="..\..\..\stylecop.json" Link="stylecop.json" />
    <Compile Include="..\..\..\SolutionInfo.cs" Link="SolutionInfo.cs" />
  </ItemGroup>

  <ItemGroup>
    <!-- App_LocalResources\ProviderConfiguration.ascx.resx keeps its name and location on
         purpose: UpgradeController.UpgradeModule hardcodes
         "~/DesktopModules/Admin/HtmlEditorManager/App_LocalResources/ProviderConfiguration.ascx.resx"
         for the HTMLEditorPageName/HTMLEditorPageDescription lookups, and the view's superuser
         gate assigns that same literal to LocalResourceFile before reading
         CannotManageHTMLEditorProviders. Renaming it would break all three keys at runtime with a
         green build. It stays a packaged Content file, exactly as on net48; the SDK's default
         EmbeddedResource glob is removed for the folder so packaging is unchanged. -->
    <EmbeddedResource Remove="App_LocalResources\**" />
    <Content Include="App_LocalResources\ProviderConfiguration.ascx.resx" />
  </ItemGroup>

  <!-- Controls\InvalidConfiguration.ascx.resx is deleted along with
       InvalidConfiguration.ascx.designer.cs, of which it was the resource twin. Its only three
       entries were Visual Studio WebForms *designer* state for a design surface that no longer
       exists ($this.DefaultModifiers as System.CodeDom.MemberAttributes, $this.TrayLargeIcon and
       $this.TrayAutoArrange as System.Boolean - the remaining Name1/Color1/Bitmap1/Icon1 lines
       were inside the ResX schema's XML comment, not resources). It declared no localized string
       and nothing in the solution read it or its keys. Embedding it on net10.0 would additionally
       require the System.Resources.Extensions preserialization path (MSB3822) to carry designer
       metadata that can never be read again. -->

  <ItemGroup>
    <!-- DNN extension package content (see BuildScripts\Module.build's GetFiles). -->
    <None Include="dnn_HtmlEditorManager.dnn" />
    <Content Include="license.txt" />
    <Content Include="module.css" />
    <Content Include="releaseNotes.txt" />
    <Content Include="Module.build" />
    <Content Include="Images\HtmlEditorManager_Standard_32x32.png" />
    <Content Include="Images\HtmlEditorManager_Standard_16x16.png" />
  </ItemGroup>

  <Import Project="Module.build" />
</Project>
