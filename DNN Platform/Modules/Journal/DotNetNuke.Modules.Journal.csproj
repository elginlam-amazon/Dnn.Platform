<Project Sdk="Microsoft.NET.Sdk.Razor">

  <PropertyGroup>
    <!-- Module.build's CopyBin copies from bin\ directly, so no TFM subfolder. -->
    <OutputPath>bin</OutputPath>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    <TargetFramework>net10.0</TargetFramework>
    <OutputType>Library</OutputType>
    <RootNamespace>DotNetNuke.Modules.Journal</RootNamespace>
    <AssemblyName>DotNetNuke.Modules.Journal</AssemblyName>
    <Deterministic>true</Deterministic>
    <LangVersion>latest</LangVersion>
    <Nullable>disable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <EnableNETAnalyzers>true</EnableNETAnalyzers>
    <AnalysisLevel>latest</AnalysisLevel>
    <AnalysisMode>Recommended</AnalysisMode>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <!-- Retargeting net48 -> net10.0 newly enables net10-era analyzer diagnostics that the
         net48 build never saw. SA1600 was already suppressed on net48 and is kept. Any CA id
         added here is reported in PRE-EXISTING code this migration did not author, and is
         justified below, matching the convention set by the migrated DotNetNuke.Library,
         DotNetNuke.Modules.DDRMenu and DotNetNuke.Providers.FolderProviders.
         Compiler diagnostics (CS*) deliberately remain errors. -->
    <!-- SA1600: pre-existing undocumented members (net48 value, kept).
         The remaining ids are reported by the net10 analyzers in code this migration did not
         author - the 2012-era journal parser, the journal services controllers, the file-upload
         handler and the module's settings/feature controller - and keeping them as errors would
         require rewriting that logic, which is exactly what must not change. The same ids are
         listed for the same reason by the already migrated DotNetNuke.Modules.DDRMenu (which
         this project mirrors) and DotNetNuke.Library:
         ASP0006/BL0005 (the DNN component tree builds its render tree with a running sequence
           and assigns ID on control instances, like DnnControls.cs and the Library's own
           components),
         CA1001/CA1304/CA1305/CA1309/CA1310/CA1514/CA1725/CA1822/CA1825/CA1834/CA1847/CA1859/
         CA1862/CA1864/CA1865/CA1866/CA2201/CA2249/CA5369 and SA1201/SA1515/SA1604.
         Compiler diagnostics (CS*) deliberately remain errors. -->
    <WarningsNotAsErrors>SA1600,ASP0006,BL0005,CA1001,CA1304,CA1305,CA1309,CA1310,CA1514,CA1725,CA1822,CA1825,CA1834,CA1847,CA1859,CA1862,CA1864,CA1865,CA1866,CA2201,CA2249,CA5369,SA1201,SA1515,SA1604</WarningsNotAsErrors>
    <!-- Replaces the two per-configuration <DocumentationFile>bin\DotNetNuke.Modules.Journal.XML</DocumentationFile>
         entries; emits bin/DotNetNuke.Modules.Journal.xml, which Module.build's CopyBin copies. -->
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <!-- SolutionInfo.cs (linked below) carries the assembly attributes, as it did on net48
         (Properties/AssemblyInfo.cs is deleted). -->
    <GenerateAssemblyInfo>false</GenerateAssemblyInfo>
    <!-- This is a Blazor component library, not an MVC view assembly. -->
    <AddRazorSupportForMvc>false</AddRazorSupportForMvc>
  </PropertyGroup>

  <!-- The two original configurations are preserved. -->
  <PropertyGroup Condition=" '$(Configuration)' == 'Debug' ">
    <DebugSymbols>true</DebugSymbols>
    <DebugType>full</DebugType>
    <Optimize>false</Optimize>
    <DefineConstants>DEBUG;TRACE</DefineConstants>
  </PropertyGroup>
  <PropertyGroup Condition=" '$(Configuration)' == 'Release' ">
    <DebugType>pdbonly</DebugType>
    <Optimize>true</Optimize>
    <DefineConstants>TRACE</DefineConstants>
  </PropertyGroup>

  <!-- DNN packaging properties consumed by Module.build / Package.targets. -->
  <PropertyGroup>
    <Extension>zip</Extension>
    <DNNFileName>Journal</DNNFileName>
    <PackageName>DNNCE_Journal</PackageName>
    <BuildScriptsPath>$(MSBuildProjectDirectory)\..\..\..\Build\BuildScripts</BuildScriptsPath>
  </PropertyGroup>

  <ItemGroup>
    <!-- The components and the converted Web API controllers need
         Microsoft.AspNetCore.Components, Microsoft.AspNetCore.Mvc and Microsoft.AspNetCore.Http
         types; this replaces the 16 GAC System.* references (System.Web, System.Web.Services,
         System.Web.Extensions, System.Drawing, System.Configuration, ...). -->
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\..\DotNetNuke.Internal.SourceGenerators\DotNetNuke.Internal.SourceGenerators.csproj" ReferenceOutputAssembly="false" OutputItemType="Analyzer" />
    <ProjectReference Include="..\..\DotNetNuke.Abstractions\DotNetNuke.Abstractions.csproj" />
    <ProjectReference Include="..\..\DotNetNuke.DependencyInjection\DotNetNuke.DependencyInjection.csproj" />
    <ProjectReference Include="..\..\DotNetNuke.Instrumentation\DotNetNuke.Instrumentation.csproj" />
    <ProjectReference Include="..\..\DotNetNuke.Web.Client\DotNetNuke.Web.Client.csproj" />
    <ProjectReference Include="..\..\DotNetNuke.Web\DotNetNuke.Web.csproj" />
    <ProjectReference Include="..\..\Library\DotNetNuke.Library.csproj" />
  </ItemGroup>

  <ItemGroup>
    <AdditionalFiles Include="..\..\..\stylecop.json" Link="stylecop.json" />
    <Compile Include="..\..\..\SolutionInfo.cs" Link="SolutionInfo.cs" />
  </ItemGroup>

  <!-- Resources/View.resx, Resources/Settings.resx, Resources/Edit.resx and
       Resources/SharedResources.resx are the migrated App_LocalResources files (moved with
       `git mv`, bytes unchanged). Module.build still packages them into the extension's
       App_LocalResources folder as View.resx / Settings.resx / Edit.resx /
       SharedResources.resx, which is both the name PortalModuleBase.LocalResourceFile now
       derives from the component type name and the literal runtime path
       ~/DesktopModules/Journal/App_LocalResources/SharedResources.resx that
       Components/Constants.cs (SharedResourcesPath), Components/JournalParser.cs (ResxPath)
       and the Settings component's BindJournalTypes resolve - so the components' LocalizeText
       calls resolve the same keys as the WebForms LocalizeString calls did, including
       portal-level and language-pack overrides, which only the deployed files provide.
       The SDK's default EmbeddedResource glob also compiles them into the assembly (logical
       names DotNetNuke.Modules.Journal.Resources.View / .Resources.Settings /
       .Resources.Edit / .Resources.SharedResources, which is what IStringLocalizer<T> probes
       for given the ResourcesPath "Resources" that DotNetNuke.Library's Startup registers with
       AddLocalization), which makes the shipped English text self-contained. No explicit
       Content/EmbeddedResource item is needed (nor added by DDRMenu): the SDK's default
       EmbeddedResource glob covers **\*.resx, and Module.build's UpdateFiles target is what
       stages/packages them under App_LocalResources. -->

  <ItemGroup>
    <!-- App_LocalResources\ is a build-time staging folder generated by Module.build's
         UpdateFiles target from Resources\*.resx (see the comment above); the real, source-
         controlled files live in Resources\ and are embedded from there. -->
    <EmbeddedResource Remove="App_LocalResources\**" />
    <None Remove="App_LocalResources\**" />
    <Content Remove="App_LocalResources\**" />
  </ItemGroup>

  <ItemGroup>
    <!-- DNN extension package content (see BuildScripts\Module.build's GetFiles). -->
    <None Include="Journal.dnn" />
    <None Include="License.txt" />
    <None Include="ReleaseNotes.txt" />
    <None Include="module.css" />
    <Content Include="Module.build" />
    <Content Include="Providers\DataProviders\SqlDataProvider\07.03.00.SqlDataProvider" />
    <Content Include="Images\bg.jpg" />
    <Content Include="Images\d.png" />
    <Content Include="Images\dot_for_ie.gif" />
    <Content Include="Images\generic-file-thumb.jpg" />
    <Content Include="Images\input-bg.png" />
    <Content Include="Images\journal-tools.png" />
    <Content Include="Images\journal_32X32.png" />
    <Content Include="Images\mini_del.gif" />
    <Content Include="Images\progress.gif" />
    <Content Include="Images\throbber.gif" />
    <Content Include="Scripts\journal.js" />
    <Content Include="Scripts\journalcomments.js" />
  </ItemGroup>

  <Import Project="Module.build" />
</Project>
