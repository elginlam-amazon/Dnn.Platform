<Project Sdk="Microsoft.NET.Sdk.Razor">

  <PropertyGroup>
    <!-- Module.build's CopyBin copies from bin\ directly, so no TFM subfolder. -->
    <OutputPath>bin</OutputPath>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    <TargetFramework>net10.0</TargetFramework>
    <OutputType>Library</OutputType>
    <RootNamespace>DotNetNuke.Modules.MemberDirectory</RootNamespace>
    <AssemblyName>DotNetNuke.Modules.MemberDirectory</AssemblyName>
    <Deterministic>true</Deterministic>
    <LangVersion>latest</LangVersion>
    <Nullable>disable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <EnableNETAnalyzers>true</EnableNETAnalyzers>
    <AnalysisLevel>latest</AnalysisLevel>
    <AnalysisMode>Recommended</AnalysisMode>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <!-- Retargeting net48 -> net10.0 newly enables net10-era analyzer diagnostics that the
         net48 build never saw. SA1600 was already suppressed on net48 and is kept. Every other
         id below is reported in PRE-EXISTING code this migration did not author (the Web API
         service controller, the settings presenter/view model and the WebForms-era control
         logic), and silencing them is the only way to keep that logic unchanged. This mirrors
         the convention of the already migrated DotNetNuke.Modules.CoreMessaging / DDRMenu.
         Compiler diagnostics (CS*) deliberately remain errors.
         SA1600: pre-existing undocumented members (net48 value, kept).
         CA1304/CA1305/CA1309/CA1310/CA1311/CA1862: culture/casing-insensitive string and
           ToString calls in the member search and settings binding code; changing them would
           change comparison semantics.
         CA1001/CA1725/CA1822/CA1825/CA1829/CA1860/CA1861/CA1864/CA1865/CA1866/CA1869/CA1859:
           performance/style suggestions on pre-existing members.
         CA2201/CA2249/CA1514/CA1707/CA1716/CA1721/CA1720: naming and exception-type choices
           that are part of the existing public/JSON contract (Member.cs is serialized to the
           knockout client).
         SA1201/SA1515/SA1604/SA1623/SA1642: pre-existing StyleCop layout/doc findings.
         ASP0006/BL0005: component-era analyzer findings on the migrated controls. -->
    <WarningsNotAsErrors>SA1600,ASP0006,BL0005,CA1001,CA1304,CA1305,CA1309,CA1310,CA1311,CA1514,CA1707,CA1716,CA1720,CA1721,CA1725,CA1822,CA1825,CA1829,CA1834,CA1847,CA1859,CA1860,CA1861,CA1862,CA1864,CA1865,CA1866,CA1869,CA2201,CA2249,CA5369,SA1201,SA1515,SA1604,SA1623,SA1642</WarningsNotAsErrors>
    <!-- Replaces the two <DocumentationFile>bin\DotNetNuke.Modules.MemberDirectory.XML</DocumentationFile>
         entries; emits bin/DotNetNuke.Modules.MemberDirectory.xml, which Module.build's CopyBin copies. -->
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <!-- SolutionInfo.cs (linked below) and AssemblyInfo.cs carry the assembly attributes,
         as they did on net48. -->
    <GenerateAssemblyInfo>false</GenerateAssemblyInfo>
    <!-- This is a Blazor component library, not an MVC view assembly. -->
    <AddRazorSupportForMvc>false</AddRazorSupportForMvc>
  </PropertyGroup>

  <!-- The two original configurations are preserved verbatim. -->
  <PropertyGroup Condition=" '$(Configuration)' == 'Debug' ">
    <DebugSymbols>true</DebugSymbols>
    <DebugType>full</DebugType>
    <Optimize>false</Optimize>
    <DefineConstants>DEBUG;TRACE</DefineConstants>
  </PropertyGroup>
  <PropertyGroup Condition=" '$(Configuration)' == 'Release' ">
    <DebugType>pdbonly</DebugType>
    <Optimize>true</Optimize>
    <DefineConstants>TRACE</DefineConstants>
  </PropertyGroup>

  <!-- DNN packaging properties consumed by Module.build / Package.targets. -->
  <PropertyGroup>
    <Extension>zip</Extension>
    <DNNFileName>MemberDirectory</DNNFileName>
    <PackageName>DNNCE_MemberDirectory</PackageName>
    <BuildScriptsPath>$(MSBuildProjectDirectory)\..\..\..\Build\BuildScripts</BuildScriptsPath>
  </PropertyGroup>

  <ItemGroup>
    <!-- Replaces the removed System.Web* bare references: the components need
         Microsoft.AspNetCore.Components and the service controller needs
         Microsoft.AspNetCore.Mvc and Microsoft.AspNetCore.Http types. -->
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>

  <ItemGroup>
    <!-- Needed for the [LoggerMessage] partials in LoggerMessages.cs. -->
    <ProjectReference Include="..\..\..\DotNetNuke.Internal.SourceGenerators\DotNetNuke.Internal.SourceGenerators.csproj" ReferenceOutputAssembly="false" OutputItemType="Analyzer" />
    <ProjectReference Include="..\..\DotNetNuke.Abstractions\DotNetNuke.Abstractions.csproj" />
    <ProjectReference Include="..\..\DotNetNuke.Instrumentation\DotNetNuke.Instrumentation.csproj" />
    <ProjectReference Include="..\..\DotNetNuke.Web.Client\DotNetNuke.Web.Client.csproj" />
    <ProjectReference Include="..\..\DotNetNuke.Web\DotNetNuke.Web.csproj" />
    <ProjectReference Include="..\..\Library\DotNetNuke.Library.csproj" />
  </ItemGroup>

  <ItemGroup>
    <AdditionalFiles Include="..\..\..\stylecop.json" Link="stylecop.json" />
    <Compile Include="..\..\..\SolutionInfo.cs" Link="SolutionInfo.cs" />
  </ItemGroup>

  <!-- App_LocalResources/View.resx and App_LocalResources/Settings.resx are the migrated
       localization files (byte-identical renames of App_LocalResources\View.ascx.resx and
       App_LocalResources\Settings.ascx.resx). They deliberately STAY in a folder named
       App_LocalResources: the shared Build\BuildScripts\Module.build GetFiles target globs
       App_LocalResources/*.resx into @(Resources) and Package.targets zips relative to the
       project directory, so they install to DesktopModules\MemberDirectory\App_LocalResources -
       exactly where PortalModuleBase.LocalResourceFile looks and where portal-level and
       language-pack overrides live. Only the FILE name changed: View.resx / Settings.resx are
       the names now derived from the component type names View and Settings. -->

  <ItemGroup>
    <!-- DNN extension package content (see Module.build's GetFiles). These client assets stay
         in place as extension content under DesktopModules\MemberDirectory - this is a packaged
         extension library, not a web host, so nothing moves to wwwroot. View.ascx and
         Settings.ascx are no longer packaged: they are Blazor components compiled into the
         assembly, exactly as DDRMenu and CoreMessaging stopped packaging their .ascx files. -->
    <Content Include="ie-member-directory.css" />
    <Content Include="Images\ajax-loader.gif" />
    <Content Include="Images\icons.png" />
    <Content Include="Images\input-bg.png" />
    <Content Include="Images\mdAdvancedSearchBg.png" />
    <Content Include="Images\mdhoverActionsBg.png" />
    <Content Include="Images\mdHoverContentBg.png" />
    <Content Include="Images\member_list_16X16.png" />
    <Content Include="Images\member_list_32X32.png" />
    <Content Include="Images\refresh.png" />
    <Content Include="Images\search-btn.png" />
    <Content Include="Images\sendMessageSprite.png" />
    <Content Include="Images\tooltipArrow.png" />
    <Content Include="license.txt" />
    <Content Include="module.css" />
    <Content Include="releaseNotes.txt" />
    <Content Include="sample-img.jpg" />
    <Content Include="sample-img1.jpg" />
    <Content Include="Scripts\MemberDirectory.js" />
    <Content Include="Scripts\memberDirectoryInterop.js" />
    <Content Include="Scripts\memberDirectorySettingsInterop.js" />
    <Content Include="Templates\AlternateItemTemplate.htm" />
    <Content Include="Templates\ItemTemplate.htm" />
    <Content Include="Templates\PopUpTemplate.htm" />
    <Content Include="Module.build" />
    <None Include="MemberDirectory.dnn" />
  </ItemGroup>

  <Import Project="Module.build" />
</Project>
