<Project Sdk="Microsoft.NET.Sdk.Razor">

  <PropertyGroup>
    <!-- The shared Build/BuildScripts/Module.build CopyBin target copies from a lowercase
         bin\ directly, so the directory must be lowercase (Linux is case-sensitive; the net48
         "Bin\" only worked on Windows) and must carry no TFM subfolder. This matches every
         migrated sibling module (DDRMenu, Journal, CoreMessaging, HTML). -->
    <OutputPath>bin</OutputPath>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    <TargetFramework>net10.0</TargetFramework>
    <OutputType>Library</OutputType>
    <RootNamespace>DotNetNuke.Modules.Groups</RootNamespace>
    <AssemblyName>DotNetNuke.Modules.Groups</AssemblyName>
    <Deterministic>true</Deterministic>
    <LangVersion>latest</LangVersion>
    <Nullable>disable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <EnableNETAnalyzers>true</EnableNETAnalyzers>
    <AnalysisLevel>latest</AnalysisLevel>
    <AnalysisMode>Recommended</AnalysisMode>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <!-- Retargeting net48 -> net10.0 newly enables net10-era analyzer diagnostics that the net48
         build never saw. SA1600 was already suppressed on net48 and is kept. Any id added here
         must be reported in PRE-EXISTING code this migration did not author, matching the
         convention set by the already migrated DotNetNuke.Web.DDRMenu and DotNetNuke.Library.
         Compiler diagnostics (CS*) deliberately remain errors. -->
    <!-- SA1600: pre-existing undocumented members (net48 value, kept).
         The remaining ids are reported by the net10 analyzers in this module's pre-existing
         2012-era group list/notification/token-replacement code:
         ASP0006/BL0005 (the DNN component tree builds its render tree with a running sequence
           and assigns ID on control instances, as the Library's own components do),
         CA1001/CA1304/CA1305/CA1309/CA1310/CA1514/CA1725/CA1822/CA1825/CA1834/CA1847/CA1859/
         CA1862/CA1864/CA1865/CA1866/CA2201/CA2249/CA5369 and SA1201/SA1515/SA1604. -->
    <WarningsNotAsErrors>SA1600,ASP0006,BL0005,CA1001,CA1304,CA1305,CA1309,CA1310,CA1514,CA1725,CA1822,CA1825,CA1834,CA1847,CA1859,CA1862,CA1864,CA1865,CA1866,CA2201,CA2249,CA5369,SA1201,SA1515,SA1604</WarningsNotAsErrors>
    <!-- Replaces <DocumentationFile>Bin\DotNetNuke.Modules.Groups.XML</DocumentationFile>;
         emits bin/DotNetNuke.Modules.Groups.xml, which Module.build's CopyBin copies. -->
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <!-- SolutionInfo.cs (linked below) carries the assembly attributes, as it did on net48;
         Properties\AssemblyInfo.cs is deleted. -->
    <GenerateAssemblyInfo>false</GenerateAssemblyInfo>
    <!-- This is a Blazor component library, not an MVC view assembly. -->
    <AddRazorSupportForMvc>false</AddRazorSupportForMvc>
    <!-- The net48 <CodeAnalysisRuleSet>AllRules.ruleset</CodeAnalysisRuleSet> is dropped: no such
         file exists in the tree (MSBuild warned about it) and analyzer configuration now comes
         from EnableNETAnalyzers/AnalysisLevel/AnalysisMode above, as in the migrated DDRMenu. -->
  </PropertyGroup>

  <!-- The two original configurations are preserved. -->
  <PropertyGroup Condition=" '$(Configuration)' == 'Debug' ">
    <DebugSymbols>true</DebugSymbols>
    <DebugType>full</DebugType>
    <Optimize>false</Optimize>
    <DefineConstants>DEBUG;TRACE</DefineConstants>
  </PropertyGroup>
  <PropertyGroup Condition=" '$(Configuration)' == 'Release' ">
    <DebugType>pdbonly</DebugType>
    <Optimize>true</Optimize>
    <DefineConstants>TRACE</DefineConstants>
  </PropertyGroup>

  <!-- DNN packaging properties consumed by Module.build / Package.targets. -->
  <PropertyGroup>
    <Extension>zip</Extension>
    <DNNFileName>SocialGroups</DNNFileName>
    <PackageName>DNNCE_SocialGroups</PackageName>
    <BuildScriptsPath>$(MSBuildProjectDirectory)\..\..\..\Build\BuildScripts</BuildScriptsPath>
  </PropertyGroup>

  <ItemGroup>
    <!-- The components and the Web API controller need Microsoft.AspNetCore.Components,
         Microsoft.AspNetCore.Http and the MVC types that replace System.Web.Http. -->
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\..\DotNetNuke.Internal.SourceGenerators\DotNetNuke.Internal.SourceGenerators.csproj" ReferenceOutputAssembly="false" OutputItemType="Analyzer" />
    <ProjectReference Include="..\..\DotNetNuke.Abstractions\DotNetNuke.Abstractions.csproj" />
    <ProjectReference Include="..\..\DotNetNuke.Instrumentation\DotNetNuke.Instrumentation.csproj" />
    <ProjectReference Include="..\..\DotNetNuke.Web\DotNetNuke.Web.csproj" />
    <ProjectReference Include="..\..\Library\DotNetNuke.Library.csproj" />
  </ItemGroup>

  <ItemGroup>
    <AdditionalFiles Include="..\..\..\stylecop.json" Link="stylecop.json" />
    <Compile Include="..\..\..\SolutionInfo.cs" Link="Properties\SolutionInfo.cs" />
  </ItemGroup>

  <!-- Resources/*.resx are the migrated App_LocalResources files, moved with git mv and
       byte-identical. Module.build packages them into the extension's App_LocalResources
       folder under these names, so portal-level and language-pack overrides (which only the
       deployed files provide) keep resolving. View.resx and ListSettings.resx are named after
       the component types, which is the name PortalModuleBase.LocalResourceFile derives for a
       Blazor component (the DDRMenu precedent). SharedResources.resx keeps its name because
       Components\Constants.SharedResourcesPath addresses it by the installed path.
       Edit.resx and CreateSettings.resx deliberately KEEP their historical base names
       ("Edit", "CreateSettings"): neither corresponds to a control/component type in this
       module (the controls are GroupEdit and ListSettings), so renaming them to a component
       name would newly bind keys that the net48 build never resolved from them.
       The SDK's default EmbeddedResource glob also embeds them (logical names
       DotNetNuke.Modules.Groups.Resources.*) so the shipped English text is self-contained. -->

  <ItemGroup>
    <!-- DNN extension package content (see Module.build's GetFiles). -->
    <Content Include="Module.build" />
    <Content Include="module.css" />
    <!-- The client side seams of GroupView.razor and List.razor (the inline <script> blocks that
         GroupView.ascx and List.ascx emitted). They are packaged alongside module.css, under
         DesktopModules\SocialGroups\js, because the components import them by their installed
         URL - not from wwwroot: this is a DNN extension library, not a web host. -->
    <Content Include="js\groupViewInterop.js" />
    <Content Include="js\groupListInterop.js" />
    <Content Include="License.txt" />
    <Content Include="ReleaseNotes.txt" />
    <Content Include="Images\docs-icn.png" />
    <Content Include="Images\join-group-icn.png" />
    <Content Include="Images\member-icn.png" />
    <Content Include="Images\photo-icn.png" />
    <Content Include="Images\posts-icn.png" />
    <Content Include="Images\sample-group-profile.jpg" />
    <Content Include="Providers\DataProviders\SqlDataProvider\09.00.00.SqlDataProvider" />
    <None Include="SocialGroups.dnn" />
  </ItemGroup>

  <Import Project="Module.build" />
</Project>
