<Project Sdk="Microsoft.NET.Sdk.Razor">

  <PropertyGroup>
    <!-- Module.build's CopyBin copies from bin\ directly, so no TFM subfolder. -->
    <OutputPath>bin</OutputPath>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    <TargetFramework>net10.0</TargetFramework>
    <OutputType>Library</OutputType>
    <RootNamespace>Dnn.Modules.ResourceManager</RootNamespace>
    <AssemblyName>Dnn.Modules.ResourceManager</AssemblyName>
    <Deterministic>true</Deterministic>
    <LangVersion>latest</LangVersion>
    <Nullable>disable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <EnableNETAnalyzers>true</EnableNETAnalyzers>
    <AnalysisLevel>latest</AnalysisLevel>
    <AnalysisMode>Recommended</AnalysisMode>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <!-- Retargeting net48 -> net10.0 newly enables net10-era analyzer diagnostics that the
         net48 build never saw. Every id listed below is reported in PRE-EXISTING code this
         migration did not author - the module's Web API service controllers and DTOs, the
         Components layer (ItemsManager, SearchController, ThumbnailsManager,
         LocalizationController, SettingsManager, PermissionsManager) and the module control
         logic. Keeping them as errors would require rewriting that pre-existing logic, which
         is exactly what must not change in this migration. This mirrors the convention set by
         the already migrated DotNetNuke.Modules.CoreMessaging,
         DotNetNuke.Providers.FolderProviders and DotNetNuke.Library.
         Compiler diagnostics (CS*) deliberately remain errors.
         SA1600: pre-existing undocumented members.
         CA1001/CA1031/CA1051/CA1062/CA1724/CA1725/CA1819/CA1822/CA1859/CA2227: pre-existing
         API-design and performance suggestions on public surface that must not change.
         CA1304/CA1305/CA1307/CA1309/CA1310/CA1311/CA1862/CA1866: culture-aware string
         overload suggestions in pre-existing string handling; changing them would change
         comparison/formatting behavior.
         CA1514/CA1825/CA1829/CA1834/CA1845/CA1847/CA1852/CA1861/CA1864/CA1865/CA2249:
         net10-era performance/sealing suggestions in untouched bodies.
         CA2201: the module's own general exception types are part of preserved behavior.
         ASP0006/BL0005: ASP.NET Core / Blazor analyzer suggestions on the migrated
         controllers and components that do not affect behavior.
         SA1201/SA1515/SA1604: pre-existing StyleCop ordering/documentation layout.
         CA1710/CA1711: pre-existing public type names (the Web API exception filter and the
         Permission DTOs); renaming them is a breaking change to the module's API surface and
         to the JSON the React client consumes.
         CA1806/CA2263: int.TryParse without checking the result and
         Enum.GetValues(typeof(T)) are the exact, behavior-preserving forms the original
         WebForms code behinds and ItemsController used - the discarded result is relied upon
         (it leaves the out parameter at its default), so "fixing" them changes behavior.
         CA1707: CboFolderProviders_SelectedIndexChanged keeps the original event handler name
         from EditFolderMapping.ascx.cs so the mapping to the WebForms member stays obvious.
         CA1863: pre-existing string.Format usage in Components/LocalizationController. -->
    <WarningsNotAsErrors>SA1600,ASP0006,BL0005,CA1001,CA1031,CA1051,CA1062,CA1304,CA1305,CA1307,CA1309,CA1310,CA1311,CA1514,CA1707,CA1710,CA1711,CA1724,CA1725,CA1806,CA1819,CA1822,CA1825,CA1829,CA1834,CA1845,CA1847,CA1852,CA1859,CA1861,CA1862,CA1863,CA1864,CA1865,CA1866,CA2201,CA2227,CA2249,CA2263,SA1201,SA1515,SA1604</WarningsNotAsErrors>
    <!-- Replaces the <DocumentationFile>bin\Dnn.Modules.ResourceManager.xml</DocumentationFile>
         entry; emits bin/Dnn.Modules.ResourceManager.xml, which Module.build's CopyBin copies. -->
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <!-- SolutionInfo.cs (linked below) carries the assembly attributes, as it did on net48. -->
    <GenerateAssemblyInfo>false</GenerateAssemblyInfo>
    <!-- This is a Blazor component library, not an MVC view assembly. -->
    <AddRazorSupportForMvc>false</AddRazorSupportForMvc>
    <!-- The net48 project pointed CodeAnalysisRuleSet at "AllRules.ruleset", a file that does
         not exist anywhere in the repository (legacy FxCop-era leftover); it made the project
         fail to load with "Could not find rule set file". The analyzer configuration now comes
         from AnalysisMode/stylecop.json, as in the migrated sibling projects. -->
  </PropertyGroup>

  <!-- The two original configurations are preserved. -->
  <PropertyGroup Condition=" '$(Configuration)' == 'Debug' ">
    <DebugSymbols>true</DebugSymbols>
    <DebugType>full</DebugType>
    <Optimize>false</Optimize>
    <DefineConstants>DEBUG;TRACE</DefineConstants>
  </PropertyGroup>
  <PropertyGroup Condition=" '$(Configuration)' == 'Release' ">
    <DebugType>pdbonly</DebugType>
    <Optimize>true</Optimize>
    <DefineConstants>TRACE</DefineConstants>
  </PropertyGroup>

  <ItemGroup>
    <!-- Replaces the removed System.Web* / System.Net.Http bare references: the service
         controllers need Microsoft.AspNetCore.Mvc and Microsoft.AspNetCore.Http types and the
         module controls (Blazor components) need Microsoft.AspNetCore.Components. -->
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>

  <ItemGroup>
    <!-- Replaces the removed System.Drawing bare reference: the thumbnail pipeline
         (Components/ThumbnailsManager.cs) uses ImageSharp. Version comes from the central
         Directory.Packages.props (ManagePackageVersionsCentrally). -->
    <PackageReference Include="SixLabors.ImageSharp" />
  </ItemGroup>

  <ItemGroup>
    <!-- Needed for the [LoggerMessage] partials in LoggerMessages.cs. -->
    <ProjectReference Include="..\..\..\DotNetNuke.Internal.SourceGenerators\DotNetNuke.Internal.SourceGenerators.csproj" ReferenceOutputAssembly="false" OutputItemType="Analyzer" />
    <ProjectReference Include="..\..\..\Dnn.AdminExperience\Library\Dnn.PersonaBar.Library\Dnn.PersonaBar.Library.csproj" />
    <ProjectReference Include="..\..\DotNetNuke.Abstractions\DotNetNuke.Abstractions.csproj" />
    <ProjectReference Include="..\..\DotNetNuke.Instrumentation\DotNetNuke.Instrumentation.csproj" />
    <ProjectReference Include="..\..\DotNetNuke.ModulePipeline\DotNetNuke.ModulePipeline.csproj" />
    <ProjectReference Include="..\..\DotNetNuke.Web.Client\DotNetNuke.Web.Client.csproj" />
    <ProjectReference Include="..\..\DotNetNuke.WebUtility\DotNetNuke.WebUtility.csproj" />
    <ProjectReference Include="..\..\DotNetNuke.Web\DotNetNuke.Web.csproj" />
    <ProjectReference Include="..\..\Library\DotNetNuke.Library.csproj" />
  </ItemGroup>

  <ItemGroup>
    <AdditionalFiles Include="..\..\..\stylecop.json" Link="stylecop.json" />
    <Compile Include="..\..\..\SolutionInfo.cs" Link="SolutionInfo.cs" />
  </ItemGroup>

  <!-- ResourceManager.Web is the React/Stencil client source tree (no .cs/.razor files). It is
       built by Module.build's CopyScripts target into Scripts\dnn-resource-manager, not by the
       C# compiler, so the SDK's default globs pick up nothing from it. -->

  <ItemGroup>
    <!-- DNN extension package content (see Module.build's GetFiles). These assets stay in
         place as extension content under DesktopModules\ResourceManager - this is a packaged
         extension library, not a web host, so nothing moves to wwwroot. The
         App_LocalResources\*.resx files likewise stay in a folder named App_LocalResources:
         the shared Build\BuildScripts\Module.build GetFiles target globs
         App_LocalResources/*.resx into @(Resources) and Package.targets zips relative to the
         project directory, so they install exactly where PortalModuleBase.LocalResourceFile,
         Helpers\LocalizationHelper and the Localization/GetResources endpoint look for them. -->
    <Content Include="Data\00.00.01.SqlDataProvider" />
    <Content Include="Data\Uninstall.SqlDataProvider" />
    <Content Include="App_LocalResources\ResourceManager.resx" />
    <Content Include="App_LocalResources\View.ascx.resx" />
    <Content Include="App_LocalResources\Settings.resx" />
    <Content Include="App_LocalResources\EditFolderMapping.resx" />
    <Content Include="Images\arrow_forward.svg" />
    <Content Include="Images\checkmark.svg" />
    <Content Include="Images\clipboard.svg" />
    <Content Include="Images\copy.svg" />
    <Content Include="Images\delete.svg" />
    <Content Include="Images\dnnanim.gif" />
    <Content Include="Images\download.svg" />
    <Content Include="Images\edit.svg" />
    <Content Include="Images\eye.svg" />
    <Content Include="Images\folder-empty-state-asset-manager.png" />
    <Content Include="Images\folder-hover.png" />
    <Content Include="Images\folder.png" />
    <Content Include="Images\icon-add-folder.png" />
    <Content Include="Images\icon-asset-manager-azure-folder.svg" />
    <Content Include="Images\icon-asset-manager-database-folder.svg" />
    <Content Include="Images\icon-asset-manager-secure-folder.svg" />
    <Content Include="Images\icon-asset-manager-standard-folder.svg" />
    <Content Include="Images\link.svg" />
    <Content Include="Images\loader_failed.svg" />
    <Content Include="Images\loading.gif" />
    <Content Include="Images\move.svg" />
    <Content Include="Images\preview.svg" />
    <Content Include="Images\redeploy.svg" />
    <Content Include="Images\restore.svg" />
    <Content Include="Images\search-glass-no-results.png" />
    <Content Include="Images\search.png" />
    <Content Include="Images\search.svg" />
    <Content Include="Images\transparencyBG.jpg" />
    <Content Include="Images\trash.svg" />
    <Content Include="Images\tree-sprite.png" />
    <Content Include="Images\unpublished.svg" />
    <Content Include="Images\upload.svg" />
    <Content Include="Images\x.svg" />
    <Content Include="License.txt" />
    <Content Include="module.css" />
    <Content Include="ReleaseNotes.txt" />
    <Content Include="View.html" />
    <Content Include="Module.build" />
    <None Include="ResourceManager.dnn" />
  </ItemGroup>

  <Import Project="Module.build" />
</Project>
