<Project Sdk="Microsoft.NET.Sdk.Razor">

  <PropertyGroup>
    <!-- Module.build's CopyBin copies from bin\ directly, so no TFM subfolder. -->
    <OutputPath>bin</OutputPath>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>DotNetNuke.Web.DDRMenu</RootNamespace>
    <AssemblyName>DotNetNuke.Web.DDRMenu</AssemblyName>
    <Deterministic>true</Deterministic>
    <LangVersion>latest</LangVersion>
    <Nullable>disable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <EnableNETAnalyzers>true</EnableNETAnalyzers>
    <AnalysisLevel>latest</AnalysisLevel>
    <AnalysisMode>Recommended</AnalysisMode>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <!-- Retargeting net48 -> net10.0 newly enables net10-era analyzer diagnostics that the
         net48 build never saw. SA1600 was already suppressed on net48 and is kept. Any CA id
         added here must be reported in PRE-EXISTING code this migration did not author, and
         must be justified in a comment, matching the convention set by the migrated
         DotNetNuke.Library, DotNetNuke.WebControls and DotNetNuke.Providers.FolderProviders.
         Compiler diagnostics (CS*) deliberately remain errors. -->
    <!-- SA1600: pre-existing undocumented members (net48 value, kept).
         The remaining ids are reported by the net10 analyzers in code this migration did not
         author - the module's 2009-era template engine, menu node model, settings/controller and
         XSLT extension functions - and keeping them as errors would require rewriting that logic,
         which is exactly what must not change. The same ids are listed for the same reason by the
         already migrated DotNetNuke.Library (which this project mirrors) and
         DotNetNuke.Providers.FolderProviders:
         ASP0006/BL0005 (the DNN component tree builds its render tree with a running sequence and
           assigns ID on control instances, like DnnControls.cs and the Library's own components),
         CA1001/CA1304/CA1305/CA1309/CA1310/CA1725/CA1822/CA1825/CA1834/CA1847/CA1859/CA1862/
         CA1864/CA1865/CA1866/CA1514/CA2201/CA2249/CA5369 and SA1201/SA1515/SA1604.
         Compiler diagnostics (CS*) deliberately remain errors. -->
    <WarningsNotAsErrors>SA1600,ASP0006,BL0005,CA1001,CA1304,CA1305,CA1309,CA1310,CA1514,CA1725,CA1822,CA1825,CA1834,CA1847,CA1859,CA1862,CA1864,CA1865,CA1866,CA2201,CA2249,CA5369,SA1201,SA1515,SA1604</WarningsNotAsErrors>
    <!-- Replaces the two per-configuration <DocumentationFile>bin\DotNetNuke.Web.DDRMenu.XML</DocumentationFile>
         entries; emits bin/DotNetNuke.Web.DDRMenu.xml, which Module.build's CopyBin copies. -->
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <!-- SolutionInfo.cs (linked below) carries the assembly attributes, as it did on net48. -->
    <GenerateAssemblyInfo>false</GenerateAssemblyInfo>
    <!-- This is a Blazor component library, not an MVC view assembly. -->
    <AddRazorSupportForMvc>false</AddRazorSupportForMvc>
  </PropertyGroup>

  <!-- The two original configurations are preserved. -->
  <PropertyGroup Condition=" '$(Configuration)' == 'Debug' ">
    <DebugSymbols>true</DebugSymbols>
    <DebugType>full</DebugType>
    <Optimize>false</Optimize>
    <DefineConstants>DEBUG;TRACE</DefineConstants>
  </PropertyGroup>
  <PropertyGroup Condition=" '$(Configuration)' == 'Release' ">
    <DebugType>pdbonly</DebugType>
    <Optimize>true</Optimize>
    <DefineConstants>TRACE</DefineConstants>
  </PropertyGroup>

  <!-- DNN packaging properties consumed by Module.build / Package.targets. -->
  <PropertyGroup>
    <Extension>zip</Extension>
    <DNNFileName>DDRMenu</DNNFileName>
    <PackageName>DDRMenu</PackageName>
    <BuildScriptsPath>$(MSBuildProjectDirectory)\..\..\..\Build\BuildScripts</BuildScriptsPath>
  </PropertyGroup>

  <ItemGroup>
    <!-- The components need Microsoft.AspNetCore.Components and Microsoft.AspNetCore.Http types. -->
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\..\DotNetNuke.Internal.SourceGenerators\DotNetNuke.Internal.SourceGenerators.csproj" ReferenceOutputAssembly="false" OutputItemType="Analyzer" />
    <ProjectReference Include="..\..\DotNetNuke.Abstractions\DotNetNuke.Abstractions.csproj" />
    <ProjectReference Include="..\..\DotNetNuke.DependencyInjection\DotNetNuke.DependencyInjection.csproj" />
    <ProjectReference Include="..\..\DotNetNuke.Web.Client\DotNetNuke.Web.Client.csproj" />
    <ProjectReference Include="..\..\DotNetNuke.Web.Razor\DotNetNuke.Web.Razor.csproj" />
    <ProjectReference Include="..\..\Library\DotNetNuke.Library.csproj" />
    <!-- Was a bare <Reference> with a HintPath into the sibling's bin folder; it is a project in
         this solution and is now an SDK-style Razor Class Library. -->
    <ProjectReference Include="..\..\Controls\DotNetNuke.WebControls\DotNetNuke.WebControls.csproj" />
  </ItemGroup>

  <ItemGroup>
    <AdditionalFiles Include="..\..\..\stylecop.json" Link="stylecop.json" />
    <Compile Include="..\..\..\SolutionInfo.cs" Link="SolutionInfo.cs" />
  </ItemGroup>

  <!-- Resources/MenuView.resx and Resources/MenuSettings.resx are the migrated
       App_LocalResources files. Module.build packages them into the extension's
       App_LocalResources folder as MenuView.resx / MenuSettings.resx, which is the name
       PortalModuleBase.LocalResourceFile now derives from the component type name, so the
       components' LocalizeText calls resolve the same keys as the WebForms LocalizeString
       calls did - including portal-level and language-pack overrides, which only the deployed
       files provide. The SDK's default EmbeddedResource glob also compiles them into the
       assembly (logical names DotNetNuke.Web.DDRMenu.Resources.MenuView /
       .Resources.MenuSettings, which is what IStringLocalizer<T> probes for given the
       ResourcesPath "Resources" that DotNetNuke.Library's Startup registers with
       AddLocalization), which makes the shipped English text self-contained. -->

  <ItemGroup>
    <!-- DNN extension package content (see Module.build's GetFiles). The four .ascx files are
         gone: the view, settings, skin-object and action controls are now Blazor components
         compiled into the assembly. -->
    <Content Include="02.00.03.txt" />
    <Content Include="DefaultTemplate.xslt" />
    <Content Include="License.txt" />
    <Content Include="ReleaseNotes.txt" />
    <Content Include="js\DDRMenu.js" />
    <Content Include="js\jquery.effects.js" />
    <Content Include="DNNMenu\DNNMenu-menudef.xml" />
    <Content Include="DNNMenu\DNNMenu.js" />
    <Content Include="DumpXML\DumpXML-menudef.xml" />
    <Content Include="DumpXML\DumpXML.xslt" />
    <Content Include="Module.build" />
    <None Include="DDRMenu.dnn" />
  </ItemGroup>

  <Import Project="Module.build" />
</Project>
