<Project Sdk="Microsoft.NET.Sdk.Razor">

  <PropertyGroup>
    <!-- Module.build's CopyBin copies from bin\ directly, so no TFM subfolder. -->
    <OutputPath>bin</OutputPath>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>DotNetNuke.Modules.Html</RootNamespace>
    <AssemblyName>DotNetNuke.Modules.Html</AssemblyName>
    <Deterministic>true</Deterministic>
    <LangVersion>latest</LangVersion>
    <Nullable>disable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <EnableNETAnalyzers>true</EnableNETAnalyzers>
    <AnalysisLevel>latest</AnalysisLevel>
    <AnalysisMode>Recommended</AnalysisMode>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <!-- Retargeting net48 -> net10.0 newly enables net10-era analyzer diagnostics that the
         net48 build never saw. SA1600 was already suppressed on net48 and is kept. Any CA id
         added here must be reported in PRE-EXISTING code this migration did not author, and
         must be justified in a comment, matching the convention set by the migrated
         DotNetNuke.Library, DotNetNuke.WebControls and DotNetNuke.Modules.DDRMenu.
         Compiler diagnostics (CS*) deliberately remain errors. -->
    <!-- SA1600: pre-existing undocumented members (net48 value, kept).
         The remaining ids are reported by the net10 analyzers in code this migration did not
         author - the module's 2003-era data layer (DataProvider/CBO fill helpers), the
         HtmlTextController workflow/notification logic and the ported controls:
         ASP0006/BL0005 (the DNN component tree builds its render tree with a running sequence
           and assigns ID on control instances, like the WebControls components),
         CA1001/CA1304/CA1305/CA1309/CA1310/CA1725/CA1822/CA1825/CA1834/CA1847/CA1859/CA1862/
         CA1864/CA1865/CA1866/CA1514/CA2201/CA2249/CA5369 and SA1201/SA1515/SA1604 - the same
         ids, for the same reason, as DotNetNuke.Library and DotNetNuke.Modules.DDRMenu list.
         CA1707 (identifiers should not contain underscores) is reported for the pre-existing
           public API member HtmlTextController.MAX_DESCRIPTION_LENGTH, which net48 already
           suppressed for StyleCop's SA1310 with Justification = "Breaking Change"; renaming a
           public const is a breaking change, so the id is not an error here either.
         Compiler diagnostics (CS*) deliberately remain errors. -->
    <WarningsNotAsErrors>SA1600,ASP0006,BL0005,CA1001,CA1304,CA1305,CA1309,CA1310,CA1514,CA1707,CA1725,CA1822,CA1825,CA1834,CA1847,CA1859,CA1862,CA1864,CA1865,CA1866,CA2201,CA2249,CA5369,SA1201,SA1515,SA1604</WarningsNotAsErrors>
    <!-- Replaces the two per-configuration <DocumentationFile>bin\DotNetNuke.Modules.Html.XML</DocumentationFile>
         entries; emits bin/DotNetNuke.Modules.Html.xml, which Module.build's CopyBin copies. -->
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <!-- SolutionInfo.cs (linked below) carries the assembly attributes, as it did on net48. -->
    <GenerateAssemblyInfo>false</GenerateAssemblyInfo>
    <!-- This is a Blazor component library, not an MVC view assembly. -->
    <AddRazorSupportForMvc>false</AddRazorSupportForMvc>
  </PropertyGroup>

  <!-- The two original configurations are preserved. -->
  <PropertyGroup Condition=" '$(Configuration)' == 'Debug' ">
    <DebugSymbols>true</DebugSymbols>
    <DebugType>full</DebugType>
    <Optimize>false</Optimize>
    <DefineConstants>DEBUG;TRACE</DefineConstants>
  </PropertyGroup>
  <PropertyGroup Condition=" '$(Configuration)' == 'Release' ">
    <DebugType>pdbonly</DebugType>
    <Optimize>true</Optimize>
    <DefineConstants>TRACE</DefineConstants>
  </PropertyGroup>

  <!-- DNN packaging properties consumed by Module.build / Package.targets. -->
  <PropertyGroup>
    <Extension>zip</Extension>
    <DNNFileName>dnn_HTML</DNNFileName>
    <PackageName>HTML_Community</PackageName>
    <BuildScriptsPath>$(MSBuildProjectDirectory)\..\..\..\Build\BuildScripts</BuildScriptsPath>
  </PropertyGroup>

  <ItemGroup>
    <!-- The components need Microsoft.AspNetCore.Components and Microsoft.AspNetCore.Http types. -->
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\..\DotNetNuke.Internal.SourceGenerators\DotNetNuke.Internal.SourceGenerators.csproj" ReferenceOutputAssembly="false" OutputItemType="Analyzer" />
    <ProjectReference Include="..\..\DotNetNuke.Abstractions\DotNetNuke.Abstractions.csproj" />
    <ProjectReference Include="..\..\DotNetNuke.DependencyInjection\DotNetNuke.DependencyInjection.csproj" />
    <ProjectReference Include="..\..\DotNetNuke.Web.Client\DotNetNuke.Web.Client.csproj" />
    <ProjectReference Include="..\..\DotNetNuke.Web\DotNetNuke.Web.csproj" />
    <ProjectReference Include="..\..\Library\DotNetNuke.Library.csproj" />
    <!-- Was a bare <Reference> with a HintPath into the sibling's bin folder; it is a project in
         this solution and is now an SDK-style Razor Class Library. -->
    <ProjectReference Include="..\..\Controls\DotNetNuke.WebControls\DotNetNuke.WebControls.csproj" />
  </ItemGroup>

  <ItemGroup>
    <AdditionalFiles Include="..\..\..\stylecop.json" Link="stylecop.json" />
    <Compile Include="..\..\..\SolutionInfo.cs" Link="SolutionInfo.cs" />
  </ItemGroup>

  <!-- Resources/*.resx are the migrated App_LocalResources files (HtmlModule, EditHtml, MyWork,
       Settings, SharedResources, Workflow). Module.build packages them into the extension's
       App_LocalResources folder under the same names, which is what
       PortalModuleBase.LocalResourceFile now derives from the component type name and what
       Localization.LocalSharedResourceFile expects for SharedResources.resx - so portal-level
       and language-pack overrides keep working. The SDK's default EmbeddedResource glob also
       compiles them into the assembly (logical names DotNetNuke.Modules.Html.Resources.*, which
       is what IStringLocalizer<T> probes given the ResourcesPath "Resources" that
       DotNetNuke.Library's Startup registers with AddLocalization). -->

  <ItemGroup>
    <!-- DNN extension package content (see Module.build's GetFiles). The four .ascx files are
         gone: the view, edit, my-work and settings controls are now Blazor components compiled
         into the assembly. -->
    <Content Include="04.05.00.txt" />
    <Content Include="04.06.00.txt" />
    <Content Include="04.06.01.txt" />
    <Content Include="04.07.00.txt" />
    <Content Include="04.08.01.txt" />
    <Content Include="05.01.00.txt" />
    <Content Include="05.01.02.txt" />
    <Content Include="05.01.03.txt" />
    <Content Include="05.01.04.txt" />
    <Content Include="05.02.00.txt" />
    <Content Include="05.04.03.txt" />
    <Content Include="07.03.00.txt" />
    <Content Include="10.00.00.txt" />
    <Content Include="license.txt" />
    <Content Include="releaseNotes.txt" />
    <Content Include="edit.css" />
    <!-- The inline <script> block of EditHtml.ascx became this file (Blazor does not execute
         scripts a component renders); EditHtml.razor loads it from DesktopModules/HTML/edit.js,
         so it has to ship as loose content exactly like edit.css. The HtmlModule interop module
         lives in wwwroot/js and is served by the Razor SDK as a static web asset
         (_content/DotNetNuke.Modules.Html/js/dnn.modules.html.js), so it needs no Content item. -->
    <Content Include="edit.js" />
    <Content Include="Images\html.png" />
    <Content Include="Module.build" />
    <None Include="dnn_HTML.dnn" />
    <None Include="Providers\DataProviders\SqlDataProvider\03.00.00.SqlDataProvider" />
    <None Include="Providers\DataProviders\SqlDataProvider\03.01.00.SqlDataProvider" />
    <None Include="Providers\DataProviders\SqlDataProvider\04.05.00.SqlDataProvider" />
    <None Include="Providers\DataProviders\SqlDataProvider\04.06.00.SqlDataProvider" />
    <None Include="Providers\DataProviders\SqlDataProvider\04.06.01.SqlDataProvider" />
    <None Include="Providers\DataProviders\SqlDataProvider\04.07.00.SqlDataProvider" />
    <None Include="Providers\DataProviders\SqlDataProvider\04.08.01.SqlDataProvider" />
    <None Include="Providers\DataProviders\SqlDataProvider\05.01.00.SqlDataProvider" />
    <None Include="Providers\DataProviders\SqlDataProvider\05.01.02.SqlDataProvider" />
    <None Include="Providers\DataProviders\SqlDataProvider\05.01.03.SqlDataProvider" />
    <None Include="Providers\DataProviders\SqlDataProvider\05.01.04.SqlDataProvider" />
    <None Include="Providers\DataProviders\SqlDataProvider\05.02.00.SqlDataProvider" />
    <None Include="Providers\DataProviders\SqlDataProvider\05.02.01.SqlDataProvider" />
    <None Include="Providers\DataProviders\SqlDataProvider\05.05.00.SqlDataProvider" />
    <None Include="Providers\DataProviders\SqlDataProvider\06.01.00.SqlDataProvider" />
    <None Include="Providers\DataProviders\SqlDataProvider\07.02.01.SqlDataProvider" />
    <None Include="Providers\DataProviders\SqlDataProvider\10.00.00.SqlDataProvider" />
    <None Include="Providers\DataProviders\SqlDataProvider\10.00.02.SqlDataProvider" />
    <None Include="Providers\DataProviders\SqlDataProvider\Uninstall.SqlDataProvider" />
  </ItemGroup>

  <Import Project="Module.build" />
</Project>
