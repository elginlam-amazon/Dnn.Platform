@inherits DotNetNuke.Web.Mvc.Framework.DnnWebViewPage<Dnn.ContactList.Api.Contact>

@using DotNetNuke.Services.Localization
@using DotNetNuke.Web.Mvc.Helpers

@{
    // ASP.NET Core Razor injects `IHtmlHelper<dynamic> Html` and `IUrlHelper Url` into every
    // generated view class; those hide the DNN helpers declared on DnnWebViewPage<TModel>
    // (DnnHtmlHelper<TModel> / DnnUrlHelper). Alias the base members so this view keeps using the
    // module-aware DNN helpers it used through WebViewPage on MVC 5.
    var dnnHtml = base.Html;
    var dnnUrl = base.Url;
}
<div class="contactEdit-container">
    <div class="contactEdit-header">
        <div class="contactEdit-logo">
            <svg viewBox="0 0 100 60" xmlns="http://www.w3.org/2000/svg">
                <polyline points="5,55 20,15 35,55" fill="none" stroke="white" stroke-width="6" stroke-linecap="round" stroke-linejoin="round"/>
                <polyline points="30,55 50,5 70,55" fill="none" stroke="white" stroke-width="6" stroke-linecap="round" stroke-linejoin="round"/>
                <polyline points="65,55 80,15 95,55" fill="none" stroke="white" stroke-width="5" stroke-linecap="round" stroke-linejoin="round"/>
            </svg>
        </div>
        <div class="contactEdit-title">
            <h2>@(Model.ContactId > 0 ? Dnn.LocalizeString("Edit") : Dnn.LocalizeString("AddContact"))</h2>
            <p>@Dnn.LocalizeString("EditDescription")</p>
        </div>
    </div>

    <div class="contactEdit-form">
        <div class="form-row">
            <div class="form-group">
                <label for="FirstName">
                    <i class="fa fa-user"></i>
                    @Dnn.LocalizeString("FirstName") <span class="required">*</span>
                </label>
                @dnnHtml.TextBoxFor(m => m.FirstName, new { @class = "form-input", placeholder = "Enter first name" })
                @dnnHtml.ValidationMessageFor(m => m.FirstName, Dnn.LocalizeString("FirstNameRequired"))
            </div>

            <div class="form-group">
                <label for="LastName">
                    <i class="fa fa-user"></i>
                    @Dnn.LocalizeString("LastName") <span class="required">*</span>
                </label>
                @dnnHtml.TextBoxFor(m => m.LastName, new { @class = "form-input", placeholder = "Enter last name" })
                @dnnHtml.ValidationMessageFor(m => m.LastName, Dnn.LocalizeString("LastNameRequired"))
            </div>
        </div>

        <div class="form-group">
            <label for="Email">
                <i class="fa fa-envelope"></i>
                @Dnn.LocalizeString("Email") <span class="required">*</span>
            </label>
            @dnnHtml.TextBoxFor(m => m.Email, new { @class = "form-input", placeholder = "email@example.com", type = "email" })
            @dnnHtml.ValidationMessageFor(m => m.Email, Dnn.LocalizeString("EmailRequired"))
        </div>

        <div class="form-group">
            <label for="Phone">
                <i class="fa fa-phone"></i>
                @Dnn.LocalizeString("Phone") <span class="required">*</span>
            </label>
            @dnnHtml.TextBoxFor(m => m.Phone, new { @class = "form-input", placeholder = "+1 555-123-4567", type = "tel" })
            @dnnHtml.ValidationMessageFor(m => m.Phone, Dnn.LocalizeString("PhoneRequired"))
        </div>

        <div class="form-group">
            <label for="Social">
                <i class="fa fa-twitter"></i>
                @Dnn.LocalizeString("Social")
            </label>
            @dnnHtml.TextBoxFor(m => m.Social, new { @class = "form-input", placeholder = "@username or profile URL" })
            @dnnHtml.ValidationMessageFor(m => m.Social, Dnn.LocalizeString("SocialRequired"))
        </div>

        <div class="form-actions">
            <button type="submit" id="btnSave" class="btn-primary">
                <i class="fa fa-save"></i>
                @Dnn.LocalizeString("Save")
            </button>
            <a href="@dnnUrl.Action("Index", "Contact")" class="btn-secondary">
                <i class="fa fa-times"></i>
                Cancel
            </a>
        </div>
    </div>
</div>
