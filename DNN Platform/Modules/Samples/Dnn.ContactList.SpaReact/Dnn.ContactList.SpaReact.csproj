<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <AssemblyName>Dnn.ContactList.SpaReact</AssemblyName>
    <TargetFramework>net10.0</TargetFramework>
    <OutputPath>bin</OutputPath>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    <AppendRuntimeIdentifierToOutputPath>false</AppendRuntimeIdentifierToOutputPath>
    <PackageId>Dnn.ContactList.SpaReact</PackageId>
    <Description>Dnn ContactList Spa React Module</Description>
    <NeutralLanguage>en-US</NeutralLanguage>
    <ApplicationIcon />
    <OutputType>Library</OutputType>
    <StartupObject />
    <DebugType>Portable</DebugType>
    <ProduceReferenceAssembly>False</ProduceReferenceAssembly>
    <GenerateAssemblyInfo>false</GenerateAssemblyInfo>
    <GenerateDocumentationFile>True</GenerateDocumentationFile>
    <BaseOutputPath>.\bin</BaseOutputPath>
    <!-- The React client assets (ts/html/css under src) are built by Vite/npm and deployed as content
         under DesktopModules and served by the Website at runtime; they must not be compiled into this
         assembly, so this module uses the plain Microsoft.NET.Sdk (not Sdk.Web) and keeps them as content. -->
    <EnableDefaultContentItems>false</EnableDefaultContentItems>
  </PropertyGroup>
  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
    <PackageReference Include="Microsoft.AspNet.WebApi.Client" />
    <PackageReference Include="Newtonsoft.Json" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\..\..\DotNetNuke.Web\DotNetNuke.Web.csproj" />
    <ProjectReference Include="..\Dnn.ContactList.Api\Dnn.ContactList.Api.csproj" />
  </ItemGroup>
  <ItemGroup>
    <Compile Include="..\..\..\..\SolutionInfo.cs">
      <Link>SolutionInfo.cs</Link>
    </Compile>
  </ItemGroup>
  <Import Project="Module.build" />
</Project>
