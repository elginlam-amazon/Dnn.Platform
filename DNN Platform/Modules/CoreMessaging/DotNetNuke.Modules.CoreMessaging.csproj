<Project Sdk="Microsoft.NET.Sdk.Razor">

  <PropertyGroup>
    <!-- Module.build's CopyBin copies from bin\ directly, so no TFM subfolder. -->
    <OutputPath>bin</OutputPath>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    <TargetFramework>net10.0</TargetFramework>
    <OutputType>Library</OutputType>
    <RootNamespace>DotNetNuke.Modules.CoreMessaging</RootNamespace>
    <AssemblyName>DotNetNuke.Modules.CoreMessaging</AssemblyName>
    <Deterministic>true</Deterministic>
    <LangVersion>latest</LangVersion>
    <Nullable>disable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <EnableNETAnalyzers>true</EnableNETAnalyzers>
    <AnalysisLevel>latest</AnalysisLevel>
    <AnalysisMode>Recommended</AnalysisMode>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <!-- Retargeting net48 -> net10.0 newly enables net10-era analyzer diagnostics that the
         net48 build never saw. SA1600 was already suppressed on net48 and is kept. Any id
         added here is reported in PRE-EXISTING code this migration did not author, and is
         justified below, matching the convention set by the already migrated
         DotNetNuke.Modules.DDRMenu and DotNetNuke.Library.
         Compiler diagnostics (CS*) deliberately remain errors. -->
    <!-- SA1600: pre-existing undocumented members (net48 value, kept).
         The remaining ids are the set listed for the same reason by the already migrated
         DotNetNuke.Modules.DDRMenu (the net10.0 DNN module precedent this project mirrors)
         and DotNetNuke.Library: they are reported by the net10 analyzers in code this
         migration did not author - here the module's Web API service controllers, view
         models, the 06.02.00 upgrade business controller and the WebForms-era control logic.
         Keeping them as errors would require rewriting that pre-existing logic, which is
         exactly what must not change in this migration.
         CA1707 specifically covers FilesStatus.thumbnail_url: that underscored name is the
         frozen client-side JSON contract consumed by the jQuery file-upload client, so the
         member cannot be renamed and suppression is the only correct resolution. -->
    <WarningsNotAsErrors>SA1600,ASP0006,BL0005,CA1001,CA1304,CA1305,CA1309,CA1310,CA1514,CA1707,CA1725,CA1822,CA1825,CA1829,CA1834,CA1847,CA1859,CA1861,CA1862,CA1864,CA1865,CA1866,CA2201,CA2249,CA5369,SA1201,SA1515,SA1604</WarningsNotAsErrors>
    <!-- Replaces the <DocumentationFile>bin\DotNetNuke.Modules.CoreMessaging.XML</DocumentationFile>
         entry; emits bin/DotNetNuke.Modules.CoreMessaging.xml, which Module.build's CopyBin copies. -->
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <!-- SolutionInfo.cs (linked below) carries the assembly attributes, as it did on net48. -->
    <GenerateAssemblyInfo>false</GenerateAssemblyInfo>
    <!-- This is a Blazor component library, not an MVC view assembly. -->
    <AddRazorSupportForMvc>false</AddRazorSupportForMvc>
  </PropertyGroup>

  <!-- The two original configurations are preserved verbatim; the #if DEBUG block in the
       Subscriptions control depends on DEBUG still being defined. -->
  <PropertyGroup Condition=" '$(Configuration)' == 'Debug' ">
    <DebugSymbols>true</DebugSymbols>
    <DebugType>full</DebugType>
    <Optimize>false</Optimize>
    <DefineConstants>DEBUG;TRACE</DefineConstants>
  </PropertyGroup>
  <PropertyGroup Condition=" '$(Configuration)' == 'Release' ">
    <DebugType>pdbonly</DebugType>
    <Optimize>true</Optimize>
    <DefineConstants>TRACE</DefineConstants>
  </PropertyGroup>

  <!-- DNN packaging properties consumed by Module.build / Package.targets. -->
  <PropertyGroup>
    <Extension>zip</Extension>
    <DNNFileName>CoreMessaging</DNNFileName>
    <PackageName>DNNCE_CoreMessaging</PackageName>
    <BuildScriptsPath>$(MSBuildProjectDirectory)\..\..\..\Build\BuildScripts</BuildScriptsPath>
  </PropertyGroup>

  <ItemGroup>
    <!-- Replaces the removed System.Web* bare references: the components need
         Microsoft.AspNetCore.Components and the controllers need Microsoft.AspNetCore.Mvc
         and Microsoft.AspNetCore.Http types. -->
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>

  <ItemGroup>
    <!-- Needed for the [LoggerMessage] partials in LoggerMessages.cs. -->
    <ProjectReference Include="..\..\..\DotNetNuke.Internal.SourceGenerators\DotNetNuke.Internal.SourceGenerators.csproj" ReferenceOutputAssembly="false" OutputItemType="Analyzer" />
    <ProjectReference Include="..\..\DotNetNuke.Abstractions\DotNetNuke.Abstractions.csproj" />
    <ProjectReference Include="..\..\DotNetNuke.DependencyInjection\DotNetNuke.DependencyInjection.csproj" />
    <!-- Kept from the net48 reference set: DotNetNuke.Instrumentation is used by
         FileUploadController, MessagingServiceController and CoreMessagingBusinessController. -->
    <ProjectReference Include="..\..\DotNetNuke.Instrumentation\DotNetNuke.Instrumentation.csproj" />
    <ProjectReference Include="..\..\DotNetNuke.Web.Client\DotNetNuke.Web.Client.csproj" />
    <ProjectReference Include="..\..\DotNetNuke.Web\DotNetNuke.Web.csproj" />
    <ProjectReference Include="..\..\Library\DotNetNuke.Library.csproj" />
  </ItemGroup>

  <ItemGroup>
    <AdditionalFiles Include="..\..\..\stylecop.json" Link="stylecop.json" />
    <Compile Include="..\..\..\SolutionInfo.cs" Link="SolutionInfo.cs" />
  </ItemGroup>

  <!-- App_LocalResources/View.resx and App_LocalResources/SharedResources.resx are the
       migrated localization files (byte-identical renames of App_LocalResources\View.ascx.resx
       and App_LocalResources\SharedResources.resx). They deliberately STAY in a folder named
       App_LocalResources: the shared Build\BuildScripts\Module.build GetFiles target globs
       App_LocalResources/*.resx into @(Resources), and Package.targets zips with the project
       directory as the working directory, so the relative path is preserved and the files
       install to DesktopModules\CoreMessaging\App_LocalResources - which is exactly where
       PortalModuleBase.LocalResourceFile, the Subscriptions SharedResources const and
       SubscriptionsController.LocalizationFolder all look for them. Only the FILE name
       changed: View.resx is the name PortalModuleBase.LocalResourceFile now derives from the
       component type name View, so the component's LocalizeText calls resolve the same keys
       the WebForms LocalizeString calls did - including the portal-level and language-pack
       overrides that only the deployed files provide. -->

  <ItemGroup>
    <!-- DNN extension package content (see Module.build's GetFiles). These client assets stay
         in place as extension content under DesktopModules\CoreMessaging - this is a packaged
         extension library, not a web host, so nothing moves to wwwroot. View.ascx and
         Subscriptions.ascx are no longer packaged: they are Blazor components compiled into
         the assembly, exactly as DDRMenu stopped packaging its four .ascx files. -->
    <Content Include="ie-messages.css" />
    <Content Include="Images\ajax-loader.gif" />
    <Content Include="Images\downArrow-hover.png" />
    <Content Include="Images\downArrow.png" />
    <Content Include="Images\grid-sprite.png" />
    <Content Include="Images\icons.png" />
    <Content Include="Images\ie-backgrounds.png" />
    <Content Include="Images\list-Icon.png" />
    <Content Include="Images\page-Icon.png" />
    <Content Include="Images\paperClip.png" />
    <Content Include="Images\progress.gif" />
    <Content Include="Images\reply.png" />
    <Content Include="Images\right.png" />
    <Content Include="Scripts\CoreMessaging.js" />
    <Content Include="Scripts\LocalizationController.js" />
    <Content Include="Scripts\SubscriptionsViewModel.js" />
    <Content Include="Scripts\Subscription.js" />
    <Content Include="subscriptions.css" />
    <Content Include="license.txt" />
    <Content Include="module.css" />
    <Content Include="releaseNotes.txt" />
    <Content Include="Module.build" />
    <None Include="CoreMessaging.dnn" />
  </ItemGroup>

  <Import Project="Module.build" />
</Project>
