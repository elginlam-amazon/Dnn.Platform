<Project Sdk="Microsoft.NET.Sdk.Razor">

  <PropertyGroup>
    <!-- Module.build's CopyBin copies from bin\ directly, so no TFM subfolder. -->
    <OutputPath>bin</OutputPath>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    <TargetFramework>net10.0</TargetFramework>
    <OutputType>Library</OutputType>
    <RootNamespace>Dnn.Modules.TelerikRemoval</RootNamespace>
    <AssemblyName>Dnn.Modules.TelerikRemoval</AssemblyName>
    <Deterministic>true</Deterministic>
    <LangVersion>latest</LangVersion>
    <Nullable>disable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <EnableNETAnalyzers>true</EnableNETAnalyzers>
    <AnalysisLevel>latest</AnalysisLevel>
    <AnalysisMode>Recommended</AnalysisMode>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <!-- Retargeting net48 -> net10.0 newly enables net10-era analyzer diagnostics the net48 build
         never saw. Every id below is reported in logic this migration carried over verbatim from
         View.ascx.cs / UpgradeController.cs / the two control wrappers rather than authored, and
         keeping it an error would mean rewriting that logic - which is exactly what must not
         change in a module whose job is removing Telerik. This follows the convention set by the
         already migrated DotNetNuke.Modules.CoreMessaging and Dnn.Modules.Console. Compiler
         diagnostics (CS*) deliberately remain errors.
           SA1600 - pre-existing undocumented members.
           ASP0006 - the assembly table render fragment builds its tree imperatively, so literal
                     sequence numbers cannot express its structure (same reason as DnnLabel).
           BL0005 - the component sets its own RemoveTelerikButton.Enabled / label parameters from
                    the ported InitMainMultiView and the click handler, as the code behind did.
           CA1822 - ConvertBooleanToIcon keeps the protected INSTANCE signature the code behind
                    exposed (the repeater's ItemTemplate called this.ConvertBooleanToIcon);
                    making it static would change that inherited surface.
           CA1016 - Properties/AssemblyInfo.cs declares no AssemblyVersion, exactly as it did on
                    net48 (this project never linked SolutionInfo.cs). Adding one would change the
                    assembly identity this extension has always shipped with, which is the one
                    thing a Telerik-removal module must not change. -->
    <WarningsNotAsErrors>SA1600,ASP0006,BL0005,CA1822,CA1016</WarningsNotAsErrors>
    <!-- Replaces the two per-configuration
         <DocumentationFile>bin\Dnn.Modules.TelerikRemoval.xml</DocumentationFile> entries; emits
         bin/Dnn.Modules.TelerikRemoval.xml, which Module.build's CopyBin copies. -->
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <!-- Properties/AssemblyInfo.cs carries the assembly attributes, as it did on net48. This
         project never linked SolutionInfo.cs, so none is linked here: doing so would change the
         assembly identity (version/company/copyright) this extension ships with. -->
    <GenerateAssemblyInfo>false</GenerateAssemblyInfo>
    <!-- This is a Blazor component library, not an MVC view assembly. -->
    <AddRazorSupportForMvc>false</AddRazorSupportForMvc>
  </PropertyGroup>

  <!-- The two original configurations are preserved. -->
  <PropertyGroup Condition=" '$(Configuration)' == 'Debug' ">
    <DebugSymbols>true</DebugSymbols>
    <DebugType>full</DebugType>
    <Optimize>false</Optimize>
    <DefineConstants>DEBUG;TRACE</DefineConstants>
  </PropertyGroup>
  <PropertyGroup Condition=" '$(Configuration)' == 'Release' ">
    <DebugSymbols>true</DebugSymbols>
    <DebugType>pdbonly</DebugType>
    <Optimize>true</Optimize>
    <DefineConstants>TRACE</DefineConstants>
  </PropertyGroup>

  <!-- DNN packaging properties consumed by Module.build / Package.targets. -->
  <PropertyGroup>
    <Extension>zip</Extension>
    <DNNFileName>TelerikRemoval</DNNFileName>
    <PackageName>DNNCE_TelerikRemoval</PackageName>
    <BuildScriptsPath>$(MSBuildProjectDirectory)\..\..\..\Build\BuildScripts</BuildScriptsPath>
  </PropertyGroup>

  <ItemGroup>
    <!-- Replaces the 16 bare GAC references (System.Web, System.Web.Services,
         System.Web.Extensions, System.Web.DynamicData, System.Web.Entity,
         System.Web.ApplicationServices, System.Drawing, System.EnterpriseServices,
         System.Configuration, ...): the converted view needs Microsoft.AspNetCore.Components and
         Microsoft.JSInterop types. -->
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\DotNetNuke.Abstractions\DotNetNuke.Abstractions.csproj" />
    <ProjectReference Include="..\..\DotNetNuke.DependencyInjection\DotNetNuke.DependencyInjection.csproj" />
    <ProjectReference Include="..\..\DotNetNuke.Instrumentation\DotNetNuke.Instrumentation.csproj" />
    <!-- ITelerikUninstaller / ITelerikUtils and the removal step list live here. This project only
         consumes them; DotNetNuke.Maintenance itself is untouched by this migration. -->
    <ProjectReference Include="..\..\DotNetNuke.Maintenance\DotNetNuke.Maintenance.csproj" />
    <ProjectReference Include="..\..\DotNetNuke.Web\DotNetNuke.Web.csproj" />
    <ProjectReference Include="..\..\Library\DotNetNuke.Library.csproj" />
  </ItemGroup>

  <ItemGroup>
    <AdditionalFiles Include="..\..\..\stylecop.json" Link="stylecop.json" />
  </ItemGroup>

  <!-- App_LocalResources/View.resx is the migrated localization file (a byte-identical rename of
       App_LocalResources\View.ascx.resx). It deliberately STAYS in a folder named
       App_LocalResources: the shared Build\BuildScripts\Module.build GetFiles target globs
       App_LocalResources/*.resx into @(Resources) and Package.targets zips with the project
       directory as the working directory, so the relative path is preserved and the file installs
       to DesktopModules\TelerikRemoval\App_LocalResources - which is exactly where
       PortalModuleBase.LocalResourceFile looks for it. Only the FILE name changed: View.resx is
       the name LocalResourceFile now derives from the component type name View, so the
       component's LocalizeText calls resolve the same keys the WebForms controls did, including
       the portal-level and language-pack overrides that only the deployed file provides. -->

  <ItemGroup>
    <!-- DNN extension package content (see BuildScripts\Module.build's GetFiles). These assets
         stay in place as extension content under DesktopModules\TelerikRemoval - this is a
         packaged extension library, not a web host, so nothing moves to wwwroot. View.ascx is no
         longer packaged: it is a Blazor component compiled into the assembly. -->
    <Content Include="License.txt" />
    <Content Include="ReleaseNotes.txt" />
    <Content Include="module.css" />
    <Content Include="Module.build" />
    <!-- The JS interop module that replaces RegisterClientScripts()'s inline submit statement; it
         must ship inside the installed module folder so the component's import URL resolves. -->
    <Content Include="Scripts\telerikRemovalInterop.js" />
    <None Include="TelerikRemoval.dnn" />
  </ItemGroup>

  <Import Project="Module.build" />
</Project>
