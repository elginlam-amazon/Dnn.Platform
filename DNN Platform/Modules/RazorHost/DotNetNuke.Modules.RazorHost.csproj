<Project Sdk="Microsoft.NET.Sdk.Razor">

  <PropertyGroup>
    <!-- Module.build's CopyBin copies from bin\ directly, so no TFM subfolder. The lower-case
         "bin" matters on case-sensitive (Linux) file systems. -->
    <OutputPath>bin</OutputPath>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    <TargetFramework>net10.0</TargetFramework>
    <OutputType>Library</OutputType>
    <!-- The net48 <RootNamespace> was empty, but every type in this project is declared in the
         DotNetNuke.Modules.RazorHost namespace; declaring it keeps the generated Razor
         components in the same namespace as the code-behind partial classes. -->
    <RootNamespace>DotNetNuke.Modules.RazorHost</RootNamespace>
    <AssemblyName>DotNetNuke.Modules.RazorHost</AssemblyName>
    <Deterministic>true</Deterministic>
    <LangVersion>latest</LangVersion>
    <Nullable>disable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <EnableNETAnalyzers>true</EnableNETAnalyzers>
    <AnalysisLevel>latest</AnalysisLevel>
    <AnalysisMode>Recommended</AnalysisMode>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <!-- Retargeting net48 -> net10.0 newly enables net10-era analyzer diagnostics that the
         net48 build never saw. SA1600 was already suppressed on net48 and is kept. Any id
         added here must be reported in PRE-EXISTING code this migration did not author, and
         must be justified in a comment, matching the convention set by the migrated
         DotNetNuke.Library, DotNetNuke.WebControls and DotNetNuke.Modules.Html.
         Compiler diagnostics (CS*) deliberately remain errors, with the single documented
         exception of CS0618 below. -->
    <!-- SA1600: pre-existing undocumented members (net48 value, kept).
         CS0618: every public type in this project is marked [DnnDeprecated] (the razor-host
           module is obsolete in favour of the generic Razor host), so the types reference each
           other and their own obsolete base members; this is by design and cannot be avoided
           without un-deprecating the shipped API.
         The remaining ids are reported by the net10 analyzers in pre-existing code this
         migration did not author - the module's file/IO helpers, the CreateModule installer
         flow and the ported controls:
         ASP0006/BL0005 (the DNN component tree builds its render tree with a running sequence
           and assigns ID on control instances, like the WebControls components),
         CA1031/CA1304/CA1305/CA1307/CA1309/CA1310/CA1707/CA1725/CA1822/CA1825/CA1834/CA1847/
         CA1859/CA1862/CA1864/CA1865/CA1866/CA1514/CA2201/CA2249/CA5369 and
         SA1201/SA1515/SA1604 - the same ids, for the same reason, as DotNetNuke.Library and
         DotNetNuke.Modules.Html list. -->
    <WarningsNotAsErrors>SA1600,CS0618,ASP0006,BL0005,CA1031,CA1304,CA1305,CA1307,CA1309,CA1310,CA1514,CA1707,CA1725,CA1822,CA1825,CA1834,CA1847,CA1859,CA1862,CA1864,CA1865,CA1866,CA2201,CA2249,CA5369,SA1201,SA1515,SA1604</WarningsNotAsErrors>
    <!-- Replaces the two per-configuration
         <DocumentationFile>bin\DotNetNuke.Modules.RazorHost.XML</DocumentationFile> entries;
         emits bin/DotNetNuke.Modules.RazorHost.xml, which Module.build's CopyBin copies. -->
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <!-- SolutionInfo.cs (linked below) carries Company/Product/Copyright/Trademark/Version, as it
         did on net48. It does NOT carry AssemblyTitle, AssemblyDescription or the typelib Guid, and
         GenerateAssemblyInfo=false means nothing regenerates them, so a trimmed project-local
         AssemblyInfo.cs is retained for exactly those three attributes. -->
    <GenerateAssemblyInfo>false</GenerateAssemblyInfo>
    <!-- This is a Blazor component library, not an MVC view assembly. It also keeps the loose
         Scripts\**\*.cshtml sample scripts out of build-time Razor compilation: they are
         runtime-compiled by DotNetNuke.Web.Razor on the live site, by design. -->
    <AddRazorSupportForMvc>false</AddRazorSupportForMvc>
    <!-- The Razor SDK's ResolveRazorGenerateInputs adds every <Content> item with a .cshtml
         extension to @(RazorGenerate), which would make the build try to compile the 20 loose
         sample scripts under Scripts\ as MVC views (RAZORSDK1004, then compile errors naming
         e.g. Scripts\_2_AddNumbers.cshtml). Those scripts are deliberately NOT build-time
         artefacts: they are shipped as loose content and compiled at runtime on first use by
         DotNetNuke.Web.Razor, which retains Razor runtime compilation for exactly this purpose
         (a live site's third-party razor scripts work the same way). This project has no
         .cshtml of its own to code-generate - its five controls are .razor components, which
         come in through @(RazorComponent), not @(RazorGenerate) - so turning the default
         RazorGenerate glob off removes the scripts from code generation without any Remove/
         re-Include dance and without hiding a single source file. -->
    <EnableDefaultRazorGenerateItems>false</EnableDefaultRazorGenerateItems>
  </PropertyGroup>

  <!-- The two original configurations are preserved. -->
  <PropertyGroup Condition=" '$(Configuration)' == 'Debug' ">
    <DebugSymbols>true</DebugSymbols>
    <DebugType>full</DebugType>
    <Optimize>false</Optimize>
    <DefineConstants>DEBUG;TRACE</DefineConstants>
  </PropertyGroup>
  <PropertyGroup Condition=" '$(Configuration)' == 'Release' ">
    <DebugType>pdbonly</DebugType>
    <Optimize>true</Optimize>
    <DefineConstants>TRACE</DefineConstants>
  </PropertyGroup>

  <!-- DNN packaging properties consumed by Module.build / Package.targets. On net48 these were
       only declared in Module.build; Package.targets needs them from the project too. -->
  <PropertyGroup>
    <Extension>zip</Extension>
    <DNNFileName>RazorHost</DNNFileName>
    <PackageName>DNNCE_RazorHost</PackageName>
    <BuildScriptsPath>$(MSBuildProjectDirectory)\..\..\..\Build\BuildScripts</BuildScriptsPath>
  </PropertyGroup>

  <ItemGroup>
    <!-- Replaces the bare System.Web, System.Web.ApplicationServices, System.Web.DynamicData,
         System.Web.Entity, System.Web.Extensions and System.Web.Services references. The
         components need Microsoft.AspNetCore.Components and Microsoft.AspNetCore.Http types.
         System, System.Data, System.Data.DataSetExtensions, System.Xml and System.Xml.Linq are
         implicit in the SDK. -->
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\..\DotNetNuke.Internal.SourceGenerators\DotNetNuke.Internal.SourceGenerators.csproj" ReferenceOutputAssembly="false" OutputItemType="Analyzer" />
    <ProjectReference Include="..\..\DotNetNuke.Abstractions\DotNetNuke.Abstractions.csproj" />
    <ProjectReference Include="..\..\DotNetNuke.Instrumentation\DotNetNuke.Instrumentation.csproj" />
    <ProjectReference Include="..\..\DotNetNuke.Web.Razor\DotNetNuke.Web.Razor.csproj" />
    <ProjectReference Include="..\..\DotNetNuke.Web\DotNetNuke.Web.csproj" />
    <ProjectReference Include="..\..\Library\DotNetNuke.Library.csproj" />
  </ItemGroup>

  <ItemGroup>
    <AdditionalFiles Include="..\..\..\stylecop.json" Link="stylecop.json" />
    <Compile Include="..\..\..\SolutionInfo.cs" Link="SolutionInfo.cs" />
  </ItemGroup>

  <!-- Resources/*.resx are the migrated App_LocalResources files (AddScript, CreateModule,
       EditScript, RazorHost, Settings). Module.build packages them into the extension's
       App_LocalResources folder under those names, which is what
       ModuleUserControlBase.LocalResourceFile now derives from the component type name - so
       portal-level and language-pack overrides keep working. The SDK's default EmbeddedResource
       glob also compiles them into the assembly (logical names
       DotNetNuke.Modules.RazorHost.Resources.*). The net48 per-file <Content Include=
       "App_LocalResources\*.ascx.resx"> items, and the lone stray <EmbeddedResource> for
       AddScript, are therefore gone. -->

  <ItemGroup>
    <!-- DNN extension package content (see Module.build's GetFiles). The five .ascx files are
         gone: the view, edit, add, create-module and settings controls are now Blazor
         components compiled into the assembly. -->
    <Content Include="license.txt" />
    <Content Include="module.css" />
    <Content Include="releaseNotes.txt" />
    <Content Include="Module.build" />
    <!-- RazorHost.dnn (the extension manifest) and Manifest.dnn (the reference copy of the
         manifest template CreateModule writes) are already <None> items through the SDK's
         default glob; re-declaring them would duplicate the item. -->
    <!-- The 20 sample razor scripts are LOOSE CONTENT. They are shipped on disk into
         DesktopModules/RazorModules/RazorHost/Scripts and compiled at runtime on first use by
         DotNetNuke.Web.Razor, which deliberately retains Razor runtime compilation for exactly
         this purpose. EnableDefaultRazorGenerateItems=false keeps them out of RazorGenerate;
         they are
         picked up automatically by the Razor SDK's default <Content> glob (verified with
         -getItem:Content: all 20 are present exactly once), so they are NOT re-declared here -
         an explicit <Content Include> would duplicate the glob item. Module.build's GetFiles
         puts them in the package. -->
  </ItemGroup>

  <Import Project="Module.build" />
</Project>
